{
  "pages": [
    "pages/index/index",
    "pages/chat/chat",
    "pages/chat/report/report",
    "pages/detail/detail",
    "pages/profile/profile",
    "pages/user/user"
  ],
  "subPackages": [
    {
      "root": "pages/result",
      "pages": ["result"]
    }
  ],
  "window": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "VetAI",
    "navigationBarBackgroundColor": "#F7F3EA",
    "backgroundColor": "#F7F3EA",
    "enablePullDownRefresh": false,
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "custom": true,
    "color": "#8C8475",
    "selectedColor": "#BF5E3B",
    "backgroundColor": "#F7F3EA",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "检查"
      },
      {
        "pagePath": "pages/detail/detail",
        "text": "档案"
      },
      {
        "pagePath": "pages/user/user",
        "text": "我的"
      }
    ]
  },
  "networkTimeout": {
    "request": 60000,
    "uploadFile": 60000
  },
  "permission": {
    "scope.userLocation": {
      "desc": "用于打开地图帮助查找附近宠物医院"
    }
  },
  "requiredPrivateInfos": [
    "getLocation",
    "chooseLocation"
  ],
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json"
}
