{
  "kind": "retrieval_label_map",
  "map_version": "1.0.0",
  "created_on": "2026-10-03",
  "taxonomy_scope": "kb_card_labels",
  "purpose": "BUG-28/B02-2：把检索评测的疾病标签与知识卡分开——病族/亚型/物种范围/等价集合/粒度显式版本化，供病族折叠与角色指标消费。不修改产品排序。",
  "usage_rules": [
    "等价集合只在显式声明处生效；父子卡、局灶/全身亚型、跨病原物种专卡一律不默认等价。",
    "未在本映射登记的标签（含 KB 外正确标签）按其自身参与集合计分，折叠视图中单列 unmapped，不判病错或物种错。",
    "reference_code 仅在 evaluation/reference_data/label_ontology.json 的 product_kb_name 与卡名逐字相等时登记，只是口径对照，不从卡片制造金标准。",
    "本映射只登记知识卡标签，不定义“所有正确答案”；双层口径（病族/亚型、主病/并存）在评分解读前明确，不得靠合并标签虚增成绩。",
    "family_code / subtype_code / 等价集合的病族粒度是工程分组，临床使用前需独立临床复核；变更必须升 map_version 并可重算旧结果。"
  ],
  "granularity_vocabulary": {
    "disease_family_card": "病族通用卡（该病族在本物种范围的主卡）",
    "species_variant_card": "同一病族的物种专卡（与通用卡不默认等价）",
    "severity_subtype_card": "同一病族的严重度/范围亚型卡（如局灶型 vs 全身型，不默认等价）",
    "presentation_card": "以综合征/表现命名的卡（与底层病族同族但粒度不同，不默认等价）",
    "non_etiologic_card": "事件/形态/良性结构卡（创伤、叮咬、囊肿、血肿等，不是独立病因标签）"
  },
  "equivalence_sets": {
    "pyoderma_superficial_species_pair": {
      "members": [
        "浅表脓皮病",
        "猫浅表脓皮病"
      ],
      "basis": "同一浅表细菌性脓皮病病族的犬/猫物种显示变体；等价仅在各自物种病例内成立（物种过滤后同屏不会同时出现）",
      "declared_by": "B02-2 DEC-01 示例；待临床复核"
    },
    "solar_dermatitis_species_pair": {
      "members": [
        "日光性皮炎",
