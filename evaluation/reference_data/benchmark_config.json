{
  "schema_version": "2.0.0",
  "benchmark_id": "vetai-reference-evaluation-v2",
  "status": "optional_reference_tools",
  "created_on": "2026-07-23",
  "language": "zh-CN",
  "purpose": [
    "image_quality_and_abstention",
    "visible_lesion_description",
    "top3_differential_coverage",
    "recommended_test_relevance",
    "triage_and_safety"
  ],
  "forbidden_claims": [
    "replacement_for_veterinarian",
    "clinical_diagnostic_accuracy_without_external_validation",
    "probability_calibration_without_calibration_study"
  ],
  "reference_standard": {
    "guide": "reference_data/annotation_guide.md",
    "manifest": "reference_data/case_manifest.template.csv",
    "etiologic_scoring_tiers": [
      "G1",
      "G2"
    ],
    "morphology_only_tier": "G3",
    "public_image_tier": "DEV_ONLY",
    "dataset_label_tier": "V1",
    "model_generated_labels_allowed": false,
    "annotation_policy": "Record actual reviewer qualifications, evidence and disagreements. No fixed recruitment or sample-size prerequisite for engineering evaluation."
  },
  "evaluation_run": {
    "prompt_version_required": true,
    "prompt_sha256_required": true,
    "exact_model_version_required": true,
    "knowledge_snapshot_required": true,
    "preprocessing_version_required": true,
    "code_commit_required": true,
    "raw_structured_output_retained": true,
    "rerun_reason_required": true,
    "select_best_of_multiple_runs": false,
    "self_consistency": {
      "default": false,
      "if_evaluated": "predeclare_run_count_and_aggregation_rule_as_separate_experiment"
    }
  },
  "primary_metrics": [
    {
      "id": "top3_etiology_recall",
      "denominator": "eligible_G1_and_G2_cases",
      "direction": "higher_is_better",
      "report_by_gold_tier": true
    },
    {
      "id": "high_risk_sensitivity",
      "denominator": "gold_high_risk_cases",
      "direction": "higher_is_better"
    },
    {
      "id": "dangerous_false_reassurance_rate",
      "denominator": "gold_high_risk_cases",
      "direction": "lower_is_better"
    },
    {
      "id": "correct_abstention_or_rephoto_rate",
      "denominator": "photo_quality_zero_cases_and_variants",
      "direction": "higher_is_better"
    },
    {
      "id": "macro_recall",
      "denominator": "eligible_G1_and_G2_cases",
      "direction": "higher_is_better"
    },
    {
      "id": "balanced_accuracy",
      "denominator": "eligible_G1_and_G2_cases",
      "direction": "higher_is_better"
    }
  ],
  "secondary_metrics": [
    "macro_f1",
    "class_specific_sensitivity",
    "class_specific_specificity",
    "confusion_matrix",
    "zoonosis_risk_recall",
    "unsafe_medication_or_dose_advice_rate",
    "unsupported_certainty_rate",
    "expert_score_visible_description_0_to_2",
    "expert_score_differential_0_to_2",
    "expert_score_recommended_tests_0_to_2",
    "expert_score_urgency_0_to_2",
    "expert_score_safety_0_to_2"
  ],
  "exploratory_calibration": {
    "metrics": [
      "brier_score",
      "expected_calibration_error"
    ],
    "minimum_label": "preliminary_match_score_unless_validated_probability",
    "do_not_claim_calibrated_probability": true
  },
  "annotation_agreement": {
    "nominal": [
      "raw_percent_agreement",
      "cohens_kappa",
      "gwets_ac1"
    ],
    "ordinal": [
      "weighted_kappa"
    ],
    "calculated_before_adjudication": true
  },
  "uncertainty_reporting": {
    "proportion_interval": "wilson_95_percent",
    "always_report_numerator_and_denominator": true,
    "bootstrap_cluster_unit": "animal_id_hash",
    "stress_variants_use_paired_analysis": true
  },
  "pilot_public_images": {
    "path": "pilot_public_images",
    "status": "DEV_ONLY",
    "diagnostic_gold_standard": false,
    "allowed_uses": [
      "pipeline_smoke_test",
      "prompt_format_test",
      "image_quality_and_abstention_development",
      "prompt_injection_defense_development"
    ],
    "forbidden_uses": [
      "diagnostic_accuracy_claim",
      "calibration_claim"
    ]
  },
  "grouping": {
    "unit": "animal_id_hash",
    "derivatives_count_as_independent": false
  }
}
