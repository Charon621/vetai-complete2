/* ═══════════════════════════════════════════════════════
   Result Page — VetAI DS v5
   结论前置 / 处方笺式墨线分层 / 匹配 chip / checklist
   ═══════════════════════════════════════════════════════ */

.report-page {
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

/* ═══════════════════════════════════════
   0. 骨架屏（记录载入前占位）
   ═══════════════════════════════════════ */
.report-skeleton {
  margin-top: var(--sp-2);
}

.sk-hero {
  height: 220rpx;
  border-radius: var(--r-md);
}

.sk-line {
  height: 40rpx;
  margin-top: var(--sp-2);
  border-radius: var(--r-sm);
}

.sk-short {
  width: 60%;
}

/* ═══════════════════════════════════════
   1. 顶部结论区（结论前置）
   ═══════════════════════════════════════ */
.conclusion {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-3);
  margin-top: var(--sp-1);
}

.conclusion-main { flex: 1; min-width: 0; }

.conclusion-meta {
  display: block;
  color: var(--gold);
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  letter-spacing: 4rpx;
}

.sev-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: var(--sp-2);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: var(--fs-caption);
  font-weight: 700;
}

.sev-chip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
  flex-shrink: 0;
}

.sev-chip-low { background: var(--sev-low-bg); color: var(--sev-low); }
.sev-chip-moderate { background: var(--sev-mid-bg); color: var(--sev-mid-text); }
.sev-chip-urgent { background: var(--sev-urgent-bg); color: var(--sev-urgent); }
.sev-chip-emergency { background: var(--sev-emergency-bg); color: var(--sev-emergency); }

.conclusion-title {
  margin-top: var(--sp-2);
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: 900;
  line-height: 1.35;
}

.conclusion-note {
  margin-top: 8rpx;
  color: var(--body);
  font-size: var(--fs-caption);
  line-height: 1.65;
}

.conclusion-seal {
  flex-shrink: 0;
  margin-top: var(--sp-4);
}

.conclusion-rule { margin: var(--sp-4) 0 0; }

/* ═══════════════════════════════════════
   2. 可能是什么
   ═══════════════════════════════════════ */
.dx-block { margin-top: var(--sp-4); }

.dx-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-2);
}

.dx-eyebrow {
  color: var(--gold);
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  font-weight: 600;
  letter-spacing: 4rpx;
}

/* 匹配度徽标：非动作元素，用淡金雾而非青柠 */
.match-chip {
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: var(--gold-mist);
  border: 1rpx solid var(--gold-line);
  color: var(--gold);
  font-size: var(--fs-mini);
  font-weight: 700;
}

.dx-name {
  margin-top: var(--sp-2);
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 900;
  line-height: 1.35;
}

.dx-sub {
  margin-left: var(--sp-2);
  color: var(--muted);
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  font-weight: 400;
}

.dx-desc {
  margin-top: 8rpx;
  color: var(--body);
  font-size: var(--fs-caption);
  line-height: 1.65;
}

.dx-thumbs {
  margin-top: var(--sp-3);
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.dx-thumb {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  border-radius: var(--r-sm);
  overflow: hidden;
  background: var(--surface);
  border: 1rpx solid var(--line);
  flex-shrink: 0;
}

.dx-thumb image { width: 100%; height: 100%; }

.dx-thumb-lesion {
  position: absolute;
  border: 2rpx dashed var(--accent-line);
  background: var(--accent-mist);
  border-radius: 4rpx;
  box-sizing: border-box;
}

.dx-thumb-note {
  flex: 1;
  min-width: 0;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.dx-thumb-link { color: var(--brand); font-weight: 700; border-bottom: 2rpx solid var(--lime); padding-bottom: 2rpx; }

.dx-secondary {
  margin-top: var(--sp-3);
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.6;
}

/* ═══════════════════════════════════════
   3. 接下来怎么做 checklist
   ═══════════════════════════════════════ */
.care-block {
  margin-top: var(--sp-5);
  border-top: 1rpx solid var(--line);
  padding-top: var(--sp-3);
}

.checklist {
  margin-top: var(--sp-2);
  display: flex;
  flex-direction: column;
}

.check-item {
  display: flex;
  gap: var(--sp-2);
  padding: var(--sp-2) 0;
  border-bottom: 1rpx dashed var(--line);
}

.check-item:last-child { border-bottom: none; }

.check-box {
  width: 30rpx;
  height: 30rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
  box-sizing: border-box;
}

.check-box-now { border: 2rpx solid var(--brand); }
.check-box-watch { border: 2rpx solid var(--sev-mid); }
.check-box-vet { border: 2rpx solid var(--accent); }

.check-text {
  flex: 1;
  min-width: 0;
  color: var(--text);
  font-size: var(--fs-caption);
  line-height: 1.6;
}

.check-tag { font-weight: 900; font-family: var(--font-serif); }

/* ═══════════════════════════════════════
   4. Report Blocks（判断依据 / 参考来源）
   ═══════════════════════════════════════ */
.report-block {
  margin-top: var(--sp-3);
  padding: var(--sp-3);
  border-radius: var(--r-md);
  background: var(--card);
  border: 1rpx solid var(--line-light);
  box-sizing: border-box;
}

.block-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.block-title-wrap {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.block-title {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.35;
}

.block-desc {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.5;
}

.evidence-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.evidence-item {
  padding-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--line-light);
}

.evidence-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.evidence-key {
  color: var(--muted);
  font-size: var(--fs-caption);
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 6rpx;
}

.evidence-value {
  color: var(--body);
  font-size: var(--fs-body);
  line-height: 1.65;
}

.source-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.source-item {
  padding-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--line-light);
}

.source-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.source-title {
  color: var(--text);
  font-size: var(--fs-caption);
  font-weight: 700;
  line-height: 1.45;
}

.source-meta {
  margin-top: 4rpx;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  color: var(--muted);
  font-size: var(--fs-mini);
  line-height: 1.4;
  word-break: break-all;
}

/* ═══════════════════════════════════════
   5. 反馈（收成一行，点“没有”再展开）
   ═══════════════════════════════════════ */
.feedback-inline {
  margin-top: var(--sp-5);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--line);
}

.feedback-inline-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}

.feedback-inline-q {
  color: var(--muted);
  font-size: var(--fs-caption);
}

.feedback-inline-opts { display: flex; gap: var(--sp-1); }

.fb-chip {
  display: inline-flex;
  align-items: center;
  min-height: 52rpx;
  padding: 0 var(--sp-3);
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--text);
  font-size: var(--fs-caption);
  font-weight: 600;
}

.fb-chip.on {
  background: var(--brand);
  border-color: var(--brand);
  color: var(--on-brand);
}

.fb-chip-sm { min-height: 48rpx; font-size: var(--fs-mini); }

.fb-followup-q {
  margin-top: var(--sp-3);
  color: var(--body);
  font-size: var(--fs-caption);
}

.fb-wrap {
  margin-top: var(--sp-2);
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
}

.feedback-done-inline {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  color: var(--brand);
  font-size: var(--fs-caption);
}

.feedback-done-icon {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--brand);
  color: var(--card);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.feedback-done-check {
  transform: scale(0.55) rotate(-45deg); /* 全局对勾在 34rpx 圆徽内光学缩小 */
}

.feedback-done-text { color: var(--body); }

.feedback-edit-link {
  margin-left: auto;
  color: var(--brand);
  font-weight: 600;
}

/* ═══════════════════════════════════════
   6. 页脚 / 次级操作
   ═══════════════════════════════════════ */
.report-footer {
  margin-top: var(--sp-4);
  color: var(--faint);
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  line-height: 1.6;
}

.report-more {
  margin-top: var(--sp-3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
}

.report-more-link {
  color: var(--muted);
  font-size: var(--fs-caption);
}

.report-more-sep {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--faint);
}

/* ═══════════════════════════════════════
   7. 底部操作栏 — 浮起面板（与 index/chat 底栏统一）
   ═══════════════════════════════════════ */
.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-2);
  padding: var(--sp-2) var(--sp-4) calc(var(--sp-3) + env(safe-area-inset-bottom));
  border-radius: var(--r-md) var(--r-md) 0 0;
  border-top: 1rpx solid var(--line);
  background: var(--card);
  box-shadow: var(--shadow-bar);
  box-sizing: border-box;
}

.bottom-actions .vet-btn {
  min-height: 96rpx;
  border-radius: 999rpx;
  font-size: var(--fs-body);
  font-weight: 700;
}

/* 紧急时「找医院」按钮转珊瑚红 */
.report-page.sev-urgent .find-hospital-btn,
.report-page.sev-emergency .find-hospital-btn {
  color: var(--sev-emergency);
  border-color: var(--sev-emergency);
}

/* ═══════════════════════════════════════
   Dark Mode
   ═══════════════════════════════════════ */
@media (prefers-color-scheme: dark) {
  .bottom-actions {
    background: var(--card);
    border-top-color: var(--line);
  }
}
