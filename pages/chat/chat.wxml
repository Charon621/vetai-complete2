<view class="chat-page">
  <!-- 档案选择器 -->
  <view class="profile-picker-mask" wx:if="{{showProfilePicker}}" bindtap="closeProfilePicker">
    <view class="profile-picker-sheet" catchtap="noop">
      <view class="profile-picker-title">选择宠物档案</view>
      <view class="profile-picker-sub">选择已有档案继续问诊，或新建档案</view>
      <view class="profile-picker-list">
        <view class="profile-picker-item" wx:for="{{profiles}}" wx:key="id" data-id="{{item.id}}" bindtap="onPickProfile">
          <view class="profile-picker-avatar">
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" />
            <text wx:else>{{item.avatarText}}</text>
          </view>
          <view class="profile-picker-info">
            <view class="profile-picker-name">{{item.petName}}</view>
            <view class="profile-picker-meta">{{item.petTypeLabel}}{{item.breed ? '，' + item.breed : ''}}{{item.ageLabel ? '，' + item.ageLabel : ''}}</view>
          </view>
          <view class="profile-picker-arrow vic vic-arrow"></view>
        </view>
      </view>
      <view class="profile-picker-new" bindtap="onPickNewProfile">
        <view class="profile-picker-new-icon vic vic-plus"></view>
        <text>新建档案</text>
      </view>
    </view>
  </view>

  <!-- 顶部标题栏 -->
  <view class="chat-header" style="padding-top: {{statusBarHeight * 2}}rpx; padding-right: {{menuRight}}px;">
    <view class="chat-header-left">
      <view class="chat-back-btn" bindtap="onBackTap" aria-label="返回">
        <view class="vic vic-back"></view>
      </view>
      <view class="chat-doctor-avatar">
        <view class="vic vic-cross"></view>
      </view>
      <view class="chat-header-info">
        <view class="chat-header-title">AI 兽医助手</view>
        <view class="chat-header-sub">
          <text class="chat-status-dot"></text>
          <block wx:if="{{isAnalyzing}}"><text>正在分析中…</text></block>
          <block wx:elif="{{draftPetName}}"><text>在线</text><text class="mid-dot"></text><text>正在问诊{{draftPetName}}</text></block>
          <block wx:else><text>在线问诊</text></block>
        </view>
      </view>
    </view>
    <view class="chat-header-actions">
      <view class="chat-history-btn" bindtap="goHistory" aria-label="历史记录">
        <text class="chat-history-text">历史</text>
      </view>
      <view class="chat-new-btn" bindtap="onNewChat">
        <text class="chat-new-text">新问诊</text>
      </view>
    </view>
  </view>

  <!-- 恢复草稿提示 -->
  <view class="restored-notice" wx:if="{{restoredNotice}}" bindtap="dismissRestoredNotice">
    <text>已恢复上次的对话进度，点击关闭</text>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="chat-messages" scroll-y scroll-into-view="{{scrollIntoView}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <block wx:for="{{messages}}" wx:key="id">
      <view class="msg-time-divider" wx:if="{{item.showTime}}">— {{item.timeText}} —</view>
      <view class="msg-row vet-fade-up {{item.isUser ? 'msg-row-user' : 'msg-row-doctor'}}">
        <view class="msg-avatar" wx:if="{{item.isDoctor}}">
          <view class="vic vic-cross"></view>
        </view>
        <view class="msg-avatar msg-avatar-user" wx:if="{{item.isUser}}">
          <view class="vic vic-user"></view>
        </view>
        <view class="msg-content">
          <view class="msg-bubble {{item.isUser ? 'msg-bubble-user' : 'msg-bubble-doctor'}}" wx:if="{{item.text}}">
            <text class="msg-text">{{item.text}}</text>
          </view>
          <view class="msg-images" wx:if="{{item.images.length > 0}}">
            <image wx:for="{{item.images}}" wx:key="*this" wx:for-item="img" src="{{img}}" mode="aspectFill" class="msg-image" />
          </view>
          <view class="msg-image-wrap" wx:elif="{{item.image}}">
            <image src="{{item.image}}" mode="aspectFill" class="msg-image" />
          </view>
        </view>
      </view>
    </block>
    <view class="chat-progress" wx:if="{{showProgress}}">
      <view class="chat-progress-dot"></view>
      <text>{{progressText}}</text>
    </view>
    <view id="msg-bottom" class="msg-bottom-anchor"></view>
  </scroll-view>

  <!-- 上传照片预览 + 操作 -->
  <view class="photo-preview-bar" wx:if="{{uploadedPhotos.length > 0 && showPhotoActions}}">
    <view class="photo-preview-list">
      <view class="photo-preview-item" wx:for="{{uploadedPhotos}}" wx:key="*this" data-index="{{index}}">
        <image src="{{item}}" mode="aspectFill" class="photo-preview-img" />
        <view class="photo-preview-remove" catchtap="onRemovePhoto" data-index="{{index}}"><view class="vic vic-close"></view></view>
        <view class="photo-preview-circle" catchtap="onOpenLesionSelector" data-index="{{index}}">圈选</view>
      </view>
    </view>
    <view class="photo-preview-actions">
      <view class="photo-preview-btn-cancel" bindtap="onCancelPhotos">取消</view>
      <view class="photo-preview-btn-secondary" bindtap="onUploadPhoto" wx:if="{{uploadedPhotos.length < 5}}">继续添加</view>
      <view class="photo-preview-btn-primary" bindtap="onConfirmPhotos">确认上传</view>
    </view>
  </view>

  <!-- 底部输入区 -->
  <view class="chat-input-area" wx:if="{{!showPhotoActions}}">
    <scroll-view class="quick-replies" scroll-x wx:if="{{quickReplies.length > 0 || showProgress}}" show-scrollbar="{{false}}">
      <view class="qr-row">
        <view class="qr-chip {{item.field}}" wx:for="{{quickReplies}}" wx:key="key" data-index="{{index}}" bindtap="onQuickReplyTap">
          {{item.label}}
        </view>
        <view class="qr-chip qr-skip" wx:if="{{showProgress}}" bindtap="onSkipQuestion">跳过</view>
      </view>
    </scroll-view>

    <view class="input-row" wx:if="{{inputType !== 'analyzing' && inputType !== 'result'}}">
      <view class="input-plus-btn" bindtap="onUploadPhoto">
        <view class="vic vic-plus"></view>
      </view>
      <input class="chat-input" value="{{inputText}}" placeholder="{{placeholder || '输入消息…'}}" bindinput="onInput" confirm-type="send" bindconfirm="onSendText" adjust-position />
      <view class="send-btn {{inputText ? 'send-btn-active' : ''}}" bindtap="onSendText">
        <view class="vic vic-up"></view>
      </view>
    </view>

    <view class="input-row analyzing-row" wx:elif="{{inputType === 'analyzing'}}">
      <view class="analyzing-hint">
        <text>正在分析中</text>
        <view class="typing-dots">
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
        </view>
      </view>
    </view>

    <view class="input-row result-row" wx:elif="{{inputType === 'result'}}">
      <view class="result-hint">分析完成</view>
    </view>
  </view>

  <!-- 圈选器 -->
  <lesion-selector
    visible="{{selectorVisible}}"
    image-path="{{selectorImagePath}}"
    initial-box="{{selectorInitialBox}}"
    bind:save="onLesionSave"
    bind:clear="onLesionClear"
    bind:close="onLesionClose" />

  <!-- 隐藏画布：供 image.js 的 canvas.toDataURL 兜底和 ROI 裁剪使用 -->
  <canvas type="2d" id="fallbackCanvas" style="position:fixed;left:-9999px;top:-9999px;width:1px;height:1px;"></canvas>
  <canvas type="2d" id="resizeCanvas" style="position:fixed;left:-9999px;top:-9999px;width:1px;height:1px;"></canvas>
</view>
