<wxs module="fmt">
/* 纯展示层格式化：日期串取数字生成报告编号；区块序号补零 */
function serial(dateStr) {
  var s = '' + (dateStr || '')
  var digits = s.replace(getRegExp('[^0-9]', 'g'), '')
  return digits ? digits.slice(0, 8) : '0000'
}
function no(n) {
  return n < 10 ? '0' + n : '' + n
}
/* 记录 id 尾 4 位：同一天多次问诊靠它区分 */
function tail(id) {
  var s = '' + (id || '')
  var digits = s.replace(getRegExp('[^0-9a-zA-Z]', 'g'), '')
  return digits ? digits.slice(-4) : '0000'
}
module.exports = { serial: serial, no: no, tail: tail }
</wxs>

<view class="report-page">
  <block wx:if="{{displayRecord}}">
    <!-- 刊头：报告编号（日期 + 记录 id 尾号，避免同一天多次问诊编号重复，BUG-UI26） -->
    <view class="report-masthead vet-fade-up">
      <text class="vet-mono-gold">No. {{fmt.serial(displayRecord.dateStr)}}-{{fmt.tail(displayRecord.id)}}</text>
      <view class="report-masthead-badge">简版报告</view>
    </view>

    <!-- 结论区：宠物名 + 来源标注 -->
    <view class="report-head vet-fade-up vet-stagger-1">
      <view class="report-head-main">
        <view class="vet-title-xl">{{displayRecord.petName}}</view>
        <view class="report-pet-meta">{{displayRecord.petTypeLabel}}{{displayRecord.breed ? '，' + displayRecord.breed : ''}}{{displayRecord.dateStr ? ' / ' + displayRecord.dateStr : ''}}</view>
      </view>
      <!-- BUG-UI63：双圈印章易被误读为认证，改为来源标注 -->
      <view class="report-origin">AI 生成 · 仅供参考</view>
    </view>

    <!-- 结论面板：严重度渐变底 + 状态 + 结论 -->
    <view class="report-verdict verdict-{{displayRecord.urgency}} vet-fade-up vet-stagger-2">
      <view class="verdict-body">
        <view class="vet-status sev-{{displayRecord.urgency}}">{{displayRecord.urgencyText}}</view>
        <!-- BUG-UI23：补字段名，原先只渲染值，用户不知道这串粗体字是什么 -->
        <view class="vet-label verdict-label">初步判断</view>
        <view class="verdict-text" wx:if="{{displayRecord.lines.length > 0}}">{{displayRecord.lines[0].value}}</view>
      </view>
    </view>

    <!-- 照片 -->
    <view class="report-photos vet-fade-up vet-stagger-3" wx:if="{{displayRecord.photos.length > 0}}">
      <scroll-view class="report-photos-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="report-photos-row">
          <image wx:for="{{displayRecord.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="report-photo"
            aria-label="患处照片" bindtap="onPreviewPhoto" data-index="{{index}}" />
        </view>
      </scroll-view>
    </view>

    <!-- 诊断信息（首条已在结论块呈现，此处从第二条起编号列出） -->
    <view class="report-sections vet-card vet-fade-up vet-stagger-4" wx:if="{{displayRecord.lines.length > 1}}">
      <block wx:for="{{displayRecord.lines}}" wx:key="label">
        <block wx:if="{{index > 0}}">
          <view class="report-section">
            <view class="report-section-head">
              <text class="vet-no report-section-no">{{index}}</text>
              <text class="report-section-label">{{item.label}}</text>
            </view>
            <view class="report-section-value">{{item.value}}</view>
          </view>
        </block>
      </block>
    </view>

    <!-- 免责声明 -->
    <view class="report-disclaimer">
      以上内容由 AI 生成，仅作为初步参考，不能替代兽医面诊。如症状持续或加重，请及时就诊。
    </view>

    <!-- 底部操作 -->
    <view class="report-actions" wx:if="{{displayRecord.assessmentView.canRetry || displayRecord.assessmentView.canDeepen}}">
      <view class="vet-btn vet-btn-secondary report-btn" wx:if="{{displayRecord.assessmentView.canRetry}}" bindtap="onRetryAnalysis">{{deepening ? '分析中…' : '重试分析'}}</view>
      <view class="vet-btn vet-btn-secondary report-btn" wx:if="{{displayRecord.assessmentView.canDeepen}}" bindtap="onDeepenAnalysis">{{deepening ? '分析中…' : displayRecord.assessmentView.deepeningLabel}}</view>
    </view>
    <view class="report-actions">
      <view class="vet-btn vet-btn-secondary report-btn" bindtap="goHistory">查看记录</view>
      <view class="vet-btn vet-btn-ink report-btn" bindtap="onBack">返回对话</view>
    </view>
  </block>

  <view class="report-empty-wrap" wx:elif="{{notFound}}">
    <view class="vet-empty">
      <text class="vet-empty-title">报告不存在</text>
      <text>报告不存在或已被删除</text>
    </view>
    <view class="vet-btn vet-btn-primary report-empty-btn" bindtap="onBack">返回</view>
  </view>
  <canvas type="2d" id="shareCanvas" style="position:fixed;left:-9999px;top:-9999px;width:750px;height:1200px;"></canvas>
</view>
