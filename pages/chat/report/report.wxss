/* 底部内边距与全局 .vet-page 对齐（BUG-UI22），并改用 --vet-safe-bottom 令牌 */
.report-page {
  min-height: 100vh;
  background: var(--bg);
  padding: var(--sp-3) var(--vet-page-x) calc(var(--sp-6) + var(--vet-safe-bottom));
  box-sizing: border-box;
}

/* ── 刊头 ─────────────────────────────── */
.report-masthead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--sp-4);
}

.report-masthead-badge {
  padding: 4rpx 14rpx;
  border-radius: var(--r-xs);
  background: var(--surface);
  color: var(--body);
  font-size: var(--fs-mini);
}

/* ── 结论区（宠物名 + 印章） ─────────────── */
.report-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-4);
}

.report-head-main {
  flex: 1;
  min-width: 0;
}

.report-pet-meta {
  font-size: var(--fs-caption);
  color: var(--muted);
  margin-top: var(--sp-1);
}

.report-origin {
  flex: none;
  margin-top: var(--sp-1);
  padding: 4rpx var(--sp-2);
  border-radius: var(--r-xs);
  background: var(--surface);
  color: var(--body);
  font-size: var(--fs-mini);
}



/* ── 结论面板：严重度渐变底，不画竖条 ─────── */
/* BUG-UI20：与 result.wxss 共用同一套令牌渐变，不再两页各写一遍 hex。
   模板拼的是 verdict-{{urgency}}，urgency 归一化后只会是 low/moderate/urgent/emergency，
   默认底色即 moderate，所以不再单独定义 .verdict-moderate。 */
.report-verdict {
  border-radius: var(--r-lg);
  background: linear-gradient(160deg, var(--sev-mid-bg) 0%, var(--sev-mid-mid) 55%, var(--bg) 100%);
  margin-bottom: var(--sp-3);
}

.verdict-low { background: linear-gradient(160deg, var(--sev-low-bg) 0%, var(--sev-low-mid) 55%, var(--bg) 100%); }
.verdict-urgent { background: linear-gradient(160deg, var(--sev-urgent-bg) 0%, var(--sev-urgent-mid) 55%, var(--bg) 100%); }
.verdict-emergency { background: linear-gradient(160deg, var(--sev-emergency-bg) 0%, var(--sev-emergency-mid) 55%, var(--bg) 100%); }

.verdict-body {
  padding: var(--sp-4);
}

.verdict-label {
  display: block;
  margin-top: var(--sp-2);
}

.verdict-text {
  margin-top: var(--sp-1);
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: 800;
  color: var(--text);
  line-height: 1.4;
}

/* ── 照片 ─────────────────────────────── */
.report-photos {
  margin-bottom: var(--sp-3);
}

.report-photos-scroll {
  height: 200rpx;
}

.report-photos-row {
  display: inline-flex;
  gap: var(--sp-2);
  padding-right: var(--sp-3);
}

.report-photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--r-sm);
  flex-shrink: 0;
}

/* ── 诊断信息：奶白卡片，条目靠留白分开 ─────── */
/* BUG-UI22：原先手工复刻 .vet-card 且内边距 28rpx，与相邻面板 32rpx 差 4rpx；
   改为直接复用全局卡片类。 */
.report-sections {
  padding: var(--sp-1) var(--sp-4);
  margin-bottom: var(--sp-3);
}

.report-section {
  padding: var(--sp-3) 0;
}

.report-section-head {
  display: flex;
  align-items: baseline;
  gap: var(--sp-1);
  margin-bottom: 8rpx;
}

.report-section-no {
  font-size: var(--fs-title);
  line-height: 1;
}

.report-section-label {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--muted);
}

.report-section-value {
  font-size: var(--fs-body);
  color: var(--text);
  line-height: 1.65;
  white-space: pre-wrap;
}

/* ── 免责声明 ─────────────────────────────── */
/* BUG-UI4：原先用 --faint，对纸底只有 2.51:1，关键提示读不清 */
.report-disclaimer {
  font-size: var(--fs-mini);
  color: var(--muted);
  line-height: 1.6;
  text-align: center;
  padding: var(--sp-2) var(--sp-3);
  margin-bottom: var(--sp-3);
}

/* ── 底部操作 ─────────────────────────────── */
.report-actions {
  display: flex;
  gap: var(--sp-2);
}

.report-btn {
  flex: 1;
}

/* ── 空状态 ─────────────────────────────── */
.report-empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  /* 空态垂直居中：用 flex 撑开而不是 200rpx 魔数 */
  min-height: 60vh;
  justify-content: center;
  gap: var(--sp-4);
}

.report-empty-btn {
  align-self: center;
  min-width: 320rpx;
}
