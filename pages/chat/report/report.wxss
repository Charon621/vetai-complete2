.report-page {
  min-height: 100vh;
  background: var(--bg);
  padding: var(--sp-3) var(--sp-3) calc(var(--sp-4) + env(safe-area-inset-bottom));
}

/* ── 报告头 ─────────────────────────────── */
.report-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-3);
  background: var(--card);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-sm);
  margin-bottom: var(--sp-2);
}

.report-pet-name {
  font-size: 36rpx;
  font-weight: 700;
  font-family: var(--font-serif);
  color: var(--text);
}

.report-pet-meta {
  font-size: var(--fs-caption);
  color: var(--muted);
  margin-top: 4rpx;
}

.report-date {
  font-size: var(--fs-mini);
  color: var(--faint);
  font-weight: 600;
}

/* ── 紧急程度 ─────────────────────────────── */
.urgency-banner {
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-sm);
  margin-bottom: var(--sp-2);
  text-align: center;
}

.urgency-low { background: var(--sev-low-bg, #f0fdf4); }
.urgency-low .urgency-label { color: #16a34a; }

.urgency-moderate { background: #fffbeb; }
.urgency-moderate .urgency-label { color: #d97706; }

.urgency-urgent { background: #fef2f2; }
.urgency-urgent .urgency-label { color: #dc2626; }

.urgency-emergency { background: #fef2f2; }
.urgency-emergency .urgency-label { color: #dc2626; }

.urgency-label {
  font-size: var(--fs-body);
  font-weight: 700;
}

/* ── 照片 ─────────────────────────────── */
.report-photos {
  margin-bottom: var(--sp-2);
}

.report-photos-row {
  display: inline-flex;
  gap: var(--sp-2);
  padding-right: var(--sp-3);
}

.report-photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--r-sm);
  flex-shrink: 0;
}

/* ── 诊断信息 ─────────────────────────────── */
.report-sections {
  background: var(--card);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  margin-bottom: var(--sp-3);
}

.report-section {
  padding: var(--sp-3);
  border-bottom: 1rpx solid var(--line-light);
}

.report-section:last-child {
  border-bottom: none;
}

.report-section-label {
  font-size: var(--fs-mini);
  font-weight: 700;
  color: var(--brand);
  margin-bottom: var(--sp-1);
}

.report-section-value {
  font-size: var(--fs-body);
  color: var(--text);
  line-height: 1.6;
  white-space: pre-wrap;
}

/* ── 免责声明 ─────────────────────────────── */
.report-disclaimer {
  font-size: var(--fs-mini);
  color: var(--faint);
  line-height: 1.5;
  text-align: center;
  padding: var(--sp-2) var(--sp-3);
  margin-bottom: var(--sp-3);
}

/* ── 底部操作 ─────────────────────────────── */
.report-actions {
  display: flex;
  gap: var(--sp-2);
}

.report-btn-primary {
  flex: 1;
  text-align: center;
  padding: var(--sp-3) 0;
  border-radius: var(--r-md);
  background: var(--brand);
  color: #ffffff;
  font-size: var(--fs-body);
  font-weight: 650;
  box-shadow: var(--shadow-sm);
}

.report-btn-primary:active { opacity: 0.85; }

.report-btn-secondary {
  flex: 1;
  text-align: center;
  padding: var(--sp-3) 0;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: var(--fs-body);
  font-weight: 600;
}

.report-btn-secondary:active { opacity: 0.85; }

/* ── 空状态 ─────────────────────────────── */
.report-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  gap: var(--sp-4);
}

.report-empty-text {
  font-size: var(--fs-body);
  color: var(--muted);
}
