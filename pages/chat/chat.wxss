/* ═══════════════════════════════════════════
   Chat Page — VetAI DS v6
   对话式问诊页面
   ═══════════════════════════════════════════ */

/* page 必须有明确高度，.chat-page 的 height:100% / flex:1 才能生效，
   否则 flex 容器塌陷为内容高度，输入框会上移、下半屏空白 */
page {
  height: 100%;
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--bg);
}

/* ── 档案选择器 ─────────────────────────────── */
.profile-picker-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--scrim);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.profile-picker-sheet {
  width: 100%;
  background: var(--card);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: var(--sp-4) var(--sp-3) calc(var(--sp-4) + env(safe-area-inset-bottom));
  animation: slideUp var(--dur-base) var(--ease-out);
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.profile-picker-title {
  font-size: var(--fs-title);
  font-weight: 700;
  font-family: var(--font-serif);
  color: var(--text);
  text-align: center;
}

.profile-picker-sub {
  font-size: var(--fs-caption);
  color: var(--muted);
  text-align: center;
  margin-top: var(--sp-1);
  margin-bottom: var(--sp-3);
}

.profile-picker-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.profile-picker-item {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-2);
  border-radius: var(--r-md);
  margin-bottom: var(--sp-1);
}

.profile-picker-item:active {
  background: var(--surface);
}

.profile-picker-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
}

.profile-picker-avatar image {
  width: 100%;
  height: 100%;
}

.profile-picker-info {
  flex: 1;
  min-width: 0;
}

.profile-picker-name {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--text);
}

.profile-picker-meta {
  font-size: var(--fs-mini);
  color: var(--muted);
  margin-top: 4rpx;
}

.profile-picker-arrow {
  color: var(--faint);
}

.profile-picker-new {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  padding: var(--sp-3);
  margin-top: var(--sp-2);
  border-radius: var(--r-md);
  background: var(--brand-light);
  color: var(--brand);
  font-size: var(--fs-body);
  font-weight: 600;
}

.profile-picker-new:active {
  opacity: 0.8;
}

.profile-picker-new-icon {
  width: 24rpx;
  height: 24rpx;
}

/* ── 顶部标题栏 ─────────────────────────────── */
/* padding-top 由 wxml 内联 statusBarHeight 提供（custom 导航，JS 计算跨平台可靠），
   此处不再叠加 env(safe-area-inset-top) */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-2) var(--sp-3);
  background: var(--card);
  border-bottom: 4rpx solid var(--text);
  flex-shrink: 0;
}

.chat-header-left {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.chat-back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid var(--text);
  background: var(--card);
  flex-shrink: 0;
  box-sizing: border-box;
}

.chat-back-btn:active {
  background: var(--brand-light);
}

.chat-back-btn .vic-back {
  width: 18rpx;
  height: 18rpx;
  color: var(--text);
  transform: rotate(45deg);
  margin-left: 4rpx;
}

.chat-doctor-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand);
  color: var(--lime);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.chat-header-left {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  flex: 1;
  min-width: 0;
}

.chat-header-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.chat-header-title {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 900;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-header-sub {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 2rpx;
  color: var(--gold);
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  letter-spacing: 2rpx;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--lime);
  border: 1rpx solid var(--brand-mid);
  flex-shrink: 0;
}

.chat-header-actions {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  flex-shrink: 0;
}

.chat-history-btn {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: var(--sp-1) 0;
}

.chat-history-btn:active { opacity: 0.6; }

.chat-history-text {
  color: var(--muted);
  font-size: var(--fs-caption);
  font-weight: 600;
  line-height: 1.2;
}

.chat-new-btn {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: var(--sp-1) 0;
}

.chat-new-btn:active { opacity: 0.6; }

.chat-new-text {
  color: var(--brand);
  font-size: var(--fs-caption);
  font-weight: 700;
  border-bottom: 2rpx solid var(--lime);
  padding-bottom: 2rpx;
  line-height: 1.2;
}

/* ── 恢复草稿提示 ───────────────────────────── */
.restored-notice {
  text-align: center;
  padding: var(--sp-1) var(--sp-3);
  background: var(--accent-soft);
  color: var(--accent);
  font-size: var(--fs-mini);
  font-weight: 600;
  flex-shrink: 0;
}

/* ── 消息列表 ─────────────────────────────────── */
.chat-messages {
  flex: 1;
  min-height: 0;
  padding: var(--sp-3) var(--sp-3) var(--sp-2);
}

.msg-row {
  display: flex;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
  align-items: flex-start;
}

.msg-row-user {
  flex-direction: row-reverse;
  padding-right: var(--sp-3);
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--brand);
  color: var(--lime);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.msg-avatar .vic-cross {
  transform: scale(0.85);
}

.msg-avatar-user {
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--muted);
}

.msg-content {
  max-width: 75%;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.msg-row-user .msg-content { align-items: flex-end; }

/* ── 消息气泡 ─────────────────────────────────── */
.msg-bubble {
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-bubble);
  word-break: break-all;
  box-sizing: border-box;
}

.msg-bubble-doctor {
  background: var(--card);
  border: 2rpx solid var(--brand);
  border-top-left-radius: var(--r-bubble-tip);
}

.msg-bubble-user {
  background: var(--brand);
  border-top-right-radius: var(--r-bubble-tip);
}

.msg-text {
  font-size: var(--fs-body);
  line-height: 1.6;
  white-space: pre-wrap;
}

.msg-bubble-doctor .msg-text { color: var(--text); }
.msg-bubble-user .msg-text { color: var(--on-brand); }

/* ── 图片消息 ─────────────────────────────────── */
.msg-images {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
  margin-top: var(--sp-1);
}

.msg-image-wrap {
  margin-top: var(--sp-1);
  border-radius: var(--r-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.msg-image {
  width: 240rpx;
  height: 240rpx;
  border-radius: var(--r-md);
}

/* ── 分组时间戳（居中） ───────────────────────── */
.msg-time-divider {
  text-align: center;
  margin: var(--sp-2) 0;
  color: var(--faint);
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  letter-spacing: 4rpx;
}

/* ── 问诊进度：非动作提示，用淡金雾而非青柠 ────── */
.chat-progress {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin: 0 0 var(--sp-2) 76rpx;
  padding: 14rpx 22rpx;
  border-radius: var(--r-md);
  background: var(--gold-mist);
  border: 1rpx dashed var(--gold-line);
  color: var(--body);
  font-size: var(--fs-mini);
  line-height: 1.6;
}

.chat-progress-dot {
  display: none;
}

/* ── 底部锚点 ─────────────────────────────────── */
.msg-bottom-anchor { height: 1rpx; }

/* ── 底部输入区（浮起面板，与 index/result 底栏统一） ── */
.chat-input-area {
  flex-shrink: 0;
  background: var(--card);
  border-top: 1rpx solid var(--line-light);
  border-radius: var(--r-md) var(--r-md) 0 0;
  box-shadow: var(--shadow-bar);
  padding: var(--sp-2) var(--sp-3) calc(var(--sp-2) + env(safe-area-inset-bottom));
}

/* ── 快捷回复 ─────────────────────────────────── */
.quick-replies {
  margin-bottom: var(--sp-2);
  white-space: nowrap;
}

.qr-row {
  display: inline-flex;
  gap: var(--sp-1);
  padding-right: var(--sp-3);
}

.qr-chip {
  display: inline-flex;
  align-items: center;
  min-height: 60rpx;
  padding: 0 var(--sp-3);
  border-radius: 999rpx;
  background: var(--card);
  border: 2rpx solid var(--brand);
  color: var(--brand);
  font-size: var(--fs-caption);
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  transition: transform var(--dur-fast) var(--ease-standard);
}

.qr-chip:active {
  background: var(--brand);
  color: var(--on-brand);
  border-color: var(--brand);
  transform: scale(0.96);
}

.qr-chip.qr-skip {
  border-color: var(--line);
  color: var(--muted);
}

.qr-chip.qr-skip:active {
  background: var(--surface);
  color: var(--body);
  border-color: var(--line);
}

/* ── 文本输入 ─────────────────────────────────── */
.input-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.input-plus-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--card);
  border: 2rpx solid var(--brand);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all var(--dur-fast) ease;
}

.input-plus-btn:active {
  transform: scale(0.94);
  opacity: 0.8;
}

.input-plus-btn .vic-plus {
  color: var(--brand);
}

.chat-input {
  flex: 1;
  min-height: 76rpx;
  padding: 0 var(--sp-3);
  border-radius: 999rpx;
  background: var(--surface);
  border: 1rpx solid transparent;
  font-size: var(--fs-body);
  box-sizing: border-box;
}

.chat-input:focus {
  border-color: var(--brand);
}

/* 发送按钮常态即青柠实心（动作色只给可点的动作） */
.send-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--lime);
  border: 1rpx solid var(--lime);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all var(--dur-fast) ease;
}

.send-btn:active { transform: scale(0.94); opacity: 0.9; }

.send-btn .vic-up {
  color: var(--on-lime);
}

/* ── 分析中 / 结果模式 ─────────────────────────── */
.analyzing-row, .result-row {
  justify-content: center;
}

.analyzing-hint, .result-hint {
  color: var(--muted);
  font-size: var(--fs-caption);
  font-weight: 600;
  padding: var(--sp-2) 0;
}

.analyzing-hint {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

/* 三点跳动 typing 指示器（CSS 绘制，非字符圆点） */
.typing-dots {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.typing-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  animation: vetTypingDot 1.2s ease-in-out infinite;
}

.typing-dot:nth-child(2) { animation-delay: 160ms; }
.typing-dot:nth-child(3) { animation-delay: 320ms; }

@keyframes vetTypingDot {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-6rpx); opacity: 1; }
}

/* ── 照片预览栏 ─────────────────────────────── */
.photo-preview-bar {
  flex-shrink: 0;
  background: var(--card);
  border-top: 1rpx solid var(--line-light);
  padding: var(--sp-2) var(--sp-3) calc(var(--sp-2) + env(safe-area-inset-bottom));
}

.photo-preview-list {
  display: flex;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
}

.photo-preview-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--r-sm);
  overflow: hidden;
  flex-shrink: 0;
}

.photo-preview-img {
  width: 100%;
  height: 100%;
}

.photo-preview-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--scrim);
  color: var(--on-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.photo-preview-remove .vic-close {
  transform: scale(0.55);
}

.photo-preview-circle {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--brand-overlay);
  color: var(--on-overlay);
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  padding: 4rpx 0;
}

.photo-preview-actions {
  display: flex;
  gap: var(--sp-2);
}

.photo-preview-btn-cancel {
  text-align: center;
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  background: transparent;
  color: var(--muted);
  font-size: var(--fs-caption);
  font-weight: 600;
  flex-shrink: 0;
}

.photo-preview-btn-secondary {
  flex: 1;
  text-align: center;
  padding: var(--sp-2) 0;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: var(--fs-caption);
  font-weight: 600;
}

.photo-preview-btn-primary {
  flex: 2;
  text-align: center;
  padding: var(--sp-2) 0;
  border-radius: var(--r-md);
  background: var(--brand);
  color: var(--on-brand);
  font-size: var(--fs-body);
  font-weight: 700;
}

.photo-preview-btn-primary:active,
.photo-preview-btn-secondary:active,
.photo-preview-btn-cancel:active {
  opacity: 0.85;
}

/* 圈选器已抽取为 components/lesion-selector，样式见组件内 */
