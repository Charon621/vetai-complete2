/* ═══════════════════════════════════════════
   Profile Page — VetAI DS v5
   ═══════════════════════════════════════════ */

.profile-page {
  padding-bottom: calc(var(--sp-8) + env(safe-area-inset-bottom));
}

/* v3 二级页返回控件 */




/* 必填标记（BUG-UI36） */
.field-required {
  margin-left: 4rpx;
  color: var(--accent);
  font-weight: 600;
}

/* ── 页头 ────────────────────────────────── */
.profile-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-3);
  padding-bottom: var(--sp-4);
}

.profile-head-left { flex: 1; min-width: 0; }

/* 页内标题已删除：与原生导航标题「宠物档案」重复（BUG-UI51） */
.profile-desc {
  margin-top: 0;
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.55;
  max-width: 520rpx;
}
/* 热区 88rpx（BUG-UI5） */
.head-add-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: -4rpx;
}

.head-add-btn:active {
  opacity: 0.85;
  transform: scale(0.94);
}

/* 容器/标题复用全局 .vet-empty / .vet-empty-title */
.empty-panel { margin-top: var(--sp-2); }

.empty-desc {
  max-width: 520rpx;
  margin: var(--sp-2) auto var(--sp-4);
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.6;
}

.empty-add-btn {
  display: inline-flex;
  min-width: 320rpx;
}

/* ── 档案列表 ─────────────────────────────── */
.profile-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.pet-card {
  overflow: hidden;
  border-radius: var(--r-md);
  background: var(--card);
}

/* BUG-UI27：原先用 box-shadow 假描边，环色 --brand-light 在纸底上只有 1.13:1，
   实际看不见，还违反「卡片不描边」。当前档案已由勾选徽标 + 「当前使用」标签表达，
   这里只把卡片底色提到 surface 做一层很轻的区分。 */
.pet-card-active {
  background: var(--surface);
}

.pet-body {
  display: flex;
  gap: var(--sp-3);
  padding: var(--sp-4) var(--sp-4) var(--sp-3);
}

.pet-body:active { opacity: 0.9; }

.pet-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.pet-avatar-img,
.pet-avatar-placeholder {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
}

.pet-avatar-placeholder {
  background: var(--card);
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-size: var(--fs-hero);
  font-weight: 700;
}

.current-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand);
  border: 4rpx solid var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.current-badge-check {
  width: 24rpx;
  height: 24rpx;
}

.pet-info { flex: 1; min-width: 0; }

.pet-top {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

/* 名字允许两行，避免 20 字上限的名字被硬截断（BUG-UI28） */
.pet-name {
  min-width: 0;
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.34;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.current-tag {
  padding: 4rpx var(--sp-2);
  border-radius: var(--r-xs);
  background: var(--brand-light);
  color: var(--brand-dark);
  font-size: var(--fs-mini);
  font-weight: 600;
  flex-shrink: 0;
}

.pet-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
  margin-top: var(--sp-2);
}

/* 复用 .vet-chip 的尺寸语言：60rpx 高、8rpx 圆角、沙色底 */
.info-chip {
  max-width: 100%;
  padding: var(--sp-1) var(--sp-2);
  border-radius: var(--r-xs);
  background: var(--surface);
  color: var(--body);
  font-size: var(--fs-caption);
  box-sizing: border-box;
}

/* BUG-UI29：原先 padding 14/18rpx 且背景是 --bg，与所在奶白卡片只有 1.08:1，
   看不出边界；改用 --surface 并把间距归到栅格。 */
.last-row {
  margin-top: var(--sp-2);
  padding: var(--sp-1) var(--sp-2);
  border-radius: var(--r-sm);
  background: var(--surface);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

/* --muted 在 --surface 上只有 3.04:1，小字改 --body（BUG-UI4） */
.last-label {
  color: var(--body);
  font-size: var(--fs-mini);
}

.last-value {
  color: var(--body);
  font-size: var(--fs-caption);
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ── 操作区 ──────────────────────────────── */
.pet-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--sp-1);
  padding: 0 var(--sp-3) var(--sp-3);
}

/* 编辑 / 删除的热区抬到 88rpx（BUG-UI5） */
.pet-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  min-height: 88rpx;
  padding: 0 var(--sp-3);
  border-radius: var(--r-xs);
}

.pet-action:active { background: var(--surface); }

.action-text {
  font-size: var(--fs-caption);
  font-weight: 600;
}

.action-edit { color: var(--brand-dark); }
.action-delete { color: var(--sev-emergency); }

/* ── 添加档案卡片 ─────────────────────────── */
.add-profile-card {
  display: flex;
  gap: var(--sp-3);
  align-items: center;
  padding: var(--sp-4);
  border-radius: var(--r-md);
  background: var(--surface);
  box-sizing: border-box;
}

.add-profile-card:active { opacity: 0.85; }

.add-mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.add-copy { flex: 1; min-width: 0; }

.add-title {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-heading);
  font-weight: 700;
}

.add-desc {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.5;
}

/* ═══════════════════════════════════════════
   表单抽屉
   ═══════════════════════════════════════════ */

.form-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: var(--overlay);
}

/* BUG-UI30：高度不再写死 85vh，用 max-height 让内容少时抽屉自然收窄 */
.form-drawer {
  width: 100%;
  max-height: 85vh;
  padding: 0 var(--sp-4);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  background: var(--card);
  box-shadow: var(--shadow-lg);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  animation: slideUp var(--dur-slow) var(--ease-out) both;
  overflow: hidden;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

.drawer-handle {
  width: 72rpx;
  height: 8rpx;
  margin: var(--sp-3) auto var(--sp-2);
  border-radius: 4rpx;
  background: var(--surface-strong);
  flex-shrink: 0;
}

.form-header {
  display: flex;
  justify-content: space-between;
  gap: var(--sp-3);
  margin-bottom: var(--sp-3);
}

/* 关闭按钮热区 88rpx（BUG-UI5） */
.form-close {
  width: 88rpx;
  height: 88rpx;
  margin: -12rpx -12rpx 0 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  flex-shrink: 0;
}

.form-close:active { opacity: 0.7; }

.form-scroll {
  flex: 1;
  min-height: 0;
}

/* 头像上传区 */
.avatar-section {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin-bottom: var(--sp-3);
  padding: var(--sp-3);
  border-radius: var(--r-md);
  background: var(--surface);
}

.avatar-upload,
.avatar-img,
.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-upload { flex-shrink: 0; }

.avatar-placeholder {
  background: var(--card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.avatar-label {
  font-size: var(--fs-mini);
  color: var(--muted);
}

.avatar-hint {
  color: var(--muted);
  font-size: var(--fs-caption);
}

.avatar-remove {
  margin-top: var(--sp-1);
  color: var(--sev-emergency);
  font-size: var(--fs-caption);
  font-weight: 600;
}

/* 表单卡片 */
.form-card {
  margin-bottom: var(--sp-3);
  padding: var(--sp-4) var(--sp-3);
  border-radius: var(--r-md);
  background: var(--surface);
  box-sizing: border-box;
}

.form-section-title {
  margin-bottom: var(--sp-3);
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-heading);
  font-weight: 700;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
}

/* picker 也是输入框：右侧给下拉指示，未选时整行用次级色（BUG-UI31） */
.picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  color: var(--body);
}

.picker-display.is-empty { color: var(--muted); }

.picker-caret {
  width: 28rpx;
  height: 28rpx;
  flex: none;
}

/* BUG-UI32：WXSS 的 :focus 支持不可靠，且聚焦时把底色改成 --card 会让输入框
   边界消失。改由 bindfocus/bindblur 切 .is-focus，保持 surface 底 + 实色描边。 */
.vet-input.is-focus,
.vet-textarea.is-focus {
  background: var(--surface);
  box-shadow: 0 0 0 3rpx var(--brand);
}

/* 保存按钮禁用态（未填必填项时） */
.form-actions .vet-btn[disabled] {
  opacity: 0.45;
}

/* ── 底部按钮区 ──────────────────────────── */
.form-actions {
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: var(--sp-2);
  margin: var(--sp-3) calc(var(--sp-4) * -1) 0;
  padding: var(--sp-3) var(--sp-4) calc(var(--sp-3) + env(safe-area-inset-bottom));
  background: var(--card);
  box-shadow: var(--shadow-bar);
}
