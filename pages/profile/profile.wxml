<view class="vet-page profile-page">
  <!-- 页头：简洁专业。页内标题与原生导航标题重复，这里去掉一份（BUG-UI51） -->
  <view class="profile-head">
    <view class="profile-head-left">
      <view class="profile-desc">完善年龄、品种和过往情况，有助于生成更有参考价值的初筛报告。</view>
    </view>
    <view class="head-add-btn" wx:if="{{profiles.length > 0 && !showForm}}" bindtap="showCreateForm" aria-label="新建档案">
      <image class="vet-icon" src="/assets/icons/plus-bold-paper.svg" />
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{profiles.length === 0 && !showForm}}" class="vet-empty empty-panel vet-fade-up">
    <view class="vet-empty-icon">
      <image src="/assets/icons/cat-light-clay.svg" />
    </view>
    <view class="vet-empty-title">还没有宠物档案</view>
    <view class="empty-desc">通过对话式建档，AI 兽医助手会像真实医生一样逐步询问信息，建立更完整的宠物档案。</view>
    <button class="vet-btn vet-btn-primary empty-add-btn" bindtap="showCreateForm">开始对话建档</button>
  </view>

  <!-- 档案列表 -->
  <view class="profile-list" wx:if="{{profiles.length > 0}}">
    <view class="pet-card {{activeProfileId === item.id ? 'pet-card-active' : ''}} vet-fade-up" wx:for="{{profiles}}" wx:key="id">
      <view class="pet-body" bindtap="selectProfile" data-id="{{item.id}}">
        <view class="pet-avatar-wrap">
          <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" class="pet-avatar-img" />
          <view wx:else class="pet-avatar-placeholder">{{item.avatarText}}</view>
          <view class="current-badge" wx:if="{{activeProfileId === item.id}}">
            <image class="current-badge-check" src="/assets/icons/check-bold-paper.svg" />
          </view>
        </view>
        <view class="pet-info">
          <view class="pet-top">
            <view class="pet-name">{{item.petName}}</view>
            <view class="current-tag" wx:if="{{activeProfileId === item.id}}">当前使用</view>
          </view>
          <view class="pet-chips">
            <view class="info-chip" wx:if="{{item.petTypeLabel}}">{{item.petTypeLabel}}</view>
            <view class="info-chip" wx:if="{{item.ageLabel}}">{{item.ageLabel}}</view>
            <view class="info-chip" wx:if="{{item.genderLabel}}">{{item.genderLabel}}</view>
            <view class="info-chip" wx:if="{{item.breed}}">{{item.breed}}</view>
          </view>
          <view class="last-row">
            <text class="last-label">最近一次问诊</text>
            <text class="last-value">{{item.lastRecordText || '暂无记录'}}</text>
          </view>
        </view>
      </view>
      <view class="pet-actions">
        <view class="pet-action action-edit" catchtap="showEditForm" data-id="{{item.id}}" aria-label="编辑档案">
          <image class="vet-icon-sm" src="/assets/icons/pencil-simple-light-clay.svg" />
          <text class="action-text">编辑</text>
        </view>
        <view class="pet-action action-delete" catchtap="deleteProfile" data-id="{{item.id}}" aria-label="删除档案">
          <image class="vet-icon-sm" src="/assets/icons/trash-light-rust.svg" />
          <text class="action-text">删除</text>
        </view>
      </view>
    </view>

    <!-- 添加档案卡片 -->
    <view class="add-profile-card vet-fade-up" bindtap="showCreateForm" aria-label="对话式建档">
      <view class="add-mark">
        <image class="vet-icon" src="/assets/icons/plus-light-clay.svg" />
      </view>
      <view class="add-copy">
        <view class="add-title">对话式建档</view>
        <view class="add-desc">AI 兽医助手会逐步询问信息，帮你建立完整档案</view>
      </view>
    </view>
  </view>

  <!-- 表单抽屉（只用于编辑已有档案；新建走对话建档，BUG-UI33） -->
  <view class="form-overlay" wx:if="{{showForm}}" catchtap="onDrawerMaskTap">
    <view class="form-drawer" catchtap="noop">
      <view class="drawer-handle"></view>
      <view class="form-header">
        <view>
          <view class="vet-title-lg">编辑档案</view>
          <view class="vet-caption">基础信息会用于生成初筛报告</view>
        </view>
        <view class="form-close" bindtap="onDrawerClose" aria-label="关闭">
          <image class="vet-icon" src="/assets/icons/x-light-body.svg" />
        </view>
      </view>

      <scroll-view class="form-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="avatar-section">
          <view class="avatar-upload" bindtap="chooseAvatar" aria-label="添加头像">
            <image wx:if="{{form.avatar}}" src="{{form.avatar}}" mode="aspectFill" class="avatar-img" />
            <view wx:else class="avatar-placeholder">
              <image class="vet-icon" src="/assets/icons/plus-light-mute.svg" />
              <text class="avatar-label">添加头像</text>
            </view>
          </view>
          <view class="avatar-hint">
            <view>头像可选</view>
            <view wx:if="{{form.avatar}}" class="avatar-remove" catchtap="removeAvatar">移除头像</view>
          </view>
        </view>

        <view class="form-card">
          <view class="form-section-title">基础信息</view>
          <view class="vet-field">
            <text class="vet-field-label">名字<text class="field-required">*</text></text>
            <input class="vet-input {{focusKey === 'petName' ? 'is-focus' : ''}}" value="{{form.petName}}" maxlength="20"
              placeholder="例如：糯米" bindinput="onInput" data-key="petName"
              bindfocus="onFieldFocus" bindblur="onFieldBlur" cursor-spacing="24" adjust-position />
          </view>
          <view class="vet-field">
            <view class="vet-field-label">种类<text class="field-required">*</text></view>
            <view class="chip-row">
              <view class="vet-chip {{form.petType === item.value ? 'vet-chip-active' : ''}}"
                wx:for="{{petTypeOptions}}" wx:key="value"
                bindtap="onPetTypeTap" data-index="{{index}}">{{item.label}}</view>
            </view>
          </view>
          <view class="vet-field">
            <text class="vet-field-label">品种</text>
            <input class="vet-input {{focusKey === 'breed' ? 'is-focus' : ''}}" value="{{form.breed}}" maxlength="20"
              placeholder="可选" bindinput="onInput" data-key="breed"
              bindfocus="onFieldFocus" bindblur="onFieldBlur" cursor-spacing="24" adjust-position />
          </view>
          <view class="vet-field">
            <view class="vet-field-label">性别<text class="field-required">*</text></view>
            <view class="chip-row">
              <view class="vet-chip {{form.gender === item.value ? 'vet-chip-active' : ''}}"
                wx:for="{{genderOptions}}" wx:key="value"
                bindtap="onGenderTap" data-index="{{index}}">{{item.label}}</view>
            </view>
          </view>
          <view class="vet-field">
            <view class="vet-field-label">年龄<text class="field-required">*</text></view>
            <view class="chip-row">
              <view class="vet-chip {{form.age === item.value ? 'vet-chip-active' : ''}}"
                wx:for="{{ageOptions}}" wx:key="value"
                bindtap="onAgeTap" data-index="{{index}}">{{item.label}}</view>
            </view>
          </view>
        </view>

        <view class="form-card">
          <view class="form-section-title">健康信息</view>
          <view class="vet-field">
            <text class="vet-field-label">体重 (kg)</text>
            <input class="vet-input {{focusKey === 'weight' ? 'is-focus' : ''}}" type="digit" value="{{form.weight}}"
              maxlength="6" placeholder="可选" bindinput="onInput" data-key="weight"
              bindfocus="onFieldFocus" bindblur="onFieldBlur" cursor-spacing="24" adjust-position />
          </view>
          <view class="vet-field">
            <text class="vet-field-label">绝育情况</text>
            <picker bindchange="onSterilizedChange" range="{{sterilizedOptions}}" range-key="label">
              <view class="vet-input picker-display {{form.sterilizedLabel ? '' : 'is-empty'}}">
                <text>{{form.sterilizedLabel || '请选择'}}</text>
                <image class="picker-caret" src="/assets/icons/caret-down-light-mute.svg" />
              </view>
            </picker>
          </view>
          <view class="vet-field">
            <text class="vet-field-label">过敏史</text>
            <input class="vet-input {{focusKey === 'allergy' ? 'is-focus' : ''}}" value="{{form.allergy}}"
              maxlength="100" placeholder="如：对某药物过敏" bindinput="onInput" data-key="allergy"
              bindfocus="onFieldFocus" bindblur="onFieldBlur" cursor-spacing="24" adjust-position />
          </view>
          <view class="vet-field">
            <text class="vet-field-label">既往病史</text>
            <!-- BUG-UI34：键盘弹起时给 textarea 留出空间，避免被底部按钮区盖住 -->
            <textarea class="vet-textarea {{focusKey === 'medicalHistory' ? 'is-focus' : ''}}"
              value="{{form.medicalHistory}}" maxlength="300" placeholder="反复耳炎、真菌感染、正在用药等"
              bindinput="onInput" data-key="medicalHistory"
              bindfocus="onFieldFocus" bindblur="onFieldBlur"
              cursor-spacing="120" adjust-position="{{true}}" />
          </view>
        </view>
      </scroll-view>

      <view class="form-actions">
        <button class="vet-btn vet-btn-ghost" bindtap="onDrawerClose">取消</button>
        <button class="vet-btn vet-btn-primary" bindtap="saveProfile" disabled="{{!formValid}}">保存修改</button>
      </view>
    </view>
  </view>
</view>
