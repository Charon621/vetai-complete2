/* ═══════════════════════════════════════════════════════
   Detail Page — VetAI DS v7「暖阳 · 衬线」
   健康档案 / 宠物切换 / 时间轴
   不画分割线：记录用奶白卡片分隔
   ═══════════════════════════════════════════════════════ */

/* BUG-UI2：底部留白只认 --tab-bar-h，不再用 120rpx 魔数 */
.history-page {
  position: relative;
  padding-bottom: calc(var(--sp-6) + var(--tab-bar-h) + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #F1E8DB 0, var(--bg) 520rpx);
}

/* 页顶延续首页的猫狗合影；遮罩把标题区和内容区留在纸色上。 */
.archive-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 370rpx;
  overflow: hidden;
  pointer-events: none;
}

.archive-cover-photo {
  width: 100%;
  height: 100%;
  opacity: 0.42;
  filter: sepia(0.24) saturate(0.72);
  pointer-events: none;
}

.archive-cover-side,
.archive-cover-fade {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.archive-cover-side {
  background: linear-gradient(90deg, rgba(247, 243, 234, 0.8), rgba(247, 243, 234, 0.12) 82%);
}

.archive-cover-fade {
  background: linear-gradient(180deg, rgba(247, 243, 234, 0.06) 12%, rgba(247, 243, 234, 0.28) 52%, var(--bg) 100%);
}

.archive-content {
  position: relative;
  z-index: 1;
}

/* ── 页头 ── */
.archive-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 210rpx;
  padding-bottom: var(--sp-2);
  box-sizing: border-box;
}

.archive-heading {
  min-width: 0;
}

.archive-title-lg {
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: 800;
  color: var(--text);
}

.archive-subtitle {
  margin-top: var(--sp-1);
  color: var(--body);
  font-size: var(--fs-caption);
  line-height: 1.45;
}

.archive-head-actions {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}







.archive-search-toggle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-sizing: border-box;
  box-shadow: var(--shadow-card);
  transition: transform 220ms ease, background 220ms ease, box-shadow 220ms ease;
}

.archive-search-toggle.is-open {
  background: var(--surface);
  box-shadow: none;
}

.archive-search-toggle .vet-icon { transition: transform 280ms ease; }
.archive-search-toggle.is-open .vet-icon { transform: scale(1.14) rotate(-8deg); }

.archive-search-toggle:active { transform: scale(0.94); }

/* ── 搜索栏 ── */
.search-bar {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  height: 0;
  margin-top: 0;
  padding: 0 var(--sp-3);
  border-radius: var(--r-sm);
  background: var(--card);
  border: 1rpx solid transparent;
  box-sizing: border-box;
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  transform: translate(28rpx, -12rpx) scale(0.92);
  transform-origin: right top;
  transition: height 300ms ease, margin-top 300ms ease, opacity 240ms ease, transform 300ms cubic-bezier(0.18, 0.82, 0.22, 1), visibility 0s linear 300ms;
}

.search-bar.is-open {
  height: 88rpx;
  margin-top: var(--sp-3);
  border-color: transparent;
  box-shadow: var(--shadow-card);
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
  transition: height 300ms ease, margin-top 300ms ease, opacity 240ms ease, transform 300ms cubic-bezier(0.18, 0.82, 0.22, 1);
}

@media (prefers-reduced-motion: reduce) {
  .archive-search-toggle, .archive-search-toggle .vet-icon, .search-bar { transition-duration: 0ms; }
}

@media (prefers-color-scheme: dark) {
  .history-page {
    background: linear-gradient(180deg, #252019 0, var(--bg) 520rpx);
  }
  .archive-cover-photo { opacity: 0.22; }
  .archive-cover-side {
    background: linear-gradient(90deg, rgba(28, 25, 21, 0.88), rgba(28, 25, 21, 0.24) 82%);
  }
  .archive-cover-fade {
    background: linear-gradient(180deg, rgba(28, 25, 21, 0.1) 12%, rgba(28, 25, 21, 0.4) 52%, var(--bg) 100%);
  }


}

.search-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  color: var(--text);
  font-size: var(--fs-body);
}

.search-placeholder { color: var(--muted); }

/* 视觉 44rpx 圆，热区靠 ::before 撑到 88rpx（BUG-UI5） */
.search-clear {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-clear::before {
  content: "";
  position: absolute;
  top: -22rpx;
  right: -22rpx;
  bottom: -22rpx;
  left: -22rpx;
}

/* 搜索栏收起但筛选仍生效时的常驻提示（BUG-UI50） */
.filter-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  min-height: 72rpx;
  margin-top: var(--sp-2);
  padding: 0 var(--sp-3);
  border-radius: var(--r-sm);
  background: var(--ochre-soft);
}

.filter-hint-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ochre-text);
  font-size: var(--fs-caption);
}

/* 纯文字操作：伪元素扩热区，不动盒模型（BUG-UI5b） */
.filter-hint-clear {
  position: relative;
  flex: none;
  color: var(--ochre-text);
  font-size: var(--fs-caption);
  font-weight: 600;
}

.filter-hint-clear::after {
  content: "";
  position: absolute;
  top: -22rpx;
  right: -16rpx;
  bottom: -22rpx;
  left: -16rpx;
}

/* ── 宠物切换：胶囊圆角改小圆角，与全站 chip 语言一致（BUG-UI11） ── */
.pet-switch {
  margin-top: var(--sp-4);
  white-space: nowrap;
}

.pet-switch-row {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  padding-right: var(--sp-3);
}

.pet-chip-sw {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  /* 整片 80rpx 高、横向远大于 88rpx，满足点按需求 */
  padding: var(--sp-1) var(--sp-3) var(--sp-1) var(--sp-1);
  border-radius: var(--r-sm);
  background: var(--card);
  flex-shrink: 0;
}

.pet-chip-sw.on {
  background: var(--ink);
  color: var(--on-ink);
}

/* 64rpx 头像 + 8rpx 内边距 + 两行文字 ≈ 80rpx 高的整片热区（横向远大于 88rpx） */
.pet-chip-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-size: var(--fs-caption);
  font-weight: 700;
  flex-shrink: 0;
  overflow: hidden;
}
.pet-chip-avatar-img { display: block; width: 100%; height: 100%; }

.pet-chip-sw.on .pet-chip-avatar {
  background: var(--brand);
  color: var(--on-brand);
}

.pet-chip-info { min-width: 0; }

.pet-chip-name {
  font-family: var(--font-serif);
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--text);
  line-height: 1.25;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-chip-meta {
  font-size: var(--fs-mini);
  color: var(--muted);
  line-height: 1.3;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 选中态下不再用纸色常量半透明（原 rgba(247,243,234,.65) 只有约 3:1，BUG-UI4） */
.pet-chip-sw.on .pet-chip-name { color: var(--on-ink); }
.pet-chip-sw.on .pet-chip-meta { color: var(--on-ink); opacity: 0.82; }

.pet-chip-add {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pet-chip-add:active { opacity: 0.8; }

/* ── 统计行：沙色底，不画线 ── */
.stat-line {
  margin-top: var(--sp-4);
  display: flex;
  align-items: baseline;
  gap: var(--sp-4);
  padding: var(--sp-3);
  border-radius: var(--r-md);
  background: var(--surface-sunk);
  font-size: var(--fs-caption);
  color: var(--body);
}

.stat-line-num {
  margin-right: var(--sp-1);
  font-family: var(--font-serif);
  font-size: var(--fs-hero);
  font-weight: 700;
  color: var(--text);
}

.stat-line-num.attention { color: var(--sev-urgent); }

/* 纯文字操作：伪元素扩热区，不动盒模型（BUG-UI5b：负 margin 会把基线拉偏） */
.stat-line-edit {
  position: relative;
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: var(--sp-1);
  color: var(--brand-dark);
  font-weight: 600;
}

.stat-line-edit::after {
  content: "";
  position: absolute;
  top: -20rpx;
  right: -12rpx;
  bottom: -20rpx;
  left: -12rpx;
}

/* ── 空状态：直接说明下一步，不使用装饰图标 ── */
.empty-panel {
  margin-top: var(--sp-4);
  padding: var(--sp-5) var(--sp-4);
  text-align: left;
  box-shadow: var(--shadow-card);
}

.empty-panel .vet-empty-title { font-size: var(--fs-heading); }

.empty-desc {
  max-width: 560rpx;
  margin: var(--sp-2) 0 var(--sp-4);
  color: var(--body);
  font-size: var(--fs-caption);
  line-height: 1.55;
}

.empty-panel .vet-btn {
  display: inline-flex;
  min-width: 300rpx;
}

/* ── 记录列表：按月分组的卡片 ── */
.timeline { margin-top: var(--sp-2); }

/* BUG-UI12：月份标题原先缩进 4rpx，与卡片左缘、日期列中心都不同轴；归零缩进 */
.tl-month {
  margin: var(--sp-5) 0 var(--sp-2);
  color: var(--body);
  font-family: var(--font-serif);
  font-size: var(--fs-caption);
  font-weight: 700;
}

.tl-item {
  display: flex;
  /* BUG-UI13：原 align-items:center 让日期数字随内容行数上下漂移，改为顶端对齐 */
  align-items: flex-start;
  gap: var(--sp-3);
  margin-bottom: var(--sp-2);
  padding: var(--sp-3);
  border-radius: var(--r-md);
  background: var(--card);
  box-shadow: var(--shadow-card);
  transition: transform var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
}

.tl-item:active {
  transform: translateY(2rpx);
  box-shadow: var(--shadow-card-press);
}

.tl-date {
  width: 56rpx;
  flex-shrink: 0;
  text-align: center;
  padding-top: 6rpx;
}

.tl-day {
  font-family: var(--font-serif);
  font-size: var(--fs-hero);
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.tl-body { flex: 1; min-width: 0; }

.tl-disease {
  font-family: var(--font-serif);
  font-size: var(--fs-heading);
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tl-meta {
  margin-top: 4rpx;
  font-size: var(--fs-mini);
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tl-status-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-1);
}

.tl-status-row .vet-status { font-size: var(--fs-mini); }

.tl-trend {
  font-size: var(--fs-mini);
  color: var(--muted);
}

.tl-trend-improved { color: var(--sev-low); }
.tl-trend-worsened { color: var(--sev-urgent); }

.tl-thumb {
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--r-sm);
  flex-shrink: 0;
  background: var(--surface);
}

/* 视觉 28rpx 图标，热区 88rpx：破坏性按钮又小又贴着整卡可点区，
   放宽命中区反而更容易误触，这里保持视觉紧凑但补足高度与右侧间距（BUG-UI5） */




/* ── 加载更多 ── */
.load-more { padding: var(--sp-2) 0; }

.load-more-inner {
  padding: var(--sp-3);
  text-align: center;
  border-radius: var(--r-md);
  background: var(--surface);
  color: var(--body);
  font-size: var(--fs-caption);
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.load-more-inner:active { opacity: 0.8; }

@media (prefers-color-scheme: dark) {
  .stat-line { background: var(--surface-strong); }
}

@media (prefers-reduced-motion: reduce) {
  .tl-item { transition-duration: 0ms; }
}
