/* ========================================
   Detail Page — v2 品质重设计
   温暖专业 · 去 AI 感 · 排版优先
   ======================================== */

.history-page {
  padding-bottom: calc(var(--sp-8) + env(safe-area-inset-bottom));
}

/* ---- Page Header ---- */
.archive-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--sp-3);
  padding: var(--sp-1) 0 var(--sp-3);
}

.head-left {
  flex: 1;
  min-width: 0;
}

.archive-eyebrow {
  color: var(--brand);
  font-size: var(--fs-mini);
  font-weight: 600;
  letter-spacing: 2rpx;
  opacity: 0.6;
}

.archive-title {
  margin-top: var(--sp-1);
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: 700;
  line-height: 1.22;
}

.archive-desc {
  margin-top: var(--sp-1);
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.5;
}

.archive-month {
  width: 108rpx;
  min-height: 108rpx;
  border-radius: var(--r-lg);
  background: var(--card);
  border: 1rpx solid var(--line);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.archive-month text:first-child {
  color: var(--brand);
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.1;
}

.archive-month text:last-child {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: var(--fs-mini);
  font-weight: 500;
}

/* ---- Search Bar ---- */
.search-bar {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-height: 80rpx;
  padding: 0 var(--sp-3);
  border-radius: var(--r-md);
  background: var(--card);
  border: 1rpx solid var(--line);
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.search-bar:focus-within {
  border-color: var(--brand);
  box-shadow: none;
}

.search-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon-circle {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid var(--muted);
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 0;
}

.search-icon-line {
  width: 10rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: var(--muted);
  position: absolute;
  right: 0;
  bottom: 4rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  color: var(--text);
  font-size: var(--fs-body);
}

.search-placeholder {
  color: var(--faint);
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.clear-icon {
  color: var(--muted);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1;
}

/* ---- Stats Bar ---- */
.archive-stats {
  display: flex;
  align-items: stretch;
  margin-top: var(--sp-3);
  border-radius: var(--r-md);
  background: var(--card);
  border: 1rpx solid var(--line-light);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.stat-cell {
  flex: 1;
  min-width: 0;
  padding: var(--sp-3) var(--sp-2);
  text-align: center;
}

.stat-divider {
  flex: 0;
  width: 1rpx;
  padding: 0;
  background: var(--line-light);
}

.stat-value {
  color: var(--brand);
  font-family: var(--font-mono);
  font-size: var(--fs-display);
  font-weight: 700;
  line-height: 1.1;
}

.stat-cell.attention .stat-value {
  color: var(--sev-urgent);
}

.stat-value.recent {
  font-size: var(--fs-title);
}

.stat-name {
  margin-top: var(--sp-1);
  color: var(--muted);
  font-size: var(--fs-mini);
  font-weight: 500;
}

/* ---- Sort Toolbar ---- */
.archive-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin: var(--sp-4) 0 var(--sp-2);
}

.toolbar-title {
  color: var(--body);
  font-size: 25rpx;
  font-weight: 650;
}

.sort-tabs {
  display: flex;
  padding: 4rpx;
  border-radius: var(--r-sm);
  background: var(--surface);
  border: 1rpx solid var(--line-light);
}

.sort-tab {
  min-width: 88rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--r-sm);
  text-align: center;
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--muted);
  box-sizing: border-box;
  transition: all 0.2s;
}

.sort-tab text {
  position: relative;
  z-index: 1;
}

.sort-tab-on {
  background: var(--card);
  color: var(--text);
  box-shadow: var(--shadow-sm);
}

/* ---- Empty State ---- */
.empty-panel {
  margin-top: var(--sp-4);
  padding: var(--sp-8) var(--sp-4);
  border-radius: var(--r-lg);
  background: var(--card);
  border: 1rpx solid var(--line-light);
  box-shadow: var(--shadow-sm);
  text-align: center;
}

.empty-icon-wrap {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto var(--sp-3);
  border-radius: 50%;
  background: var(--brand-light);
  color: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── 空状态插画：病历夹 ── */
.illus-clip {
  position: relative;
  width: 54rpx;
  height: 64rpx;
  background: var(--brand-light);
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.illus-clip-notch {
  position: absolute;
  left: 50%;
  top: -9rpx;
  width: 22rpx;
  height: 13rpx;
  transform: translateX(-50%);
  background: var(--brand-light);
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
}

.illus-clip-pulse {
  position: absolute;
  left: 9rpx;
  top: 50%;
  width: 30rpx;
  height: 3rpx;
  margin-top: -2rpx;
  background: currentColor;
  border-radius: 2rpx;
}

.illus-clip-pulse::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: -8rpx;
  width: 3rpx;
  height: 11rpx;
  background: currentColor;
  border-radius: 2rpx;
  transform: rotate(28deg);
}

.illus-clip-pulse::after {
  content: "";
  position: absolute;
  left: 15rpx;
  top: -2rpx;
  width: 3rpx;
  height: 11rpx;
  background: currentColor;
  border-radius: 2rpx;
  transform: rotate(-28deg);
}

/* Search empty icon */
.empty-icon-search {
  position: relative;
  width: 60rpx;
  height: 60rpx;
}

.search-empty-circle {
  position: absolute;
  top: 0;
  left: 2rpx;
  width: 36rpx;
  height: 36rpx;
  border: 5rpx solid var(--brand);
  border-radius: 50%;
  opacity: 0.4;
}

.search-empty-dash {
  position: absolute;
  left: 9rpx;
  top: 17rpx;
  width: 22rpx;
  height: 5rpx;
  border-radius: 5rpx;
  background: var(--brand);
  opacity: 0.4;
}

.search-empty-line {
  position: absolute;
  bottom: 6rpx;
  right: 0;
  width: 24rpx;
  height: 5rpx;
  border-radius: 5rpx;
  background: var(--brand);
  transform: rotate(45deg);
  opacity: 0.4;
}

.empty-title {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: 31rpx;
  font-weight: 700;
}

.empty-desc {
  max-width: 520rpx;
  margin: var(--sp-2) auto var(--sp-4);
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.55;
}

/* ---- Case List ---- */
.case-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

/* ---- Case Card ---- */
.case-card {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: var(--sp-2);
  min-height: 160rpx;
  padding: var(--sp-3) var(--sp-6) var(--sp-3) 0;
  border-radius: var(--r-md);
  background: var(--card);
  border: 1rpx solid var(--line-light);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  box-sizing: border-box;
  transition: box-shadow 0.15s;
}

.case-card:active {
  box-shadow: var(--shadow-md);
}

/* Severity is communicated through the card tint and text, without decorative color rails. */
.sev-low { background: var(--sev-low-bg) !important; }
.sev-moderate { background: var(--sev-mid-bg) !important; }
.sev-urgent { background: var(--sev-urgent-bg) !important; }
.sev-emergency { background: var(--sev-emergency-bg) !important; }

/* Keep old class-based severity for backward compat */
.sev-low::before { background: transparent; }
.sev-urgent::before { background: transparent; }
.sev-emergency::before { background: transparent; }

.case-card::before {
  display: none;
}

/* ---- Date Column ---- */
.case-date {
  width: 112rpx;
  padding-left: var(--sp-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.date-tag {
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-main {
  min-width: 72rpx;
  padding: var(--sp-1) var(--sp-2);
  border-radius: var(--r-sm);
  background: var(--surface);
  color: var(--text);
  text-align: center;
  font-size: var(--fs-caption);
  font-weight: 700;
}

.date-line {
  flex: 1;
  width: 2rpx;
  margin-top: var(--sp-2);
  background: linear-gradient(to bottom, var(--line), transparent);
}

/* ---- Content Area ---- */
.case-content {
  flex: 1;
  min-width: 0;
}

.case-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}

.pet-name {
  min-width: 0;
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---- Confidence Pill ---- */
.confidence-pill {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  min-width: 96rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--r-sm);
  background: var(--surface);
  flex-shrink: 0;
}

.confidence-bar {
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--line-light);
  overflow: hidden;
}

.confidence-fill {
  height: 100%;
  border-radius: 3rpx;
  background: var(--brand);
}

.confidence-text {
  color: var(--muted);
  font-size: var(--fs-mini);
  font-weight: 600;
}

/* ---- Disease Name ---- */
.disease-name {
  margin-top: 6rpx;
  color: var(--text);
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.34;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ---- Meta ---- */
.case-meta {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
}

.meta-tag {
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: var(--r-sm);
  background: var(--surface);
  color: var(--body);
  font-size: var(--fs-mini);
  font-weight: 500;
}

.meta-urgency {
  color: var(--muted);
  font-size: var(--fs-mini);
  font-weight: 500;
}

/* ---- Trend Tag ---- */
.meta-trend {
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: var(--r-sm);
  font-size: var(--fs-mini);
  font-weight: 600;
}

.trend-improved {
  background: rgba(99, 166, 124, 0.14);
  color: #4E8563;
}

.trend-worsened {
  background: rgba(217, 107, 94, 0.14);
  color: #B25444;
}

.trend-same {
  background: var(--surface);
  color: var(--muted);
}

/* ---- Summary ---- */
.case-summary {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

/* ---- Thumbnail ---- */
.case-thumb {
  width: 96rpx;
  height: 96rpx;
  margin: 4rpx 0;
  border-radius: var(--r-md);
  background: var(--surface);
  flex-shrink: 0;
}

/* ---- Arrow ---- */
.case-arrow {
  position: absolute;
  right: var(--sp-3);
  top: 50%;
  transform: translateY(-50%);
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-chevron {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--faint);
  border-right: 3rpx solid var(--faint);
  transform: rotate(45deg);
}

/* ---- Load More ---- */
.load-more {
  padding: var(--sp-2) 0;
}

.load-more-inner {
  padding: var(--sp-3);
  text-align: center;
  border-radius: var(--r-md);
  border: 1rpx solid var(--line);
  background: transparent;
  color: var(--body);
  font-size: var(--fs-body);
  font-weight: 600;
}

.load-more-inner:active {
  background: var(--surface);
}

/* ---- Clear Section ---- */
.clear-section {
  padding: var(--sp-3) 0 var(--sp-1);
}

.clear-section .vet-btn {
  width: 100%;
}

/* ---- Dark Mode Overrides ---- */
@media (prefers-color-scheme: dark) {
  .trend-improved {
    background: rgba(124, 184, 148, 0.18);
    color: #8FC7A6;
  }

  .trend-worsened {
    background: rgba(222, 131, 119, 0.18);
    color: #E39A90;
  }

  .trend-same {
    background: var(--surface);
    color: var(--muted);
  }
}
