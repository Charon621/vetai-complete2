/* ═══════════════════════════════════════════════════════
   Detail Page — VetAI DS v5
   健康档案 / 宠物切换 / 时间轴
   ═══════════════════════════════════════════════════════ */

.history-page {
  padding-bottom: calc(var(--sp-8) + env(safe-area-inset-bottom));
}

/* ── 页头 ── */
.archive-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.archive-title-lg {
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: 900;
  color: var(--text);
}

.archive-eyebrow {
  margin-left: auto;
  margin-right: var(--sp-2);
  color: var(--gold);
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  font-weight: 600;
  letter-spacing: 4rpx;
}

.archive-head-actions {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.archive-clear-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--sp-2);
  height: 64rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--accent-line);
  background: var(--accent-mist);
  flex-shrink: 0;
  box-sizing: border-box;
}

.archive-clear-btn:active { opacity: 0.7; }

.archive-clear-text {
  font-size: var(--fs-mini);
  font-weight: 600;
  color: var(--accent);
}

.archive-search-toggle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--card);
  border: 1rpx solid var(--line);
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
}

.archive-search-toggle:active { opacity: 0.85; }

/* ── 搜索栏 ── */
.search-bar {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-height: 80rpx;
  padding: 0 var(--sp-3);
  border-radius: var(--r-md);
  background: var(--card);
  border: 1rpx solid var(--line);
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.search-bar:focus-within {
  border-color: var(--brand);
  box-shadow: none;
}

/* 搜索图标用全局 .vic-search，此处仅给颜色 */
.search-bar-icon {
  color: var(--muted);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  color: var(--text);
  font-size: var(--fs-body);
}

.search-placeholder {
  color: var(--faint);
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.clear-icon {
  color: var(--muted);
  transform: scale(0.6); /* 全局 28rpx 叉号在 40rpx 小钮内光学缩小 */
}

/* ── 宠物切换行 ── */
.pet-switch {
  margin-top: var(--sp-4);
  white-space: nowrap;
}

.pet-switch-row {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  padding-right: var(--sp-3);
}

.pet-chip-sw {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  padding: 8rpx 20rpx 8rpx 8rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  flex-shrink: 0;
}

.pet-chip-sw.on {
  background: var(--brand);
  border-color: var(--brand);
}

.pet-chip-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--surface);
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.pet-chip-sw.on .pet-chip-avatar {
  background: var(--card);
  color: var(--text);
}

.pet-chip-name {
  font-size: var(--fs-caption);
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
}

.pet-chip-meta {
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1.3;
}

.pet-chip-sw.on .pet-chip-name { color: var(--on-brand); }
.pet-chip-sw.on .pet-chip-meta { color: var(--on-brand-muted); font-family: var(--font-mono); }

.pet-chip-add {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 1rpx dashed var(--faint);
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ── 统计一行细线 ── */
.stat-line {
  margin-top: var(--sp-4);
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-2) 0;
  border-top: 4rpx solid var(--text);
  border-bottom: 1rpx solid var(--line);
  font-size: var(--fs-caption);
  color: var(--body);
}

.stat-line-num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.stat-line-num.attention { color: var(--sev-urgent); }

.stat-line-edit {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: var(--sp-1);
  color: var(--brand);
  font-weight: 700;
  border-bottom: 2rpx solid var(--lime);
  padding-bottom: 2rpx;
}

.stat-line-arrow {
  transform: scale(0.7) rotate(45deg); /* 全局箭头在行内光学缩小 */
}

/* ── 空状态（容器/标题复用全局 .vet-empty / .vet-empty-title） ── */
.empty-panel {
  margin-top: var(--sp-4);
}

.empty-icon-wrap {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto var(--sp-3);
  border-radius: 50%;
  background: var(--brand-light);
  color: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 空状态插画：病历夹 */
.illus-clip {
  position: relative;
  width: 54rpx;
  height: 64rpx;
  background: var(--brand-light);
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.illus-clip-notch {
  position: absolute;
  left: 50%;
  top: -9rpx;
  width: 22rpx;
  height: 13rpx;
  transform: translateX(-50%);
  background: var(--brand-light);
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
}

.illus-clip-pulse {
  position: absolute;
  left: 9rpx;
  top: 50%;
  width: 30rpx;
  height: 3rpx;
  margin-top: -2rpx;
  background: currentColor;
  border-radius: 2rpx;
}

.illus-clip-pulse::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: -8rpx;
  width: 3rpx;
  height: 11rpx;
  background: currentColor;
  border-radius: 2rpx;
  transform: rotate(28deg);
}

.illus-clip-pulse::after {
  content: "";
  position: absolute;
  left: 15rpx;
  top: -2rpx;
  width: 3rpx;
  height: 11rpx;
  background: currentColor;
  border-radius: 2rpx;
  transform: rotate(-28deg);
}

/* 搜索无结果插画 */
.empty-icon-search {
  position: relative;
  width: 60rpx;
  height: 60rpx;
}

.search-empty-circle {
  position: absolute;
  top: 0;
  left: 2rpx;
  width: 36rpx;
  height: 36rpx;
  border: 5rpx solid var(--brand);
  border-radius: 50%;
  opacity: 0.4;
}

.search-empty-dash {
  position: absolute;
  left: 9rpx;
  top: 17rpx;
  width: 22rpx;
  height: 5rpx;
  border-radius: 5rpx;
  background: var(--brand);
  opacity: 0.4;
}

.search-empty-line {
  position: absolute;
  bottom: 6rpx;
  right: 0;
  width: 24rpx;
  height: 5rpx;
  border-radius: 5rpx;
  background: var(--brand);
  transform: rotate(45deg);
  opacity: 0.4;
}

.empty-desc {
  max-width: 520rpx;
  margin: var(--sp-2) auto var(--sp-4);
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.55;
}

/* ── 时间轴 ── */
.timeline { margin-top: var(--sp-4); }

.tl-month {
  margin-top: var(--sp-4);
  color: var(--gold);
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  font-weight: 600;
  letter-spacing: 4rpx;
}

.tl-item {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line);
}

.tl-item:active { opacity: 0.75; }

.tl-del {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  flex-shrink: 0;
  box-sizing: border-box;
}

.tl-del:active {
  background: var(--brand-light);
}

.tl-del-icon {
  color: var(--ghost);
  transform: scale(0.75); /* 全局 28rpx 叉号在 52rpx 删除钮内光学缩小 */
}

.tl-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 56rpx;
  flex-shrink: 0;
}

.tl-day {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.tl-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  background: var(--sev-mid);
}

.tl-dot.sev-low { background: var(--sev-low); }
.tl-dot.sev-moderate { background: var(--sev-mid); }
.tl-dot.sev-urgent { background: var(--sev-urgent); }
.tl-dot.sev-emergency { background: var(--sev-emergency); }

.tl-body { flex: 1; min-width: 0; }

.tl-disease {
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 900;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tl-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* 状态文字：仅着色，不再被全局 sev-* 规则误加底色块 */
.tl-status {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted);
}

.tl-status.sev-low { color: var(--sev-low); }
.tl-status.sev-moderate { color: var(--sev-mid-text); }
.tl-status.sev-urgent { color: var(--sev-urgent); }
.tl-status.sev-emergency { color: var(--sev-emergency); }

.tl-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r-sm);
  flex-shrink: 0;
  background: var(--surface);
}

.tl-thumb-empty {
  border: 1rpx solid var(--line);
}

/* ── 加载更多 ── */
.load-more {
  padding: var(--sp-2) 0;
}

.load-more-inner {
  padding: var(--sp-3);
  text-align: center;
  border-radius: var(--r-md);
  border: 1rpx solid var(--line);
  background: transparent;
  color: var(--body);
  font-size: var(--fs-body);
  font-weight: 600;
}

.load-more-inner:active {
  background: var(--surface);
}
