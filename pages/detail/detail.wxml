<view class="vet-page history-page">
  <view class="archive-cover" aria-hidden="true">
    <image class="archive-cover-photo" src="/assets/home-pets.jpg" mode="aspectFill" />
    <view class="archive-cover-side"></view>
    <view class="archive-cover-fade"></view>
  </view>
  <view class="archive-content">
  <!-- 页头 -->
  <view class="archive-head vet-fade-up">
    <view class="archive-heading">
      <view class="archive-title-lg">健康档案</view>
      <view class="archive-subtitle">检查记录与宠物资料，长按记录可删除</view>
    </view>
    <view class="archive-head-actions">
      <view class="archive-search-toggle {{searchOpen ? 'is-open' : ''}}" bindtap="toggleSearch" aria-label="{{searchOpen ? '关闭搜索' : '搜索记录'}}">
        <image class="vet-icon" src="/assets/icons/magnifying-glass-light-body.svg" />
      </view>
    </view>
  </view>

  <!-- 搜索栏（点开展开） -->
  <view class="search-bar {{searchOpen ? 'is-open' : ''}}" aria-hidden="{{!searchOpen}}">
    <image class="vet-icon" src="/assets/icons/magnifying-glass-light-clay.svg" />
    <input class="search-input" placeholder="搜索宠物名、部位或可能问题"
      placeholder-class="search-placeholder" focus="{{searchFocus}}" disabled="{{!searchOpen}}"
      value="{{searchText}}" bindinput="onSearchInput" bindfocus="onSearchFocus" confirm-type="search" />
    <view wx:if="{{searchText}}" class="search-clear" catchtap="onSearchClear" aria-label="清除搜索">
      <image class="vet-icon-sm" src="/assets/icons/x-light-body.svg" />
    </view>
  </view>

  <!-- 关闭搜索栏后仍处于筛选状态时的常驻提示（BUG-UI50 的兜底） -->
  <view class="filter-hint" wx:if="{{!searchOpen && searchText}}">
    <text class="filter-hint-text">筛选中：{{searchText}}</text>
    <view class="filter-hint-clear" bindtap="onSearchClear">清除</view>
  </view>

  <!-- 宠物切换行 -->
  <scroll-view class="pet-switch vet-fade-up vet-stagger-1" scroll-x wx:if="{{pets.length > 0}}" show-scrollbar="{{false}}">
    <view class="pet-switch-row">
      <view class="pet-chip-sw {{item.id === activeProfileId ? 'on' : ''}}" wx:for="{{pets}}" wx:key="id" data-id="{{item.id}}" bindtap="switchPet">
        <view class="pet-chip-avatar">
          <image wx:if="{{item.avatar}}" class="pet-chip-avatar-img" src="{{item.avatar}}" mode="aspectFill" />
          <block wx:else>{{item.initial}}</block>
        </view>
        <view class="pet-chip-info">
          <view class="pet-chip-name">{{item.petName}}</view>
          <view class="pet-chip-meta">{{item.meta}}</view>
        </view>
      </view>
      <view class="pet-chip-add" bindtap="goProfiles" aria-label="新增宠物档案">
        <image class="vet-icon" src="/assets/icons/plus-light-mute.svg" />
      </view>
    </view>
  </scroll-view>

  <!-- 档案概览 -->
  <view class="stat-line vet-fade-up vet-stagger-2" wx:if="{{records.length > 0}}">
    <text class="stat-line-item"><text class="stat-line-num text-numeric">{{records.length}}</text> 次检查</text>
    <text class="stat-line-item"><text class="stat-line-num text-numeric attention">{{attentionCount}}</text> 次需关注</text>
    <view class="stat-line-edit" bindtap="goProfiles"><text>编辑资料</text><image class="vet-icon-sm" src="/assets/icons/caret-right-bold-clay.svg" /></view>
  </view>

  <!-- 空状态：无记录 -->
  <view wx:if="{{records.length === 0 && !searchText}}" class="vet-empty empty-panel vet-fade-up">
    <view class="vet-empty-title">还没有检查记录</view>
    <view class="empty-desc">完成第一次初筛后，报告会保存在这里，方便回看变化。</view>
    <button class="vet-btn vet-btn-primary" bindtap="goHome">开始检查</button>
  </view>

  <!-- 空状态：搜索无结果 -->
  <view wx:elif="{{displayRecords.length === 0 && searchText}}" class="vet-empty empty-panel vet-fade-up">
    <view class="vet-empty-title">没有找到匹配记录</view>
    <view class="empty-desc">换个宠物名、部位或可能问题试试。</view>
    <button class="vet-btn vet-btn-secondary" bindtap="onSearchClear">清除搜索</button>
    <button class="vet-btn vet-btn-ghost" bindtap="goHome">开始检查</button>
  </view>

  <!-- 时间轴列表 -->
  <view wx:else class="timeline vet-fade-up vet-stagger-3">
    <block wx:for="{{monthGroups}}" wx:key="monthLabel">
      <view class="tl-month text-numeric">{{item.monthLabel}}</view>
      <view class="tl-item" wx:for="{{item.items}}" wx:for-item="rec" wx:key="id" data-id="{{rec.id}}" bindtap="onRecordTap" bindtouchstart="onRecordTouchStart" bindlongpress="onRecordLongPress">
        <view class="tl-date">
          <text class="tl-day">{{rec.dayNum}}</text>
        </view>
        <view class="tl-body">
          <view class="tl-disease">{{rec.disease || '初筛结果'}}</view>
          <view class="tl-meta">{{rec.metaLine}}</view>
          <view class="tl-status-row">
            <text class="vet-status sev-{{rec.urgency || 'moderate'}}">{{rec.urgencyText}}</text>
            <text class="tl-trend tl-trend-{{rec.trendTag.trend}}" wx:if="{{rec.trendTag}}">较上次{{rec.trendTag.text}}</text>
          </view>
        </view>
        <image wx:if="{{rec.imagePath}}" src="{{rec.imagePath}}" mode="aspectFill" class="tl-thumb" lazy-load />
      </view>
    </block>

    <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">
      <view class="load-more-inner">
        <text>查看更早记录，共 {{totalCount}} 条</text>
      </view>
    </view>
  </view>
  </view>
</view>
