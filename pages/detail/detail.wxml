<view class="vet-page history-page">
  <!-- 页头 -->
  <view class="archive-head">
    <view class="head-left">
      <view class="archive-eyebrow">PET HEALTH RECORDS</view>
      <view class="archive-title">问诊记录</view>
      <view class="archive-desc">按时间保存每次皮肤初筛结果，方便复查和就医沟通。</view>
    </view>
    <view class="archive-month">
      <text class="text-numeric">{{monthlyCount}}</text>
      <text>本月</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-icon">
      <view class="search-icon-circle"></view>
      <view class="search-icon-line"></view>
    </view>
    <input class="search-input" placeholder="搜索宠物名、部位或可能问题"
      placeholder-class="search-placeholder"
      value="{{searchText}}" bindinput="onSearchInput" bindfocus="onSearchFocus" confirm-type="search" />
    <view wx:if="{{searchText}}" class="search-clear" catchtap="onSearchClear">
      <view class="clear-icon">×</view>
    </view>
  </view>

  <!-- 统计栏 -->
  <view class="archive-stats">
    <view class="stat-cell">
      <view class="stat-value text-numeric">{{records.length}}</view>
      <view class="stat-name">累计问诊</view>
    </view>
    <view class="stat-cell stat-divider"></view>
    <view class="stat-cell attention">
      <view class="stat-value text-numeric">{{attentionCount}}</view>
      <view class="stat-name">需关注</view>
    </view>
    <view class="stat-cell stat-divider"></view>
    <view class="stat-cell">
      <view class="stat-value recent text-numeric">{{recentText}}</view>
      <view class="stat-name">最近记录</view>
    </view>
  </view>

  <!-- 排序工具栏 -->
  <view class="archive-toolbar" wx:if="{{records.length > 0}}">
    <view class="toolbar-title">记录排序</view>
    <view class="sort-tabs">
      <view class="sort-tab {{sortField === 'date' ? 'sort-tab-on' : ''}}" bindtap="setSort" data-field="date">
        <text>时间</text>
      </view>
      <view class="sort-tab {{sortField === 'petName' ? 'sort-tab-on' : ''}}" bindtap="setSort" data-field="petName">
        <text>宠物</text>
      </view>
      <view class="sort-tab {{sortField === 'urgency' ? 'sort-tab-on' : ''}}" bindtap="setSort" data-field="urgency">
        <text>关注</text>
      </view>
    </view>
  </view>

  <!-- 空状态：无记录 -->
  <view wx:if="{{records.length === 0 && !searchText}}" class="empty-panel">
    <view class="empty-icon-wrap">
      <view class="empty-icon-emoji">📋</view>
    </view>
    <view class="empty-title">还没有问诊记录</view>
    <view class="empty-desc">完成一次初筛后，报告会自动保存在这里，方便后续对比。</view>
    <button class="vet-btn vet-btn-primary" bindtap="goHome">开始问诊</button>
  </view>

  <!-- 空状态：搜索无结果 -->
  <view wx:elif="{{displayRecords.length === 0 && searchText}}" class="empty-panel">
    <view class="empty-icon-wrap">
      <view class="empty-icon-search">
        <view class="search-empty-circle"></view>
        <view class="search-empty-line"></view>
      </view>
    </view>
    <view class="empty-title">没有找到匹配记录</view>
    <view class="empty-desc">换个宠物名、部位或可能问题试试。</view>
    <button class="vet-btn vet-btn-secondary" bindtap="onSearchClear">清除搜索</button>
  </view>

  <!-- 记录列表 -->
  <view wx:else class="case-list">
    <view class="case-card sev-{{item.urgency || 'moderate'}}" wx:for="{{displayRecords}}" wx:key="id" bindtap="onRecordTap" data-id="{{item.id}}">
      <!-- 严重度色条 -->
      <view class="sev-bar"></view>
      <!-- 日期列 -->
      <view class="case-date">
        <view class="date-tag">
          <text class="date-main text-numeric">{{item.dateShort || '--'}}</text>
        </view>
        <view class="date-line"></view>
      </view>
      <!-- 内容区 -->
      <view class="case-content">
        <view class="case-row">
          <view class="pet-name">{{item.petName || '临时问诊'}}</view>
          <view class="confidence-pill text-numeric" wx:if="{{item.confidenceText}}">
            <view class="confidence-bar">
              <view class="confidence-fill" style="width: {{item.confidenceText}}"></view>
            </view>
            <text class="confidence-text">{{item.confidenceText}}</text>
          </view>
        </view>
        <view class="disease-name">{{item.disease || '初筛结果'}}</view>
        <view class="case-meta">
          <text wx:if="{{item.bodyPartLabel}}" class="meta-tag">{{item.bodyPartLabel}}</text>
          <text wx:if="{{item.bodyPartLabel && item.urgencyText}}" class="meta-dot">·</text>
          <text class="meta-urgency">{{item.urgencyText}}</text>
          <text wx:if="{{item.trendTag}}" class="meta-trend trend-{{item.trendTag.trend}}">{{item.trendTag.icon}} {{item.trendTag.text}}</text>
        </view>
        <view class="case-summary">{{item.summaryText}}</view>
      </view>
      <!-- 缩略图 -->
      <image wx:if="{{item.imagePath}}" src="{{item.imagePath}}" mode="aspectFill" class="case-thumb" lazy-load />
      <!-- 箭头 -->
      <view class="case-arrow">
        <view class="arrow-chevron"></view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">
      <view class="load-more-inner">
        <text>加载更多，还剩 {{totalCount - showingCount}} 条</text>
      </view>
    </view>

    <!-- 清空区域 -->
    <view class="clear-section">
      <button class="vet-btn vet-btn-danger" bindtap="clearRecords">清空所有记录</button>
    </view>
  </view>
</view>
