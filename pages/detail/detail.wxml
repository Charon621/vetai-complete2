<view class="vet-page history-page">
  <!-- 页头 -->
  <view class="archive-head vet-fade-up">
    <view class="archive-title-lg">健康档案</view>
    <text class="archive-eyebrow">ARCHIVE</text>
    <view class="archive-head-actions">
      <view class="archive-clear-btn" bindtap="clearRecords" wx:if="{{records.length > 0}}" aria-label="清空记录">
        <text class="archive-clear-text">清空</text>
      </view>
      <view class="archive-search-toggle" bindtap="toggleSearch">
        <view class="vic vic-search"></view>
      </view>
    </view>
  </view>

  <!-- 搜索栏（点开展开） -->
  <view class="search-bar" wx:if="{{searchOpen}}">
    <view class="vic vic-search search-bar-icon"></view>
    <input class="search-input" placeholder="搜索宠物名、部位或可能问题"
      placeholder-class="search-placeholder" focus="{{searchOpen}}"
      value="{{searchText}}" bindinput="onSearchInput" bindfocus="onSearchFocus" confirm-type="search" />
    <view wx:if="{{searchText}}" class="search-clear" catchtap="onSearchClear">
      <view class="vic vic-close clear-icon"></view>
    </view>
  </view>

  <!-- 宠物切换行 -->
  <scroll-view class="pet-switch vet-fade-up vet-stagger-1" scroll-x wx:if="{{pets.length > 0}}" show-scrollbar="{{false}}">
    <view class="pet-switch-row">
      <view class="pet-chip-sw {{item.id === activeProfileId ? 'on' : ''}}" wx:for="{{pets}}" wx:key="id" data-id="{{item.id}}" bindtap="switchPet">
        <view class="pet-chip-avatar">{{item.initial}}</view>
        <view class="pet-chip-info">
          <view class="pet-chip-name">{{item.petName}}</view>
          <view class="pet-chip-meta">{{item.meta}}</view>
        </view>
      </view>
      <view class="pet-chip-add" bindtap="goProfiles">
        <view class="vic vic-plus"></view>
      </view>
    </view>
  </scroll-view>

  <!-- 统计一行细线 -->
  <view class="stat-line vet-fade-up vet-stagger-2" wx:if="{{records.length > 0}}">
    <text class="stat-line-item"><text class="stat-line-num text-numeric">{{records.length}}</text> 次检查</text>
    <text class="stat-line-item"><text class="stat-line-num text-numeric attention">{{attentionCount}}</text> 次需关注</text>
    <view class="stat-line-edit" bindtap="goProfiles"><text>资料卡 编辑</text><view class="vic vic-arrow stat-line-arrow"></view></view>
  </view>

  <!-- 空状态：无记录 -->
  <view wx:if="{{records.length === 0 && !searchText}}" class="vet-empty empty-panel">
    <view class="empty-icon-wrap">
      <view class="illus-clip">
        <view class="illus-clip-notch"></view>
        <view class="illus-clip-pulse"></view>
      </view>
    </view>
    <view class="vet-empty-title">还没有检查记录</view>
    <view class="empty-desc">完成一次初筛后，报告会自动保存在这里，方便后续对比。</view>
    <button class="vet-btn vet-btn-primary" bindtap="goHome">开始检查</button>
  </view>

  <!-- 空状态：搜索无结果 -->
  <view wx:elif="{{displayRecords.length === 0 && searchText}}" class="vet-empty empty-panel">
    <view class="empty-icon-wrap">
      <view class="empty-icon-search">
        <view class="search-empty-circle"></view>
        <view class="search-empty-dash"></view>
        <view class="search-empty-line"></view>
      </view>
    </view>
    <view class="vet-empty-title">没有找到匹配记录</view>
    <view class="empty-desc">换个宠物名、部位或可能问题试试。</view>
    <button class="vet-btn vet-btn-secondary" bindtap="onSearchClear">清除搜索</button>
  </view>

  <!-- 时间轴列表 -->
  <view wx:else class="timeline vet-fade-up vet-stagger-3">
    <block wx:for="{{monthGroups}}" wx:key="monthLabel">
      <view class="tl-month text-numeric">{{item.monthLabel}}</view>
      <view class="tl-item" wx:for="{{item.items}}" wx:for-item="rec" wx:key="id" data-id="{{rec.id}}" bindtap="onRecordTap">
        <view class="tl-date">
          <text class="tl-day text-numeric">{{rec.dayNum}}</text>
          <view class="tl-dot sev-{{rec.urgency || 'moderate'}}"></view>
        </view>
        <view class="tl-body">
          <view class="tl-disease">{{rec.disease || '初筛结果'}}</view>
          <view class="tl-meta">{{rec.metaLine}}</view>
          <view class="tl-status sev-{{rec.urgency || 'moderate'}}">
            <text>{{rec.urgencyText}}</text><text wx:if="{{rec.trendTag}}" class="mid-dot"></text><text wx:if="{{rec.trendTag}}">{{rec.trendTag.text}} {{rec.trendTag.icon}}</text>
          </view>
        </view>
        <image wx:if="{{rec.imagePath}}" src="{{rec.imagePath}}" mode="aspectFill" class="tl-thumb" lazy-load />
        <view wx:else class="tl-thumb tl-thumb-empty"></view>
        <view class="tl-del" catchtap="onDeleteRecord" data-id="{{rec.id}}" aria-label="删除记录">
          <view class="vic vic-close tl-del-icon"></view>
        </view>
      </view>
    </block>

    <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">
      <view class="load-more-inner">
        <text>查看更早记录</text><text class="mid-dot"></text><text>共 {{totalCount}} 条</text>
      </view>
    </view>
  </view>
</view>
