/* ═══════════════════════════════════════════════════════
   User Page — VetAI DS v5
   账户 / 细线设置组 / 开发者选项 / 紧急条
   ═══════════════════════════════════════════════════════ */

.user-page {
  padding-bottom: calc(var(--sp-8) + env(safe-area-inset-bottom));
}

/* ── 账户区 ── */
.account-flat {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin-top: var(--sp-2);
}

.account-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--brand);
  color: var(--lime);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 900;
  overflow: hidden;
  flex-shrink: 0;
}

.account-avatar-img { width: 100%; height: 100%; }

.account-avatar-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand-dark);
  border: 3rpx solid var(--card);
  color: var(--lime);
  font-size: 20rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.account-name-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.account-rename {
  font-size: var(--fs-caption);
  color: var(--gold);
  border: 2rpx solid var(--gold-line);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
  flex-shrink: 0;
}

.account-rename:active {
  background: var(--gold-mist);
}

.account-name {
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: 900;
  color: var(--text);
}

.account-desc {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: var(--fs-caption);
}

/* ── 统计一行细线 ── */
.stat-line {
  margin-top: var(--sp-4);
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-2) 0;
  border-top: 4rpx solid var(--text);
  border-bottom: 1rpx solid var(--line);
  font-size: var(--fs-caption);
  color: var(--body);
}

.stat-line-num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  font-family: var(--font-mono);
}

.stat-line-recent {
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  letter-spacing: 2rpx;
  color: var(--gold);
}

/* ── 设置细线组 ── */
.settings-flat { margin-top: var(--sp-6); }

.section-eyebrow {
  color: var(--gold);
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-bottom: var(--sp-1);
}

.flat-item {
  display: flex;
  align-items: center;
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line);
}

.flat-item:active { opacity: 0.7; }

.flat-title {
  flex: 1;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text);
}

.flat-title.dev { color: var(--muted); }

.flat-note {
  color: var(--muted);
  font-size: var(--fs-mini);
  margin-right: var(--sp-2);
}

.flat-chevron {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--faint);
  border-right: 3rpx solid var(--faint);
  transform: rotate(45deg);
  transition: transform 200ms ease;
}

.flat-chevron.open { transform: rotate(135deg); }

.flat-detail {
  padding: var(--sp-2) 0 var(--sp-3);
  border-bottom: 1rpx solid var(--line);
}

.flat-detail-text {
  color: var(--body);
  font-size: var(--fs-caption);
  line-height: 1.7;
  white-space: pre-wrap;
}

.flat-detail-actions {
  margin-top: var(--sp-2);
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
}

.flat-action {
  display: inline-flex;
  align-items: center;
  min-height: 60rpx;
  padding: 0 var(--sp-3);
  border-radius: 999rpx;
  border: 1rpx solid var(--brand);
  color: var(--brand);
  font-size: var(--fs-caption);
  font-weight: 600;
}

.flat-action:active { opacity: 0.7; }

.flat-action.danger {
  border-color: var(--sev-emergency);
  color: var(--sev-emergency);
}

/* ── 开发者：反馈分析 ── */
.dev-analysis {
  margin-top: var(--sp-3);
  padding-top: var(--sp-2);
  border-top: 1rpx dashed var(--line);
}

.dev-analysis-title {
  font-size: var(--fs-caption);
  font-weight: 700;
  color: var(--text);
  margin-bottom: var(--sp-1);
}

.dev-analysis-sub {
  margin-top: var(--sp-2);
  color: var(--muted);
  font-size: var(--fs-mini);
  font-weight: 700;
}

.dev-stat-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-2);
  padding: 8rpx 0;
  font-size: var(--fs-caption);
  color: var(--body);
}

.kb-detail-text {
  color: var(--muted);
  font-size: var(--fs-mini);
  margin-top: 4rpx;
  line-height: 1.4;
}

.feedback-pill-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
}

.feedback-pill {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-1);
  padding: var(--sp-1) var(--sp-2);
  border-radius: var(--r-sm);
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--body);
  font-size: var(--fs-caption);
  font-weight: 600;
}

.feedback-pill .text-numeric {
  color: var(--brand);
}

/* ── 底部紧急提示条 ── */
.emergency-strip {
  margin-top: var(--sp-6);
  padding: var(--sp-3);
  border-radius: var(--r-md);
  background: rgba(201, 85, 62, 0.07);
  border: 2rpx dashed rgba(201, 85, 62, 0.4);
  font-size: var(--fs-caption);
  line-height: 1.65;
  color: var(--body);
}

.emergency-strong { color: var(--accent); font-weight: 700; }

.emergency-link {
  color: var(--accent);
  font-weight: 700;
  border-bottom: 2rpx solid rgba(201, 85, 62, 0.5);
}

/* ── 鎏金印章收尾 ── */
.user-seal-wrap {
  margin-top: var(--sp-5);
  display: flex;
  justify-content: center;
}

.seal-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
