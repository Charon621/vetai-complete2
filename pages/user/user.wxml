<view class="vet-page user-page">
  <!-- 账户区 -->
  <view class="account-flat vet-fade-up">
    <view class="account-avatar" bindtap="onEditAvatar" aria-label="更换头像">
      <image wx:if="{{user && user.avatarUrl}}" class="account-avatar-img" src="{{user.avatarUrl}}" mode="aspectFill" />
      <text wx:else>{{user ? user.avatarText : '用'}}</text>
      <view class="account-avatar-badge" wx:if="{{user}}"><text>换</text></view>
    </view>
    <view class="account-copy">
      <view class="account-name-row">
        <text class="account-name">{{currentSpaceName}}</text>
        <view class="account-rename" wx:if="{{user}}" bindtap="onRenameSpace">改名</view>
      </view>
      <view class="account-desc">数据只保存在这台手机上，不上传</view>
      <!-- 本机空间入口：原先只挂在开发者选项里，普通用户点得到头像却找不到建空间的地方 -->
      <view class="account-space-link" bindtap="switchSpace">
        <text>{{user ? '切换 / 新建空间' : '新建本机空间'}}</text>
        <image class="account-space-arrow" src="/assets/icons/caret-right-bold-clay.svg" />
      </view>
    </view>
  </view>

  <!-- 统计三格 -->
  <view class="stat-grid vet-fade-up">
    <view class="stat-cell">
      <text class="stat-num">{{recordsCount}}</text>
      <text class="stat-label">次检查</text>
    </view>
    <view class="stat-cell">
      <text class="stat-num">{{profilesCount}}</text>
      <text class="stat-label">个宠物档案</text>
    </view>
    <view class="stat-cell">
      <text class="stat-num stat-num-sm">{{recentText}}</text>
      <text class="stat-label">最近一次</text>
    </view>
  </view>
  <!-- BUG-UI40：统计为 0 时给一句解释和一个去处，避免只看到 0 / 0 / -- -->
  <view class="stat-empty-hint" wx:if="{{recordsCount === 0}}">还没有检查记录，回到首页拍一张就能生成初筛报告。</view>

  <!-- 设置（细线组） -->
  <view class="settings-flat vet-fade-up">
    <view class="section-eyebrow">设置</view>

    <!-- 数据与隐私 -->
    <view class="flat-item" bindtap="toggleSection" data-key="privacy">
      <text class="flat-title">数据与隐私</text>
      <text class="flat-note">只存本机</text>
      <image class="flat-chevron {{expandedSection === 'privacy' ? 'open' : ''}}" src="/assets/icons/caret-down-light-mute.svg" />
    </view>
    <view class="flat-detail" wx:if="{{expandedSection === 'privacy'}}">
      <view class="flat-detail-text">当前空间：{{currentSpaceName}}
空间 ID：{{currentSpaceId}}
记录和档案只按本机空间分开保存，换手机或重装后不会同步。</view>
      <view class="flat-detail-actions">
        <view class="flat-action" bindtap="clearRecords">清空所有记录</view>
        <view class="flat-action danger" bindtap="clearData">清除全部数据</view>
      </view>
    </view>

    <!-- 备份与导出 -->
    <view class="flat-item" bindtap="toggleSection" data-key="backup">
      <text class="flat-title">备份与导出</text>
      <image class="flat-chevron {{expandedSection === 'backup' ? 'open' : ''}}" src="/assets/icons/caret-down-light-mute.svg" />
    </view>
    <view class="flat-detail" wx:if="{{expandedSection === 'backup'}}">
      <view class="flat-detail-text">把宠物档案和问诊记录复制成文本，便于自行备份或发给兽医。</view>
      <view class="flat-detail-actions">
        <view class="flat-action" bindtap="exportData">导出数据</view>
      </view>
    </view>

    <!-- 拍照小技巧 -->
    <view class="flat-item" bindtap="toggleSection" data-key="quality">
      <text class="flat-title">拍照小技巧</text>
      <text class="flat-note">照片越清楚，判断越准</text>
      <image class="flat-chevron {{expandedSection === 'quality' ? 'open' : ''}}" src="/assets/icons/caret-down-light-mute.svg" />
    </view>
    <view class="flat-detail" wx:if="{{expandedSection === 'quality'}}">
      <view class="flat-detail-text">光线充足、对焦清晰，尽量拍到整体部位和近景细节，必要时圈选患处，AI 判断会更准。</view>
    </view>

    <!-- 免责声明 -->
    <view class="flat-item" bindtap="toggleSection" data-key="disclaimer">
      <text class="flat-title">免责声明</text>
      <image class="flat-chevron {{expandedSection === 'disclaimer' ? 'open' : ''}}" src="/assets/icons/caret-down-light-mute.svg" />
    </view>
    <view class="flat-detail" wx:if="{{expandedSection === 'disclaimer'}}">
      <view class="flat-detail-text">1. 本工具结果仅供参考，不构成医疗诊断。
2. 请在兽医指导下进行宠物疾病治疗。
3. 紧急情况请立即前往宠物医院。
4. 本工具不对使用结果承担任何诊疗责任。</view>
    </view>

    <!-- 关于 VetAI -->
    <view class="flat-item" bindtap="toggleSection" data-key="about">
      <text class="flat-title">关于 VetAI</text>
      <text class="flat-note text-numeric">v{{appVersion}}</text>
      <image class="flat-chevron {{expandedSection === 'about' ? 'open' : ''}}" src="/assets/icons/caret-down-light-mute.svg" />
    </view>
    <view class="flat-detail" wx:if="{{expandedSection === 'about'}}">
      <view class="flat-detail-text">VetAI 宠物皮肤初筛 v{{appVersion}}

用于整理宠物皮肤照片、症状描述和就医沟通参考。结果仅供初步观察，不能替代线下兽医诊断。</view>
    </view>

    <!-- 开发者选项（BUG-UI38：由 config.SHOW_DEV_PANEL 门禁，普通用户不可见） -->
    <block wx:if="{{isDev}}">
    <view class="flat-item flat-item-dev" bindtap="toggleSection" data-key="dev">
      <text class="flat-title dev">开发者选项</text>
      <text class="flat-note">反馈分析和埋点导出</text>
      <image class="flat-chevron {{expandedSection === 'dev' ? 'open' : ''}}" src="/assets/icons/caret-down-light-mute.svg" />
    </view>
    <view class="flat-detail" wx:if="{{expandedSection === 'dev'}}">
      <view class="flat-detail-actions">
        <view class="flat-action" bindtap="exportFeedbackData">导出反馈日志</view>
        <view class="flat-action" bindtap="exportAnalyticsEvents">导出埋点日志</view>
        <view wx:if="{{user}}" class="flat-action" bindtap="logout">切回本机访客</view>
      </view>

      <!-- 反馈分析（仅开发者可见） -->
      <view class="dev-analysis" wx:if="{{feedbackSummary}}">
        <view class="dev-analysis-title">反馈分析（共 {{feedbackSummary.total}} 条）</view>
        <view class="dev-stat-row"><text>有帮助率</text><text class="text-numeric">{{feedbackSummary.helpfulRate}}%</text></view>
        <view class="dev-stat-row"><text>有帮助 / 无帮助</text><text class="text-numeric">{{feedbackSummary.helpful}} / {{feedbackSummary.notHelpful}}</text></view>
        <view class="dev-stat-row"><text>已就医 / 未就医</text><text class="text-numeric">{{feedbackSummary.wentVet}} / {{feedbackSummary.notVet}}</text></view>
        <view class="dev-stat-row"><text>问题反馈率</text><text class="text-numeric">{{feedbackSummary.issueRate}}%</text></view>
        <view class="dev-stat-row"><text>兽医方向一致率</text><text class="text-numeric">{{feedbackSummary.vetAlignedRate}}%</text></view>

        <block wx:if="{{upgradeSignals && upgradeSignals.topIssues.length > 0}}">
          <view class="dev-analysis-sub">主要问题类型</view>
          <view class="feedback-pill-list">
            <view class="feedback-pill" wx:for="{{upgradeSignals.topIssues}}" wx:key="key">
              <text>{{item.label}}</text><text class="text-numeric">{{item.count}}</text>
            </view>
          </view>
        </block>

        <block wx:if="{{upgradeSignals && upgradeSignals.weakSegments.length > 0}}">
          <view class="dev-analysis-sub">优先复盘方向</view>
          <view class="dev-stat-row" wx:for="{{upgradeSignals.weakSegments}}" wx:key="name">
            <text>{{item.name}}</text>
            <text class="kb-detail-text">{{item.bodyPart}}，无帮助 {{item.notHelpful}}，兽医不一致 {{item.vetDifferent}}</text>
          </view>
        </block>

        <block wx:if="{{kbAccuracyList.length > 0}}">
          <!-- BUG-UI41：用户可见文案不得出现「知识库」等内部机制词 -->
          <view class="dev-analysis-sub">匹配效果反馈</view>
          <view class="dev-stat-row" wx:for="{{kbAccuracyList}}" wx:key="name">
            <text>{{item.name}}</text>
            <text class="kb-detail-text">有帮助率 {{item.helpfulRate}}%，无帮助 {{item.notHelpful}}</text>
          </view>
        </block>
      </view>
    </view>
    </block>
  </view>

  <!-- 底部紧急提示条 -->
  <view class="emergency-strip vet-fade-up" bindtap="findHospital">
    <text class="emergency-strong">紧急情况？</text>
    <text>严重外伤、误食、呼吸困难请不要等 AI —— </text>
    <text class="emergency-link">立刻查找附近宠物医院</text>
  </view>

  <!-- 品牌收尾 -->
  <view class="user-brand vet-fade-up">
    <text class="user-brand-word">Vet<text class="user-brand-ai">AI</text></text>
    <text class="user-brand-sub">宠物皮肤初筛 v{{appVersion}}</text>
  </view>
</view>
