/* ═══════════════════════════════════════════════════════
   Index Page — VetAI Design System v2
   专业宠物医疗产品风格 · 去AI感 · 温暖内敛
   ═══════════════════════════════════════════════════════ */

/* ── 页面容器 ── */
.triage-page {
  padding: var(--sp-3) var(--sp-4) calc(220rpx + env(safe-area-inset-bottom));
  background: transparent;
}

/* ── 无档案引导横幅 — 融入页面的温暖邀请 ── */
.profile-guide {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-5) var(--sp-4);
  background: linear-gradient(135deg, var(--brand-light) 0%, rgba(91, 130, 232, 0.15) 60%, rgba(91, 130, 232, 0.06) 100%);
  border-radius: var(--r-lg);
  box-sizing: border-box;
  position: relative;
}

/* 右侧装饰圆点 */
.profile-guide::after {
  content: "";
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(91, 130, 232, 0.06);
  pointer-events: none;
}

.profile-guide:active {
  opacity: 0.85;
}

.profile-guide-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.profile-guide-paw {
  font-size: 40rpx;
  line-height: 1;
}

.profile-guide-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.profile-guide-title {
  color: var(--brand);
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.profile-guide-desc {
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.45;
}

.profile-guide-action {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #FFFFFF;
  font-size: var(--fs-caption);
  font-weight: 600;
  line-height: 1.3;
}

/* ── 有档案状态：融入页面的柔和设计 ── */
.profile-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-3);
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line-light);
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* 底部柔和渐变装饰条，取代硬边框 */
.profile-bar::before {
  content: "";
  position: absolute;
  left: var(--sp-3);
  right: var(--sp-3);
  bottom: 0;
  height: 4rpx;
  background: linear-gradient(90deg, var(--brand), var(--brand-mid), transparent);
  border-radius: var(--r-sm);
  opacity: 0.45;
}

.profile-bar:active {
  opacity: 0.92;
}

.profile-bar-left {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  flex: 1;
  min-width: 0;
}

.profile-bar-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--brand-light);
  color: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  border: 3rpx solid var(--line-light);
}

.profile-bar-avatar image {
  width: 100%;
  height: 100%;
}

.profile-bar-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.profile-bar-name {
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-bar-sub {
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-bar-sub-hint {
  color: var(--muted);
  font-style: normal;
}

.profile-bar-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.profile-bar-arrow {
  color: var(--faint);
  font-size: var(--fs-title);
  font-weight: 300;
  line-height: 1;
}

/* 模式切换 — 柔和胶囊控件 */
.mode-pill {
  display: flex;
  gap: 0;
  border-radius: 999rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  background: var(--surface);
}

.mode-pill-item {
  padding: 8rpx 20rpx;
  font-size: var(--fs-mini);
  font-weight: 600;
  color: var(--muted);
  background: transparent;
  line-height: 1;
  transition: all 0.2s ease;
}

.mode-pill-item:first-child {
  border-right: 1rpx solid var(--line);
}

.mode-pill-on {
  background: var(--brand);
  color: #FFFFFF;
}

/* ── 影像采集区 ── */
.evidence-board {
  margin-top: var(--sp-5);
}

.board-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.board-head-left {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  flex: 1;
  min-width: 0;
}

/* 品牌色小竖线 */
.section-title-bar {
  width: 6rpx;
  height: 30rpx;
  border-radius: var(--r-sm);
  background: var(--brand);
  flex-shrink: 0;
}

.board-title {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.board-desc {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.45;
}

/* 计数徽章 */
.board-count-badge {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  color: var(--brand);
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.board-count-sep {
  font-size: var(--fs-caption);
  color: var(--faint);
  margin: 0 2rpx;
}

/* ── 无图引导区 — 浅灰底 + 虚线边框 ── */
.capture-hero {
  position: relative;
  border-radius: var(--r-md);
  overflow: visible;
  padding: var(--sp-5) var(--sp-4) var(--sp-4);
  background: var(--surface);
  border: 2rpx dashed var(--line);
}

.capture-hero-bg {
  display: none;
}

.capture-hero-inner {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--sp-2);
}

/* 极简相机图标 — 纯 CSS */
.capture-hero-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-md);
  background: var(--card);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--sp-1);
  box-shadow: var(--shadow-sm);
}

.capture-hero-camera {
  position: relative;
  width: 44rpx;
  height: 36rpx;
  border-radius: var(--r-sm);
  border: 3rpx solid var(--muted);
  box-sizing: border-box;
}

.capture-hero-camera::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 3rpx solid var(--muted);
  transform: translate(-50%, -50%);
}

.capture-hero-camera::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: -8rpx;
  width: 18rpx;
  height: 8rpx;
  border-radius: var(--r-sm) var(--r-sm) 0 0;
  background: var(--muted);
}

.capture-hero-title {
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: 1.35;
}

.capture-hero-desc {
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.5;
  max-width: 480rpx;
}

.capture-hero-btn {
  margin-top: var(--sp-1);
  padding: var(--sp-2) var(--sp-5);
  border-radius: var(--r-md);
  background: var(--brand);
  color: #FFFFFF;
  font-size: var(--fs-body);
  font-weight: 650;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
}

.capture-hero-btn:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.capture-hero-tags {
  position: relative;
  display: flex;
  justify-content: center;
  gap: var(--sp-1);
  margin-top: var(--sp-3);
}

.capture-tag {
  padding: 6rpx var(--sp-2);
  border-radius: var(--r-sm);
  background: var(--card);
  color: var(--body);
  font-size: var(--fs-mini);
  font-weight: 600;
  border: 1rpx solid var(--line-light);
}

/* ── 有图列表 ── */
.evidence-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.evidence-item {
  display: flex;
  align-items: stretch;
  overflow: hidden;
  border-radius: var(--r-md);
  background: var(--card);
  border: 1rpx solid var(--line-light);
  box-shadow: var(--shadow-sm);
}

.evidence-img-wrap {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  width: 140rpx;
}

.evidence-image {
  width: 140rpx;
  height: 140rpx;
  display: block;
  background: var(--surface);
}

.evidence-img-badge {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  padding: 2rpx 8rpx;
  border-radius: var(--r-sm);
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 600;
}

.evidence-img-badge.has-box {
  background: var(--brand);
}

.evidence-info {
  flex: 1;
  min-width: 0;
  padding: var(--sp-2) var(--sp-3);
  background: var(--card);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--sp-1);
}

.evidence-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-2);
}

.evidence-label {
  color: var(--text);
  font-size: 27rpx;
  font-weight: 700;
}

.evidence-state {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: var(--fs-caption);
}

.evidence-state.saved {
  color: var(--brand);
  font-weight: 700;
}

/* 删除按钮 — CSS 绘制的 X */
.remove-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  flex-shrink: 0;
}

.remove-x {
  position: relative;
  width: 20rpx;
  height: 20rpx;
}

.remove-x::before,
.remove-x::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--muted);
  transform: translate(-50%, -50%) rotate(45deg);
}

.remove-x::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.evidence-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
}

.action-chip {
  min-height: 48rpx;
  padding: 0 var(--sp-2);
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--body);
  font-size: var(--fs-caption);
  font-weight: 600;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.action-chip.active {
  background: var(--brand);
  border-color: var(--brand);
  color: #FFFFFF;
}

.action-chip.primary {
  background: var(--brand-light);
  border-color: var(--line);
  color: var(--brand);
  font-weight: 700;
}

.action-chip.warning {
  background: var(--accent-soft);
  border-color: var(--line);
  color: var(--accent);
}

/* 继续添加 */
.append-photo {
  min-height: 80rpx;
  border-radius: var(--r-md);
  border: 2rpx dashed var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  color: var(--muted);
  font-size: var(--fs-caption);
  font-weight: 600;
  background: transparent;
  transition: all 0.15s ease;
}

.append-plus {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}

.append-plus::before,
.append-plus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.append-plus::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

/* ── 通用信息区块 ── */
.case-section {
  margin-top: var(--sp-5);
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.section-title {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-desc {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.45;
}

/* ── 表单面板 — 白底卡片 ── */
.input-panel {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  padding: var(--sp-3);
  background: var(--card);
  border: 1rpx solid var(--line-light);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-sm);
}

.field-block {
  display: flex;
  flex-direction: column;
}

.field-title {
  margin-bottom: var(--sp-1);
  color: var(--body);
  font-size: var(--fs-caption);
  font-weight: 650;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
}

.body-row .choice {
  min-width: 100rpx;
}

.choice {
  min-height: 52rpx;
  padding: 0 var(--sp-3);
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-light);
  border: 1rpx solid var(--line);
  color: var(--brand);
  font-size: var(--fs-caption);
  font-weight: 600;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.choice.selected {
  background: var(--brand);
  border-color: var(--brand);
  color: #FFFFFF;
  box-shadow: var(--shadow-sm);
}

/* 文本域 */
.clinical-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--text);
  font-size: var(--fs-body);
  line-height: 1.6;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}

.clinical-textarea:focus {
  border-color: var(--brand);
  box-shadow: 0 0 0 3rpx rgba(91, 130, 232, 0.08);
}

/* ── 底部提交栏 — 白底 + 顶部分隔线 ── */
.submit-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: var(--sp-2) var(--sp-4) calc(var(--sp-2) + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--line);
  box-sizing: border-box;
}

.submit-progress-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
}

.submit-progress-bar {
  flex: 1;
  height: 8rpx;
  border-radius: var(--r-sm);
  background: var(--line-light);
  overflow: hidden;
}

.submit-progress-fill {
  height: 100%;
  border-radius: var(--r-sm);
  background: var(--brand);
  transition: width 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.submit-progress-text {
  flex-shrink: 0;
  color: var(--brand);
  font-size: var(--fs-mini);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.submit-hint-inline {
  flex-shrink: 0;
  color: var(--muted);
  font-size: var(--fs-mini);
  margin-left: auto;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
}

.submit-btn[disabled],
.btn-disabled {
  opacity: 0.4;
  box-shadow: none;
}

.submit-disclaimer {
  margin-top: var(--sp-1);
  color: var(--faint);
  text-align: center;
  font-size: var(--fs-mini);
}

/* ── 分析中遮罩 — 纯黑半透明 + 白字 ── */
.analyzing-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.72);
}

.analyzing-card {
  text-align: left;
}

.analyzing-pulse-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.analyzing-pulse {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--brand);
  flex-shrink: 0;
  animation: analyzingPulse 1.6s ease-in-out infinite;
}

@keyframes analyzingPulse {
  0%, 100% {
    opacity: 0.4;
    transform: scale(0.85);
  }
  50% {
    opacity: 1;
    transform: scale(1.15);
  }
}

.analyzing-desc-text {
  margin: var(--sp-2) 0 var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-sm);
  background: var(--surface);
  color: var(--body);
  font-size: var(--fs-caption);
  font-weight: 600;
  line-height: 1.5;
}

/* ── 患处圈选浮层 ── */
.lesion-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.72);
}

.lesion-sheet {
  width: 100%;
  height: 92vh;
  padding: var(--sp-3) var(--sp-3) calc(var(--sp-3) + env(safe-area-inset-bottom));
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  background: var(--bg);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.lesion-top {
  display: flex;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
  flex-shrink: 0;
}

.lesion-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border: 1rpx solid var(--line-light);
  color: var(--body);
  font-size: var(--fs-title);
  flex-shrink: 0;
}

.lesion-toolbar {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  margin-bottom: var(--sp-2);
  flex-shrink: 0;
}

.tool-chip {
  padding: var(--sp-1) var(--sp-2);
  border-radius: var(--r-sm);
  background: var(--card);
  border: 1rpx solid var(--line);
  color: var(--body);
  font-size: var(--fs-caption);
  font-weight: 600;
  transition: all 0.15s ease;
}

.tool-chip-on {
  background: var(--brand);
  border-color: var(--brand);
  color: #FFFFFF;
}

.tool-stat {
  padding: var(--sp-1) var(--sp-2);
  border-radius: var(--r-sm);
  background: var(--card);
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: var(--fs-caption);
  font-weight: 600;
  margin-left: auto;
}

.lesion-stage {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: auto !important;
  flex: 1;
  min-height: 320rpx;
  border-radius: var(--r-md);
  background: #1A1A1A;
}

.lesion-image,
.lesion-canvas,
.lesion-grid {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.lesion-grid {
  background:
    linear-gradient(90deg, rgba(255,255,255,0.06) 1rpx, transparent 1rpx),
    linear-gradient(0deg, rgba(255,255,255,0.06) 1rpx, transparent 1rpx);
  background-size: 20% 20%;
}

.lesion-canvas {
  z-index: 3;
}

.lesion-tip {
  display: flex;
  justify-content: space-between;
  gap: var(--sp-2);
  margin: var(--sp-2) var(--sp-1) var(--sp-2);
  color: var(--muted);
  font-size: var(--fs-caption);
  flex-shrink: 0;
}

.lesion-tip text:first-child {
  color: var(--brand);
  font-weight: 700;
}

.lesion-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-1);
  flex-shrink: 0;
}

.lesion-save-main {
  grid-column: 1 / -1;
  width: 100%;
  min-height: 88rpx;
}

/* ── Dark Mode 适配 ── */
@media (prefers-color-scheme: dark) {
  .profile-guide {
    background: linear-gradient(135deg, rgba(91, 130, 232, 0.12) 0%, rgba(91, 130, 232, 0.04) 100%);
  }

  .profile-guide-icon {
    background: var(--brand);
  }

  .profile-bar {
    background: var(--card);
    border-color: var(--line-light);
  }

  .profile-bar::before {
    opacity: 0.3;
  }

  .profile-bar-avatar {
    border-color: var(--line);
  }

  .mode-pill {
    background: var(--surface);
    border-color: var(--line);
  }

  .capture-hero {
    background: var(--surface);
    border-color: var(--line);
  }

  .capture-hero-icon {
    background: var(--surface);
    border-color: var(--line);
  }

  .capture-tag {
    background: var(--surface);
    border-color: var(--line);
  }

  .submit-area {
    background: var(--card);
  }

  .evidence-item {
    background: var(--card);
  }

  .lesion-stage {
    background: #0D0D0D;
  }
}
