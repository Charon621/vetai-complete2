/* ═══════════════════════════════════════════════════════
   Index Page — VetAI DS v5
   诊室编辑风 · 暖纸白 · 鎏金元数据
   ═══════════════════════════════════════════════════════ */

/* ── 页面容器 ── */
.triage-page {
  padding: var(--sp-3) var(--vet-page-x) calc(var(--sp-8) + env(safe-area-inset-bottom));
  background: transparent;
}

.triage-page.has-submit-bar {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* ── 无档案引导横幅 — 融入页面的温暖邀请 ── */
.profile-guide {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-5) var(--sp-4);
  background: linear-gradient(135deg, var(--brand-light) 0%, var(--brand-mist-strong) 60%, var(--brand-mist) 100%);
  border-radius: var(--r-lg);
  box-sizing: border-box;
  position: relative;
}

/* 右侧装饰圆点 */
.profile-guide::after {
  content: "";
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: var(--brand-mist);
  pointer-events: none;
}

.profile-guide:active {
  opacity: 0.85;
}

.profile-guide-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--brand);
  color: var(--on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-guide-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.profile-guide-title {
  color: var(--brand);
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.profile-guide-desc {
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.45;
}

.profile-guide-action {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: var(--on-brand);
  font-size: var(--fs-caption);
  font-weight: 600;
  line-height: 1.3;
}

/* ── 影像采集区 ── */
.evidence-board {
  margin-top: var(--sp-5);
}

.board-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.board-head-left {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  flex: 1;
  min-width: 0;
}

.board-title {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.board-desc {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.45;
}

/* 计数徽章 */
.board-count-badge {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  color: var(--brand);
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.board-count-sep {
  font-size: var(--fs-caption);
  color: var(--faint);
  margin: 0 2rpx;
}

/* ── 无图引导区 — 浅灰底 + 虚线边框 ── */
.capture-hero {
  position: relative;
  border-radius: var(--r-md);
  overflow: visible;
  padding: var(--sp-5) var(--sp-4) var(--sp-4);
  background: var(--surface);
}

/* 取景框四角标线，替代虚线边框 */
.capture-hero-bg {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  background-image:
    linear-gradient(var(--brand-mid), var(--brand-mid)),
    linear-gradient(var(--brand-mid), var(--brand-mid)),
    linear-gradient(var(--brand-mid), var(--brand-mid)),
    linear-gradient(var(--brand-mid), var(--brand-mid)),
    linear-gradient(var(--brand-mid), var(--brand-mid)),
    linear-gradient(var(--brand-mid), var(--brand-mid)),
    linear-gradient(var(--brand-mid), var(--brand-mid)),
    linear-gradient(var(--brand-mid), var(--brand-mid));
  background-size:
    32rpx 4rpx, 4rpx 32rpx,
    32rpx 4rpx, 4rpx 32rpx,
    32rpx 4rpx, 4rpx 32rpx,
    32rpx 4rpx, 4rpx 32rpx;
  background-position:
    left 12rpx top 12rpx, left 12rpx top 12rpx,
    right 12rpx top 12rpx, right 12rpx top 12rpx,
    left 12rpx bottom 12rpx, left 12rpx bottom 12rpx,
    right 12rpx bottom 12rpx, right 12rpx bottom 12rpx;
  background-repeat: no-repeat;
  border-radius: var(--r-md);
}

.capture-hero-inner {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--sp-2);
}

/* 极简相机图标 — 纯 CSS */
.capture-hero-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-md);
  background: var(--card);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--sp-1);
}

.capture-hero-camera {
  position: relative;
  width: 44rpx;
  height: 36rpx;
  border-radius: var(--r-sm);
  border: 3rpx solid var(--muted);
  box-sizing: border-box;
}

.capture-hero-camera::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 3rpx solid var(--muted);
  transform: translate(-50%, -50%);
}

.capture-hero-camera::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: -8rpx;
  width: 18rpx;
  height: 8rpx;
  border-radius: var(--r-sm) var(--r-sm) 0 0;
  background: var(--muted);
}

.capture-hero-title {
  color: var(--text);
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: 1.35;
}

.capture-hero-desc {
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.5;
  max-width: 480rpx;
}

.capture-hero-btn {
  margin-top: var(--sp-1);
  padding: var(--sp-2) var(--sp-5);
  border-radius: var(--r-md);
  background: var(--brand);
  color: var(--on-brand);
  font-size: var(--fs-body);
  font-weight: 700;
  transition: all 0.2s ease;
}

.capture-hero-btn:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.capture-hero-tags {
  position: relative;
  display: flex;
  justify-content: center;
  gap: var(--sp-1);
  margin-top: var(--sp-3);
}

.capture-tag {
  padding: 6rpx var(--sp-2);
  border-radius: var(--r-sm);
  background: var(--card);
  color: var(--body);
  font-size: var(--fs-mini);
  font-weight: 600;
  border: 1rpx solid var(--line-light);
}

/* ── 有图列表 ── */
.evidence-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.evidence-item {
  display: flex;
  align-items: stretch;
  overflow: hidden;
  border-radius: var(--r-md);
  background: var(--card);
  border: 1rpx solid var(--line-light);
}

.evidence-img-wrap {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  width: 140rpx;
}

.evidence-image {
  width: 140rpx;
  height: 140rpx;
  display: block;
  background: var(--surface);
}

.evidence-img-badge {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  padding: 3rpx 10rpx;
  border-radius: var(--r-sm);
  background: var(--scrim);
  color: var(--on-overlay);
  font-size: 20rpx;
  font-weight: 600;
}

.evidence-img-badge.has-box {
  background: var(--brand);
}

.evidence-info {
  flex: 1;
  min-width: 0;
  padding: var(--sp-2) var(--sp-3);
  background: var(--card);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--sp-1);
}

.evidence-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-2);
}

.evidence-label {
  color: var(--text);
  font-size: 27rpx;
  font-weight: 700;
}

.evidence-state {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: var(--fs-caption);
}

.evidence-state.saved {
  color: var(--brand);
  font-weight: 700;
}

/* 删除按钮 — CSS 绘制的 X */
.remove-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  flex-shrink: 0;
}

.remove-x {
  position: relative;
  width: 20rpx;
  height: 20rpx;
}

.remove-x::before,
.remove-x::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--muted);
  transform: translate(-50%, -50%) rotate(45deg);
}

.remove-x::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.evidence-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
}

.action-chip {
  min-height: 48rpx;
  padding: 0 var(--sp-2);
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--body);
  font-size: var(--fs-caption);
  font-weight: 600;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.action-chip.active {
  background: var(--brand);
  border-color: var(--brand);
  color: var(--on-brand);
}

.action-chip.primary {
  background: var(--brand-light);
  border-color: var(--line);
  color: var(--brand);
  font-weight: 700;
}

.action-chip.warning {
  background: var(--accent-soft);
  border-color: var(--line);
  color: var(--accent);
}

/* 继续添加（加号图标走全局 .vic-plus） */
.append-photo {
  min-height: 80rpx;
  border-radius: var(--r-md);
  border: 2rpx dashed var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  color: var(--muted);
  font-size: var(--fs-caption);
  font-weight: 600;
  background: transparent;
  transition: all 0.15s ease;
}

.append-photo .vic-plus {
  width: 24rpx;
  height: 24rpx;
}

/* ── 通用信息区块 ── */
.case-section {
  margin-top: var(--sp-5);
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.section-title {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-desc {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.45;
}

/* ── 表单面板 — 白底卡片 ── */
.input-panel {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  padding: var(--sp-3);
  background: var(--card);
  border: 1rpx solid var(--line-light);
  border-radius: var(--r-md);
}

.field-block {
  display: flex;
  flex-direction: column;
}

.field-title {
  margin-bottom: var(--sp-1);
  color: var(--body);
  font-size: var(--fs-caption);
  font-weight: 600;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
}

.body-row .choice {
  min-width: 100rpx;
}

.choice {
  min-height: 52rpx;
  padding: 0 var(--sp-3);
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-light);
  border: 1rpx solid var(--line);
  color: var(--brand);
  font-size: var(--fs-caption);
  font-weight: 600;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.choice.selected {
  background: var(--brand);
  border-color: var(--brand);
  color: var(--on-brand);
}

/* 文本域 */
.clinical-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--text);
  font-size: var(--fs-body);
  line-height: 1.6;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}

.clinical-textarea:focus {
  border-color: var(--brand);
  box-shadow: 0 0 0 3rpx var(--brand-focus-ring);
}

/* ── 底部提交栏 — 浮起面板（与 result/chat 底栏统一） ── */
.submit-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: var(--sp-2) var(--sp-4) calc(var(--sp-2) + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--line);
  border-radius: var(--r-md) var(--r-md) 0 0;
  box-shadow: var(--shadow-bar);
  box-sizing: border-box;
}

.submit-progress-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
}

.submit-progress-bar {
  flex: 1;
  height: 8rpx;
  border-radius: var(--r-sm);
  background: var(--line-light);
  overflow: hidden;
}

.submit-progress-fill {
  height: 100%;
  border-radius: var(--r-sm);
  background: var(--brand);
  transition: width var(--dur-base) var(--ease-standard);
}

.submit-progress-text {
  flex-shrink: 0;
  color: var(--brand);
  font-size: var(--fs-mini);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.submit-hint-inline {
  flex-shrink: 0;
  color: var(--muted);
  font-size: var(--fs-mini);
  margin-left: auto;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
}

.submit-btn[disabled],
.btn-disabled {
  opacity: 0.4;
  box-shadow: none;
}

.submit-disclaimer {
  margin-top: var(--sp-1);
  color: var(--faint);
  text-align: center;
  font-size: var(--fs-mini);
}

/* ── 分析中遮罩 — 纯黑半透明 + 白字 ── */
.analyzing-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--overlay);
}

.analyzing-card {
  text-align: left;
}

.analyzing-desc-text {
  margin: var(--sp-2) 0 var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-sm);
  background: var(--surface);
  color: var(--body);
  font-size: var(--fs-caption);
  font-weight: 600;
  line-height: 1.5;
}

/* ── Dark Mode 适配 ── */
@media (prefers-color-scheme: dark) {
  .profile-guide-icon {
    background: var(--brand);
  }

  .capture-hero {
    background: var(--surface);
  }

  .capture-hero-icon {
    background: var(--surface);
    border-color: var(--line);
  }

  .capture-tag {
    background: var(--surface);
    border-color: var(--line);
  }

  .submit-area {
    background: var(--card);
  }

  .evidence-item {
    background: var(--card);
  }
}

/* ═══════════════════════════════════════════════════════
   v4 首页（4a）— 刊头 / 宠物行 / 01 PHOTO / 02 CHAT / 上次检查
   ═══════════════════════════════════════════════════════ */

/* ── 刊头 ── */
.home-masthead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-2);
}

.masthead-date {
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--gold);
}

.masthead-brand {
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  font-weight: 600;
  letter-spacing: 3rpx;
  color: var(--gold);
  border: 1rpx solid var(--gold-line);
  border-radius: 6rpx; /* 豁免：微型描边徽标的笔画级圆角，不入三档 */
  padding: 4rpx 12rpx;
}

/* ── 宋体大标题 ── */
.greet-title {
  margin-top: var(--sp-3);
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-hero);
  font-weight: 900;
  line-height: 1.25;
}

.greet-sub {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: var(--fs-caption);
}

/* ── 宠物行 ── */
.pet-row {
  margin-top: var(--sp-3);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.pet-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 4rpx solid transparent;
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 900;
  opacity: 0.6;
  box-sizing: border-box;
}

.pet-avatar:active { opacity: 0.85; }

.pet-avatar.active {
  border-color: var(--brand);
  opacity: 1;
}

.pet-avatar-add {
  background: transparent;
  border: 2rpx dashed var(--faint);
  color: var(--ghost);
  font-family: var(--font-sans);
  font-size: 36rpx;
  font-weight: 300;
  opacity: 1;
}

.pet-count {
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  letter-spacing: 2rpx;
  color: var(--gold);
}

/* ── 区块编号（01 / PHOTO、02 / CHAT） ── */
.card-no {
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  font-weight: 600;
  letter-spacing: 4rpx;
}

.card-no-lime { color: var(--lime); }
.card-no-gold { color: var(--gold); }

/* ── 01 / PHOTO 墨绿主卡 ── */
.photo-card {
  position: relative;
  margin-top: var(--sp-4);
  padding: 36rpx 36rpx 32rpx;
  background: var(--brand);
  color: var(--on-brand);
  border-radius: var(--r-lg);
  overflow: hidden;
}

.photo-card:active { opacity: 0.94; }

.photo-seal {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  width: 108rpx;
  height: 108rpx;
  border-color: var(--gold-line-onbrand);
  transform: rotate(10deg);
}

.photo-seal::before {
  border-color: var(--gold-line-onbrand-inner);
}

.seal-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.photo-seal text {
  color: var(--gold-bright);
  font-size: 22rpx;
  line-height: 1;
}

.photo-seal .vet-seal-sub {
  color: var(--gold-bright);
  font-size: 12rpx;
}

.photo-title {
  margin-top: 20rpx;
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: 900;
}

.photo-desc {
  margin-top: 6rpx;
  max-width: 400rpx;
  font-size: var(--fs-caption);
  line-height: 1.6;
  opacity: 0.72;
}

.photo-foot {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.photo-eta {
  font-family: var(--font-mono);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  opacity: 0.55;
}

/* ── 02 / CHAT 墨线描边卡 ── */
.chat-card {
  margin-top: 20rpx;
  padding: 30rpx 36rpx;
  background: var(--card);
  border: 2rpx solid var(--brand);
  border-radius: var(--r-lg);
  display: flex;
  align-items: center;
  gap: 28rpx;
  box-sizing: border-box;
}

.chat-card:active { opacity: 0.92; }

.chat-card-body { flex: 1; min-width: 0; }

.chat-card-title {
  margin-top: 10rpx;
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 900;
  color: var(--text);
}

.chat-card-sub {
  margin-top: 4rpx;
  font-size: var(--fs-caption);
  color: var(--muted);
}

/* ── 上次检查 ── */
.last-check {
  margin-top: var(--sp-5);
  border-top: 4rpx solid var(--text);
  padding-top: 20rpx;
}

.last-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.last-title {
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text);
}

.last-all {
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  letter-spacing: 2rpx;
  color: var(--gold);
}

.last-row {
  margin-top: var(--sp-2);
  display: flex;
  align-items: center;
  gap: var(--sp-3);
}

.last-date {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 22rpx;
  color: var(--gold);
}

.last-info { flex: 1; min-width: 0; }

.last-disease {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.last-status {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: var(--r-sm);
  padding: 6rpx 14rpx;
  background: var(--surface);
  color: var(--muted);
}

.last-status.sev-low { color: var(--sev-low); background: var(--sev-low-bg); }
.last-status.sev-moderate { color: var(--sev-mid-text); background: var(--sev-mid-bg); }
.last-status.sev-urgent { color: var(--sev-urgent); background: var(--sev-urgent-bg); }
.last-status.sev-emergency { color: var(--sev-emergency); background: var(--sev-emergency-bg); }

/* 今日护理 —— 处方笺「医嘱」：淡金雾底 + 鎏金左竖条 */
.care-tip {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
  background: var(--gold-mist);
  border-left: 4rpx solid var(--gold);
  font-size: var(--fs-caption);
  line-height: 1.6;
  color: var(--body);
}

.care-tip-label {
  color: var(--gold);
  font-weight: 700;
}

/* 空状态容器复用全局 .vet-empty，此处仅保留页面内的外边距 */
.home-empty {
  margin-top: var(--sp-6);
}


/* ── 拍照流程顶栏 ── */
.capture-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
}

.capture-back {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--muted);
}

.capture-back-arrow {
  width: 16rpx;
  height: 16rpx;
  border-left: 3rpx solid var(--muted);
  border-bottom: 3rpx solid var(--muted);
  transform: rotate(45deg);
}

.capture-topbar-title {
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 900;
  color: var(--text);
}

.capture-topbar-spacer {
  width: 80rpx;
}
