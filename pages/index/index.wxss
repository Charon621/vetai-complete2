/* ═══════════════════════════════════════════════════════
   Index Page — VetAI DS v7「暖阳 · 衬线」
   首页：半透明合影 + 动态问候 + 陶土主卡；拍照流程：三步表单
   不画分割线，层次靠留白、底色深浅与卡片
   ═══════════════════════════════════════════════════════ */

/* ── 页面容器 ── */
.triage-page {
  position: relative;
  /* BUG-UI2：底部留白只认 --tab-bar-h，不再用 120rpx 魔数 */
  padding: var(--sp-3) var(--vet-page-x) calc(var(--sp-6) + var(--tab-bar-h) + env(safe-area-inset-bottom));
}

/* 首页在底栏预留区上方排版；短屏正常向下滚动。 */
.triage-page.is-home {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

.triage-page.is-home .home-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
}

.home-top {
  display: flex;
  flex-direction: column;
  flex: none;
}

/* 只让主入口与次入口之间吸收剩余空间，卡片组不会掉进底栏下面。 */
.triage-page.is-home .home-pair {
  margin-top: auto;
}

/* 有「今日护理」时它跟在卡片组后面，间距交给自己的 margin-top */
.home-pair + .care-tip {
  margin-top: var(--sp-2);
}

/* 拍照态：底栏在流程里被收起（见 index.js 的 _syncTabBar），
   所以这里只需让出提交栏自身高度，不用再叠加 --tab-bar-h */
.triage-page.has-submit-bar {
  padding-bottom: calc(var(--action-bar-h) + 108rpx + env(safe-area-inset-bottom));
}

/* ═══════════════════════════════════════════════════════
   首页
   ═══════════════════════════════════════════════════════ */

/* 合影：铺在导航下方，半透明、偏暖，下半部渐隐进纸色 */
.home-photo {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 460rpx;
  opacity: 0.42;
  filter: sepia(0.08) saturate(0.92);
  pointer-events: none;
}

/* --bg @35% / @0 / @40%（微信 WXSS 不支持 8 位 hex，必须用 rgba） */
.home-photo-fade {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 460rpx;
  background: linear-gradient(180deg,
    rgba(247, 243, 234, 0.35) 0%,
    rgba(247, 243, 234, 0) 30%,
    rgba(247, 243, 234, 0.4) 62%,
    var(--bg) 100%);
  pointer-events: none;
}

.home-body {
  position: relative;
  z-index: 1;
}

.home-brand {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.brand-word {
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 800;
  color: var(--text);
}

.brand-ai { color: var(--brand); }

.brand-date {
  font-family: var(--font-serif);
  font-size: var(--fs-caption);
  color: var(--body);
}

/* 动态问候：宋体大字。宠物名的手绘下划线方案已废弃（WXML 只渲染 greeting.sub），
   原 .greet-line / .greet-name / .greet-underline 三条死样式一并删除（BUG-UI9）。 */
.greet {
  margin-top: 112rpx;
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: 800;
  line-height: 1.26;
}

.greet-sub {
  margin-top: 10rpx;
  color: var(--body);
  font-size: var(--fs-caption);
}

/* ── 宠物行 ── */
.pet-row {
  margin-top: var(--sp-2);
  display: flex;
  align-items: flex-start;
  gap: var(--sp-3);
}

.pet {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-1);
  width: 88rpx;
}

.pet:active { opacity: 0.8; }

/* 命中区不低于 88rpx（44pt）：视觉仍是 76rpx 圆，靠容器撑开热区（BUG-UI5） */
.pet-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--card);
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-size: var(--fs-heading);
  font-weight: 700;
  box-sizing: border-box;
  overflow: hidden;
}
.pet-avatar-img { display: block; width: 100%; height: 100%; }

.pet.active .pet-avatar {
  background: var(--ink);
  color: var(--on-ink);
  box-shadow: 0 0 0 5rpx var(--bg), 0 0 0 8rpx var(--brand);
}

.pet-avatar-add { background: var(--surface); }

.pet-name {
  max-width: 82rpx;
  font-size: var(--fs-mini);
  color: var(--body);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pet.active .pet-name {
  color: var(--text);
  font-weight: 600;
}

/* ── 拍照初筛主卡 ── */
.photo-card {
  position: relative;
  margin-top: var(--sp-3);
  height: 320rpx;
  padding: var(--sp-4) var(--sp-4) 0;
  background: var(--brand);
  color: var(--on-brand);
  border-radius: var(--r-md);
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 12rpx 28rpx rgba(118, 57, 35, 0.14);
  transition: transform var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
}

.photo-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(118, 57, 35, 0.12);
}

.photo-kicker {
  font-family: var(--font-sans);
  font-size: var(--fs-mini);
  color: var(--on-brand-muted);
}

.photo-title {
  margin-top: 6rpx;
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: 800;
}

/* BUG-UI7：原先限宽 260rpx（只占可用宽度 47%），18 字说明被压成 3 行、
   右侧大片留空。拱窗只占 174rpx，正文放到 420rpx 即可并排。 */
.photo-desc {
  margin-top: 8rpx;
  max-width: 420rpx;
  font-size: var(--fs-caption);
  line-height: 1.55;
  color: var(--on-brand-muted);
}

.photo-go {
  width: max-content;
  margin-top: var(--sp-4);
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  /* 热区 76rpx：视觉不变，靠上下 padding 撑到近 88rpx（BUG-UI5） */
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-sm);
  background: var(--on-brand);
  color: var(--brand-dark);
  font-size: var(--fs-body);
  font-weight: 600;
}

/* 拱形取景窗：只在这里用大曲线 */
.photo-arch {
  position: absolute;
  right: 24rpx;
  bottom: 0;
  width: 150rpx;
  height: 196rpx;
  border-radius: 75rpx 75rpx 0 0;
  /* --on-brand @14%（微信 WXSS 不支持 8 位 hex，用 rgba） */
  background: rgba(251, 245, 236, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.photo-arch-icon {
  width: 72rpx;
  height: 72rpx;
}

/* 主卡下面只放实际拍摄建议，让留白承担节奏，不加装饰图标。 */
.photo-guide {
  margin-top: var(--sp-4);
  padding: 0 var(--sp-1);
}

.photo-guide-title {
  font-family: var(--font-serif);
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--text);
}

.photo-guide-row {
  display: flex;
  gap: var(--sp-3);
  margin-top: var(--sp-2);
  color: var(--body);
  font-size: var(--fs-mini);
}

/* BUG-UI65：静态拍照建议改为纯文字，避免看起来能点 */
.photo-guide-row text {
  flex: 1;
  padding: 0;
  text-align: left;
}

/* ── 对话问诊 + 上次检查 ── */
.home-pair {
  margin-top: var(--sp-4);
  display: flex;
  align-items: stretch;
  gap: var(--sp-2);
  padding-top: var(--sp-4);
}

.pair-card {
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  min-height: 236rpx;
  padding: var(--sp-3) var(--sp-3) var(--sp-2);
  border-radius: var(--r-md);
  background: var(--card);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
  transition: transform var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
}

.pair-card-record { background: var(--surface-sunk); }

.pair-card:active {
  transform: translateY(2rpx);
  box-shadow: var(--shadow-card-press);
}

.pair-title {
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text);
  line-height: 1.3;
  white-space: nowrap;
}

.pair-sub {
  margin-top: 16rpx;
  font-size: var(--fs-caption);
  color: var(--body);
  line-height: 1.4;
}

.pair-meta {
  flex: none;
  margin-top: var(--sp-1);
  font-size: var(--fs-mini);
  color: var(--body);
  line-height: 1.2;
}

.pair-disease {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.pair-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-1);
  margin-top: auto;
  padding-top: 16rpx;
}

.pair-action {
  margin-top: auto;
  padding-top: 16rpx;
  color: var(--brand-dark);
  font-size: var(--fs-mini);
  font-weight: 600;
  line-height: 1.3;
}

/* 纯文字链接：伪元素扩热区，不动盒模型（BUG-UI5b） */
.pair-link {
  position: relative;
  flex: none;
  font-size: var(--fs-mini);
  color: var(--brand-dark);
  font-weight: 600;
}

.pair-link::after {
  content: "";
  position: absolute;
  top: -18rpx;
  right: -16rpx;
  bottom: -18rpx;
  left: -16rpx;
}

.pair-card-empty .pair-sub { color: var(--muted); }

@media (prefers-color-scheme: dark) {
  .pair-card { background: #28241E; }
  .pair-action { color: #E3AD8D; }
}

@media (prefers-reduced-motion: reduce) {
  .pair-card, .photo-card { transition-duration: 0ms; }
}

/* 今日护理：鼠尾草浅底，无竖条 */
.care-tip {
  margin-top: var(--sp-2);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  background: var(--sage-soft);
  color: var(--body);
  font-size: var(--fs-mini);
  line-height: 1.5;
}

.care-tip-label {
  margin-right: var(--sp-2);
  /* --sage 在 --sage-soft 上只有 3.6:1，小字改用 --body 提对比（BUG-UI4） */
  color: var(--body);
  font-weight: 700;
}

/* ── 拍照流程顶栏 ── */

.capture-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}

.capture-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  width: 140rpx;
  font-size: var(--fs-body);
  color: var(--body);
}

.capture-back:active { opacity: 0.6; }

.capture-topbar-title {
  font-family: var(--font-serif);
  font-size: var(--fs-heading);
  font-weight: 700;
  color: var(--text);
}

.capture-topbar-spacer { width: 140rpx; }

/* ── 步骤标题 ── */
.step-head {
  display: flex;
  align-items: baseline;
  gap: var(--sp-2);
  margin-top: var(--sp-6);
}

.step-no { font-size: var(--fs-heading); }

.step-title {
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text);
}

.step-side {
  margin-left: auto;
  font-size: var(--fs-caption);
  color: var(--muted);
}

/* 纯文字操作：用伪元素把命中区撑到 88rpx，不动盒模型
   （BUG-UI5b：之前用负 margin 扩热区，在 align-items:baseline 的父容器里会把基线拉偏） */
.step-side-link {
  position: relative;
  color: var(--brand-dark);
  font-weight: 600;
}

.step-side-link::after {
  content: "";
  position: absolute;
  top: -22rpx;
  right: -12rpx;
  bottom: -22rpx;
  left: -12rpx;
}

.step-desc {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--muted);
}

/* ── 无图引导区 — 奶白卡 + 构图示意 ── */
.capture-hero {
  margin-top: var(--sp-3);
  padding: var(--sp-3) var(--sp-3) var(--sp-4);
  border-radius: var(--r-md);
  background: var(--card);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.capture-hero:active { opacity: 0.9; }

.capture-frame {
  width: 100%;
  height: 260rpx;
  padding: 24rpx;
  border-radius: var(--r-sm);
  background: var(--surface-strong);
  box-sizing: border-box;
}

.capture-frame-inner {
  width: 100%;
  height: 100%;
  border: 2rpx solid rgba(93, 79, 63, 0.42);
  border-radius: var(--r-xs);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  box-sizing: border-box;
}

.capture-frame-label {
  font-size: var(--fs-mini);
  color: var(--body);
}

.capture-frame-guide {
  font-family: var(--font-serif);
  font-size: var(--fs-heading);
  font-weight: 700;
  color: var(--text);
}

@media (prefers-color-scheme: dark) {
  .capture-frame-inner { border-color: rgba(242, 236, 224, 0.42); }
}

.capture-hero-title {
  margin-top: var(--sp-3);
  font-family: var(--font-serif);
  font-size: var(--fs-heading);
  font-weight: 700;
  color: var(--text);
}

.capture-hero-desc {
  margin-top: 8rpx;
  max-width: 480rpx;
  font-size: var(--fs-caption);
  color: var(--muted);
  line-height: 1.5;
}

.capture-hero-btn {
  margin-top: var(--sp-3);
  padding: var(--sp-3) var(--sp-6);
  border-radius: var(--r-sm);
  background: var(--brand);
  color: var(--on-brand);
  font-size: var(--fs-body);
  font-weight: 600;
}

/* ── 三列照片卡 ── */
.shot-grid {
  margin-top: var(--sp-3);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-2);
}

.shot-photo {
  position: relative;
  height: 232rpx;
  border-radius: var(--r-sm);
  overflow: hidden;
  background: var(--surface);
}

.shot-image {
  width: 100%;
  height: 100%;
  display: block;
}

.shot-badge {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  padding: 4rpx var(--sp-2);
  border-radius: var(--r-xs);
  /* --on-brand @92%（微信 WXSS 不支持 8 位 hex，用 rgba） */
  background: rgba(251, 245, 236, 0.92);
  color: var(--text);
  font-size: var(--fs-mini);
  font-weight: 600;
}

/* 选中态用奶白字而非纯白，避免与暖色板不同源（BUG-UI6） */
.shot-badge.is-boxed {
  background: var(--sage);
  color: var(--on-brand);
}

.shot-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  /* 视觉 44rpx 圆，热区靠 padding 撑到 88rpx（BUG-UI5） */
  width: 88rpx;
  height: 88rpx;
  margin: -22rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.shot-remove::before {
  content: "";
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--scrim);
}

.shot-remove-icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}

.shot-quality {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  padding: 4rpx var(--sp-1);
  border-radius: var(--r-xs);
  background: var(--accent-soft);
  color: var(--accent);
  font-size: var(--fs-mini);
  font-weight: 600;
}

.shot-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--sp-1);
  padding: 0 4rpx;
  font-size: var(--fs-caption);
}

.shot-role { color: var(--muted); }
.shot-role.is-set { color: var(--text); font-weight: 600; }

/* 纯文字操作，命中区用伪元素撑到 88rpx（BUG-UI5b） */
.shot-lasso {
  position: relative;
  color: var(--brand-dark);
  font-weight: 600;
}

.shot-lasso::after {
  content: "";
  position: absolute;
  top: -26rpx;
  right: -16rpx;
  bottom: -26rpx;
  left: -16rpx;
}

.shot-add {
  height: 232rpx;
  border-radius: var(--r-sm);
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--muted);
}

.shot-add:active { opacity: 0.8; }

/* ── 表单：标签 + 选项，同一行 ── */
.form-row {
  display: flex;
  align-items: flex-start;
  margin-top: var(--sp-3);
}

.form-label {
  flex: none;
  width: 124rpx;
  padding-top: var(--sp-2);
  font-size: var(--fs-caption);
  color: var(--muted);
}

.choice-row {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
}

.choice {
  min-height: 60rpx;
  padding: 0 var(--sp-3);
  border-radius: var(--r-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  color: var(--body);
  font-size: var(--fs-caption);
  box-sizing: border-box;
  transition: background var(--dur-fast) ease, color var(--dur-fast) ease;
}

.choice.selected {
  background: var(--ink);
  color: var(--on-ink);
  font-weight: 600;
}

.part-grid {
  margin-top: var(--sp-3);
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--sp-1);
}

.part-grid .choice { padding: 0; }

/* BUG-UI8：原先用 --card 作底，在纸色页面上对比仅 1.06:1，几乎看不出是输入框；
   改回与 .choice / .vet-input 一致的 --surface。 */
.clinical-textarea {
  width: 100%;
  min-height: 170rpx;
  margin-top: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-sm);
  background: var(--surface);
  color: var(--text);
  font-size: var(--fs-body);
  line-height: 1.6;
  box-sizing: border-box;
}

.textarea-placeholder { color: var(--muted); }

/* ── 底部提交栏 — 浮起面板（与 result/chat 底栏统一） ── */
/* BUG-UI56（真机）：拍照流程里底栏已被收起（index.js 的 _syncTabBar），
   提交栏不再需要为它让位，只保留自身安全区即可。 */
.submit-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: var(--sp-3) var(--vet-page-x) calc(var(--sp-2) + env(safe-area-inset-bottom));
  background: var(--bg);
  box-shadow: var(--shadow-bar);
  box-sizing: border-box;
}

.submit-progress-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.submit-steps {
  display: flex;
  gap: var(--sp-1);
  flex: none;
}

.submit-step {
  width: 32rpx;
  height: 12rpx;
  border-radius: var(--r-xs);
  background: var(--surface-strong);
  transition: background var(--dur-base) var(--ease-standard);
}

.submit-step.on { background: var(--brand); }

.submit-hint-inline {
  flex: 1;
  min-width: 0;
  color: var(--muted);
  font-size: var(--fs-caption);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  font-size: var(--fs-heading);
}

.submit-btn[disabled] {
  opacity: 0.4;
  background: var(--brand);
  color: var(--on-brand);
}

/* BUG-UI4：--faint 在纸底上只有 2.51:1，免责提示改用 --muted（3.34:1） */
.submit-disclaimer {
  margin-top: var(--sp-1);
  color: var(--muted);
  text-align: center;
  font-size: var(--fs-mini);
}

/* ── 分析中遮罩 ── */
.analyzing-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--overlay);
}

/* 遮罩里的加载卡：限宽 + 居中，不再依赖 .vet-loading-card 的固定 560rpx */
.analyzing-card {
  width: 560rpx;
  max-width: calc(100vw - 96rpx);
  margin: 0 auto;
}

.analyzing-photo {
  display: block;
  width: 100%;
  height: 240rpx;
  margin-bottom: var(--sp-3);
  border-radius: var(--r-sm);
}
/* BUG-UI73：清单循环往返滚动；遮罩移除时 CSS 动画自动停止。 */
.analyzing-steps {
  margin: var(--sp-3) 0;
  height: 112rpx;
  overflow: hidden;
}
.analyzing-steps-track {
  animation: analyzingChecklistScroll 4s ease-in-out infinite alternate;
}
@keyframes analyzingChecklistScroll {
  0%, 15% { transform: translateY(0); }
  85%, 100% { transform: translateY(-112rpx); }
}
.analyzing-step {
  position: relative;
  padding-left: 40rpx;
  height: 56rpx;
  line-height: 56rpx;
  color: var(--muted);
  font-size: var(--fs-caption);
}
.analyzing-step::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--surface-strong);
}
.analyzing-step.is-current { color: var(--text); font-weight: 600; }
.analyzing-step.is-current::before { background: var(--brand); }
.analyzing-step.is-done { color: var(--body); }
.analyzing-step.is-done::before { background: var(--sage); }
