.assessment-report{color:#29251f;padding:28rpx 0;line-height:1.65}.assessment-title{font-size:40rpx;font-weight:600;margin-bottom:20rpx}.assessment-risk{padding:24rpx;border-radius:16rpx;background:#f2e2d4;color:#754c30;font-size:30rpx}.assessment-scope{margin-top:28rpx;padding:24rpx;background:#fffaf2;border-radius:18rpx}.scope-label{font-size:30rpx;font-weight:600}.scope-coverage,.reference-note{font-size:24rpx;color:#756b5d;margin-top:12rpx}.assessment-candidate{padding-top:24rpx;margin-top:24rpx}.candidate-order{color:#a65237;font-size:24rpx}.candidate-name{font-size:34rpx;font-weight:600}.field-label{font-size:26rpx;font-weight:600;margin-top:20rpx}.assessment-text{font-size:28rpx;white-space:pre-wrap;word-break:break-all}.assessment-limit{font-size:25rpx;color:#756b5d;margin-top:16rpx}.assessment-button{margin-top:24rpx;background:#3d392f;color:#fffaf2;border-radius:14rpx;font-size:30rpx}.assessment-button.secondary{background:#e8dfcf;color:#3d392f}

.assessment-next{margin-top:24rpx;padding:24rpx;border-radius:16rpx;background:#fffaf2;font-size:28rpx;color:#754c30;line-height:1.65}
.assessment-button{width:100%;box-sizing:border-box;line-height:1.6;padding:18rpx 24rpx}
