/* ═══════════════════════════════════════════
   Lesion Selector Component — VetAI DS v7
   患处圈选浮层（index / chat 共用）
   ═══════════════════════════════════════════ */

:host {
  display: contents;
}

.lesion-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: var(--overlay);
}

.lesion-sheet {
  width: 100%;
  height: 92vh;
  padding: var(--sp-3) var(--sp-3) calc(var(--sp-3) + env(safe-area-inset-bottom));
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  background: var(--bg);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.lesion-top {
  display: flex;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
  flex-shrink: 0;
}

/* 热区 88rpx，视觉圆仍是 56rpx（BUG-UI5） */
.lesion-close {
  width: 88rpx;
  height: 88rpx;
  margin: -16rpx -16rpx 0 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.lesion-close::before {
  content: "";
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--card);
}

.lesion-close image { position: relative; }

.lesion-close:active { opacity: 0.7; }

.lesion-toolbar {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  margin-bottom: var(--sp-2);
  flex-shrink: 0;
}

/* 用设计系统的 --dur-fast/--ease-standard，不再写裸的 0.15s ease（BUG-UI42） */
.tool-chip {
  display: inline-flex;
  align-items: center;
  min-height: 60rpx;
  padding: 0 var(--sp-3);
  border-radius: var(--r-xs);
  background: var(--surface);
  color: var(--body);
  font-size: var(--fs-caption);
  transition: background var(--dur-fast) var(--ease-standard),
              color var(--dur-fast) var(--ease-standard);
}

.tool-chip:active { opacity: 0.8; }

.tool-chip-on {
  background: var(--ink);
  color: var(--on-ink);
  font-weight: 600;
}

.tool-stat {
  padding: var(--sp-1) var(--sp-2);
  color: var(--muted);
  font-size: var(--fs-caption);
  margin-left: auto;
}

.lesion-stage {
  position: relative;
  overflow: hidden;
  width: 100%;
  flex: 1;
  min-height: 320rpx;
  border-radius: var(--r-md);
  background: var(--stage-dark);
}

.lesion-image,
.lesion-canvas,
.lesion-grid {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.lesion-grid {
  background:
    linear-gradient(90deg, var(--grid-line-onstage) 1rpx, transparent 1rpx),
    linear-gradient(0deg, var(--grid-line-onstage) 1rpx, transparent 1rpx);
  background-size: 20% 20%;
}

.lesion-canvas {
  z-index: 3;
}

.lesion-tip {
  display: flex;
  justify-content: space-between;
  gap: var(--sp-2);
  margin: var(--sp-2) var(--sp-1) var(--sp-2);
  color: var(--muted);
  font-size: var(--fs-caption);
  flex-shrink: 0;
}

.lesion-tip text:first-child {
  color: var(--brand-dark);
  font-weight: 700;
}

.lesion-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-1);
  flex-shrink: 0;
}

/* 主按钮走 .vet-btn 的 96rpx 基线，不再单独压到 88rpx（BUG-UI43） */
.lesion-save-main {
  grid-column: 1 / -1;
  width: 100%;
}

/* 未圈出有效区域时按钮降级，不再是一颗看着能点的实心陶土主按钮（BUG-UI44） */
.lesion-save-main[disabled] {
  background: var(--surface-strong);
  color: var(--muted);
  opacity: 1;
}
