/* 自定义 tabBar 不继承 page 令牌。此处使用组件内的颜色，确保材质在模拟器里真实渲染。 */
.tab-bar {
  padding: 8rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.tab-shell {
  position: relative;
  display: flex;
  height: 108rpx;
  border: 1rpx solid rgba(34, 30, 24, 0.08);
  border-radius: 999rpx;
  box-sizing: border-box;
  /* BUG-UI68：底栏、弹层与输入框统一为实心纸卡 */
  background: #FFFDF8;
  box-shadow: 0 8rpx 24rpx rgba(34, 30, 24, 0.1);
  overflow: hidden;
}

.tab-lens {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 5rpx;
  width: calc(33.333% - 10rpx);
  border: none;
  border-radius: 999rpx;
  box-sizing: border-box;
  background: #F5E3D7;
  box-shadow: none;
  transform-origin: center;
  transition: none;
  pointer-events: none;
}





.tab-lens.lens-1 { left: calc(33.333% + 5rpx); }
.tab-lens.lens-2 { left: calc(66.666% + 5rpx); }

/* BUG-UI74：只在当前页面播放一次，目标页直接定位，避免重复滑动和回闪。 */
.tab-lens.is-moving {
  animation-duration: 180ms;
  animation-timing-function: cubic-bezier(0.18, 0.82, 0.22, 1);
  animation-fill-mode: both;
}
.tab-lens.slide-0-1 { animation-name: lens0To1; }
.tab-lens.slide-0-2 { animation-name: lens0To2; }
.tab-lens.slide-1-0 { animation-name: lens1To0; }
.tab-lens.slide-1-2 { animation-name: lens1To2; }
.tab-lens.slide-2-0 { animation-name: lens2To0; }
.tab-lens.slide-2-1 { animation-name: lens2To1; }
@keyframes lens0To1 { from { left: 5rpx; } to { left: calc(33.333% + 5rpx); } }
@keyframes lens0To2 { from { left: 5rpx; } to { left: calc(66.666% + 5rpx); } }
@keyframes lens1To0 { from { left: calc(33.333% + 5rpx); } to { left: 5rpx; } }
@keyframes lens1To2 { from { left: calc(33.333% + 5rpx); } to { left: calc(66.666% + 5rpx); } }
@keyframes lens2To0 { from { left: calc(66.666% + 5rpx); } to { left: 5rpx; } }
@keyframes lens2To1 { from { left: calc(66.666% + 5rpx); } to { left: calc(33.333% + 5rpx); } }


.tab-item {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  transition: transform 180ms ease;
}

.tab-item:active { transform: scale(0.96); }

.tab-item.on .tab-icon-box { transform: translateY(-3rpx) scale(1.08); }

@media (prefers-reduced-motion: reduce) {
  .tab-lens, .tab-item, .tab-text, .tab-icon-box { transition-duration: 0ms; }
}

.tab-icon-box {
  width: 52rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 260ms cubic-bezier(0.18, 0.82, 0.22, 1);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  font-size: 22rpx;
  line-height: 1.25;
  color: #4F483E;
  transition: color 220ms ease;
}

.tab-text.on {
  color: #9F4A2B;
  font-weight: 700;
}

@media (prefers-color-scheme: dark) {
  .tab-shell {
    background: #26221C;
    border-color: rgba(242, 236, 224, 0.1);
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.32);
  }
  .tab-lens {
    background: #3B2A21;
    border: none;
    box-shadow: none;
  }
  .tab-text { color: #D7CEC0; }
  .tab-text.on { color: #F2ECE0; }
}
