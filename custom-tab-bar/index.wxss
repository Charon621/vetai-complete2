/* v6 底栏 — 白底细线，选中宋体墨字 + 青柠短横线展开动画
   组件不继承 page 上的 CSS 变量：在 :host 按 v6 令牌落值（与 app.wxss 同步维护），
   组件内部一律引用 var(--*)，禁止直接写色值。 */
:host {
  --card: #FFFFFF;
  --line-light: #ECE8DC;
  --shadow-bar: 0 -16rpx 40rpx rgba(15, 31, 26, 0.06);
  --ghost: #9AA69F;
  --text: #0F1F1A;
  --lime: #D6F25F;
  --font-serif: 'Songti SC', 'STSong', 'Source Han Serif SC', Georgia, serif;
  --dur-base: 240ms;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-bar {
  display: flex;
  background: var(--card);
  border-top: 1rpx solid var(--line-light);
  box-shadow: var(--shadow-bar);
  padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom));
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.tab-item:active { opacity: 0.75; }

.tab-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ghost);
  line-height: 1.2;
  transition: color var(--dur-base) var(--ease-out);
}

.tab-text.on {
  color: var(--text);
  font-family: var(--font-serif);
  font-weight: 900;
}

.tab-underline {
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--lime);
  transform: scaleX(0);
  transform-origin: center;
  transition: transform var(--dur-base) var(--ease-out);
}

.tab-underline.show {
  transform: scaleX(1);
}
