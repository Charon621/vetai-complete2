<view class="tab-bar">
  <view class="tab-item" wx:for="{{list}}" wx:key="pagePath" data-index="{{index}}" bindtap="switchTab">
    <text class="tab-text {{selected === index ? 'on' : ''}}">{{item.text}}</text>
    <view class="tab-underline {{selected === index ? 'show' : ''}}"></view>
  </view>
</view>
