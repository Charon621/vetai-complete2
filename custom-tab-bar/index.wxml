<view class="tab-bar" wx:if="{{!hidden && ready}}" aria-role="tablist">
  <view class="tab-shell">
    <view class="tab-lens lens-{{selected}} {{switching ? 'is-moving slide-' + slideFrom + '-' + selected : ''}}" aria-hidden="true" bindanimationend="onSlideEnd"></view>
    <view class="tab-item {{selected === index ? 'on' : ''}}" wx:for="{{list}}" wx:key="pagePath" data-index="{{index}}" bindtap="switchTab"
      aria-role="tab" aria-label="{{item.text}}" aria-selected="{{selected === index}}">
      <view class="tab-icon-box">
        <image class="tab-icon" src="{{selected === index ? item.iconOn : item.icon}}" mode="aspectFit" />
      </view>
      <text class="tab-text {{selected === index ? 'on' : ''}}">{{item.text}}</text>
    </view>
  </view>
</view>
