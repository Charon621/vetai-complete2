/* ============================================================
 * VetAI Design System v7 — 「暖阳 · 衬线」
 * 暖纸底 #F7F3EA · 陶土主色 #BF5E3B · 赭黄 / 鼠尾草 / 墨色
 * 不用分割线：层次只靠留白、底色深浅和卡片；小圆角为主，
 * 曲线只留给头像、拱窗、对话气泡等有意义的位置。
 * 标题 / 病名 / 结论用宋体，AI 回复与界面操作用黑体。
 * 图标统一走 assets/icons（Phosphor，tools/build-icons.js 生成）。
 * --vet-* 兼容别名全部保留（过渡层，新代码禁用）。
 * ============================================================ */

page {
  /* ── 1. 品牌色：陶土 ── */
  --brand: #BF5E3B;
  --brand-dark: #9F4A2B;
  --brand-light: #F5E3D7;
  --brand-mid: #D08A6E;
  --on-brand: #FBF5EC;
  /* 0.78 时对 --brand 只有 2.66:1，小字读不清；0.92 提到 3.6:1 以上（BUG-UI1） */
  --on-brand-muted: rgba(251, 245, 236, 0.92);

  /* ── 1b. 墨色：选中态 / 次主按钮 ── */
  --ink: #221E18;
  --on-ink: #F7F3EA;

  /* ── 1c. 赭黄 / 鼠尾草：提示与状态，不做动作色 ── */
  --ochre: #C4912F;
  --ochre-text: #8A6114;
  --ochre-soft: #F4E7CB;
  --sage: #62805A;
  --sage-soft: #E4EADC;

  /* 旧令牌映射到新色板（lime/gold 已退役，保留变量名防止漏改页面失色） */
  --lime: var(--brand);
  --lime-soft: var(--brand-light);
  --on-lime: var(--on-brand);
  --gold: var(--ochre-text);
  --gold-bright: var(--ochre);
  --gold-line: rgba(196, 145, 47, 0.4);
  --gold-mist: rgba(196, 145, 47, 0.1);

  /* ── 2. 强调色：仅用于警示 / 紧急 ── */
  --accent: #9C3A25;
  --accent-soft: #F2DCD3;

  /* ── 3. 中性色：暖纸底 + 奶白卡片 ── */
  --bg: #F7F3EA;
  --card: #FFFDF8;
  --surface: #EFE8DA;
  --surface-strong: #E7DECC;
  --text: #221E18;
  --body: #4F483E;
  --muted: #8C8475;
  --faint: #A39A89;
  --ghost: #B3AA99;
  --line: #E7DECC;
  --line-light: #EFE8DA;

  /* ── 4. 圆角：标签 8 / 控件 12 / 卡片 20 / 舞台 28；气泡独立 ── */
  --r-xs: 8rpx;
  --r-sm: 12rpx;
  --r-md: 20rpx;
  --r-lg: 28rpx;
  --r-bubble: 32rpx;
  --r-bubble-tip: 8rpx;

  /* ── 5. 阴影：只给浮起元素（底栏 / 弹层 / 输入框） ── */
  --shadow-sm: 0 2rpx 8rpx rgba(34, 30, 24, 0.04);
  --shadow-md: 0 8rpx 24rpx rgba(34, 30, 24, 0.06);
  --shadow-lg: 0 16rpx 48rpx rgba(34, 30, 24, 0.12);
  --shadow-bar: 0 -20rpx 48rpx rgba(34, 30, 24, 0.06);
  /* BUG-UI60：卡片与纸色底接近，用细描边显出边缘并统一阴影 */
  --card-edge: rgba(34, 30, 24, 0.08);
  --shadow-card: 0 0 0 1rpx var(--card-edge), 0 4rpx 12rpx rgba(34, 30, 24, 0.04);
  --shadow-card-press: 0 0 0 1rpx var(--card-edge);
  --surface-sunk: #EDE6D9;

  /* ── 5b. 遮罩与叠加色 ── */
  --overlay: rgba(34, 30, 24, 0.66);
  --scrim: rgba(34, 30, 24, 0.5);
  --brand-overlay: rgba(159, 74, 43, 0.86);
  --on-overlay: #FFFFFF;
  --brand-mist: rgba(191, 94, 59, 0.06);
  --brand-mist-strong: rgba(191, 94, 59, 0.14);
  --gold-line-onbrand: rgba(251, 245, 236, 0.5);
  --gold-line-onbrand-inner: rgba(251, 245, 236, 0.35);
  --accent-mist: rgba(156, 58, 37, 0.07);
  --accent-line: rgba(156, 58, 37, 0.35);
  --brand-focus-ring: rgba(191, 94, 59, 0.12);
  --stage-dark: #1C1915;
  --grid-line-onstage: rgba(255, 255, 255, 0.06);

  /* ── 5c. 动效令牌：全局统一节奏 ── */
  --dur-fast: 160ms;
  --dur-base: 240ms;
  --dur-slow: 360ms;
  --ease-standard: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);

  /* ── 6. 间距：8pt 栅格 ── */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 40rpx;
  --sp-6: 48rpx;
  --sp-8: 64rpx;
  --sp-10: 80rpx;

  /* ── 7. 字号阶梯（页面一律引用这里，不要再写裸 rpx） ── */
  --fs-hero: 64rpx;
  --fs-display: 48rpx;
  --fs-title: 34rpx;
  --fs-heading: 30rpx;
  --fs-body: 28rpx;
  --fs-caption: 24rpx;
  --fs-mini: 22rpx;

  /* ── 7b. 字体族（BUG-UI58：真机两端对齐）
     安卓真机没有中文衬线，也不认 -apple-system / PingFang / Songti，
     靠系统栈会整套掉回黑体，和开发者工具里看到的不一致。
     所以把思源宋体子集内置进来（utils/fontData.js），由 app.js 启动时
     用 wx.loadFontFace 加载成 'VetAISerif'，这里排在系统字体前面。
     加载失败时后面的系统字体照常生效，不会影响可读性。 ── */
  --font-serif-base: 'VetAISerif', 'Songti SC', 'STSong', 'Songti TC',
                     'Noto Serif CJK SC', 'Source Han Serif CN', 'Noto Serif SC',
                     Georgia, 'Source Han Sans CN', 'Noto Sans CJK SC',
                     'PingFang SC', serif;
  --font-serif: var(--font-serif-base);
  --font-sans: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'HarmonyOS Sans SC',
               'Source Han Sans CN', 'Noto Sans CJK SC', 'Noto Sans SC',
               'Microsoft YaHei', 'Helvetica Neue', Arial, sans-serif;
  --font-mono: 'VetAISerif', 'Songti SC', 'Noto Serif CJK SC',
               'SF Mono', Menlo, Consolas, monospace;
  --font-kai: 'KaiTi', 'STKaiti', 'AR PL UKai', 'Songti SC', 'Noto Serif CJK SC', serif;

  /* ── 8. 严重度语义色 ── */
  --sev-low: #62805A;
  --sev-mid: #C4912F;
  --sev-mid-text: #8A6114;
  --sev-urgent: #BF5E3B;
  --sev-emergency: #9C3A25;
  --sev-low-bg: #E4EADC;
  --sev-mid-bg: #F4E7CB;
  --sev-urgent-bg: #F5E3D7;
  --sev-emergency-bg: #F2DCD3;
  /* 结论面板渐变的中段停靠色：深浅两档令牌之间的过渡色，统一在这里定义（BUG-UI20） */
  --sev-low-mid: #EEF1E6;
  --sev-mid-mid: #F8EFDC;
  --sev-urgent-mid: #F7E9DE;
  --sev-emergency-mid: #F5E2DA;

  /* ── 9. 向后兼容：--vet-* 别名（勿删，各页 wxss 在用） ── */
  --vet-primary: var(--brand);
  --vet-primary-dark: var(--brand-dark);
  --vet-primary-soft: var(--brand-light);
  --vet-primary-mid: var(--brand-mid);
  --vet-accent: var(--accent);
  --vet-accent-soft: var(--accent-soft);
  --vet-bg: var(--bg);
  --vet-card: var(--card);
  --vet-card-soft: var(--surface);
  --vet-bg-weak: var(--surface);
  --vet-text: var(--text);
  --vet-body: var(--body);
  --vet-muted: var(--muted);
  --vet-faint: var(--faint);
  --vet-line: var(--line);
  --vet-line-weak: var(--line-light);
  --vet-green: var(--brand);
  --vet-green-dark: var(--brand-dark);
  --vet-green-soft: var(--brand-light);
  --vet-green-mid: var(--brand-mid);

  --vet-low: var(--sev-low);
  --vet-low-bg: var(--sev-low-bg);
  --vet-mid: var(--sev-mid);
  --vet-mid-bg: var(--sev-mid-bg);
  --vet-vet: var(--sev-urgent);
  --vet-vet-bg: var(--sev-urgent-bg);
  --vet-emg: var(--sev-emergency);
  --vet-emg-bg: var(--sev-emergency-bg);

  --vet-r-page: var(--r-lg);
  --vet-r-card-lg: var(--r-lg);
  --vet-r-card: var(--r-md);
  --vet-r-card-sm: var(--r-sm);
  --vet-r-image: var(--r-sm);
  --vet-r-field: 999rpx;
  --vet-r-pill: 999rpx;

  --vet-shadow: var(--shadow-sm);
  --vet-shadow-strong: var(--shadow-md);

  --vet-page-x: 40rpx;
  --vet-gap-xs: var(--sp-1);
  --vet-gap: var(--sp-2);
  --vet-gap-lg: var(--sp-4);
  --vet-gap-xl: var(--sp-6);
  --vet-safe-bottom: env(safe-area-inset-bottom);

  /* ── 10. 固定底栏与操作栏的占位高度（BUG-UI2 / BUG-UI54）
     底栏自身的实际高度 = --sp-2 + 88rpx 最小热区 + --sp-2 + 安全区（约 152rpx）。
     但页面**只需要预留「不被最后一屏遮住」的高度**：底栏图标区约 96rpx，
     安全区由 env() 单独兜。原先按底栏全高（112rpx）预留，内容一短就在
     卡片和底栏之间堆出一大块死白（实测约 120rpx 纯空白）。
     取 96rpx：长页面最后一屏仍能完整滚出，短页面不再多留空。 ── */
  --tab-bar-h: 96rpx;
  --action-bar-h: 152rpx;

  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

/* ============================================================
 * 暗色模式 — 暖炭底，陶土提亮
 * （app.json 未开启 darkmode 时不会生效，保留以便日后开启）
 * ============================================================ */
@media (prefers-color-scheme: dark) {
  page {
    --bg: #1C1915;
    --card: #26221C;
    --surface: #2F2A23;
    --surface-strong: #3A342B;
    --text: #F2ECE0;
    --body: #CFC6B6;
    --muted: #9A9180;
    --faint: #857C6C;
    --ghost: #6E6657;
    --line: #3A342B;
    --line-light: #2F2A23;
    --ink: #F2ECE0;
    --on-ink: #1C1915;

    --brand: #D9774F;
    --brand-dark: #E38E6B;
    --brand-light: #3B2A21;
    --on-brand: #1C1915;
    --ochre-soft: #3A3120;
    --sage-soft: #26302A;
    --accent-soft: #3B2722;

    --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
    --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.28);
    --shadow-lg: 0 16rpx 48rpx rgba(0, 0, 0, 0.36);
    --shadow-bar: 0 -20rpx 48rpx rgba(0, 0, 0, 0.3);
    --card-edge: rgba(242, 236, 224, 0.1);
    --surface-sunk: #2E2B24;

    --sev-low-bg: #26302A;
    --sev-mid-bg: #3A3120;
    --sev-urgent-bg: #3B2A21;
    --sev-emergency-bg: #35201A;
  }
}

/* ============================================================
 * Reset
 * ============================================================ */
button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: normal;
  font: inherit;
  color: inherit;
  border-radius: 0;
}

button::after { border: none; }

input, textarea {
  color: var(--text);
  font: inherit;
}

::-webkit-scrollbar { display: none; }

/* ============================================================
 * 页面 & 卡片
 * v7 原则：不画分割线，层次靠留白 + 底色深浅 + 奶白卡片；
 * 卡片不描边，「浮起」的元素（底栏、弹层、输入框）才用阴影。
 * ============================================================ */
.vet-page {
  min-height: 100vh;
  padding: var(--sp-3) var(--vet-page-x) calc(var(--sp-6) + var(--vet-safe-bottom));
  box-sizing: border-box;
  background: var(--bg);
}

.vet-card {
  background: var(--card);
  border-radius: var(--r-md);
  padding: var(--sp-4);
  box-sizing: border-box;
}

/* ============================================================
 * 区块标题：宋体；序号用衬线常规字重陶土色
 * ============================================================ */
.vet-section-title {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.35;
}

.vet-no {
  color: var(--brand);
  font-family: var(--font-mono);
  font-style: normal;
  font-weight: 400;
}

/* ============================================================
 * 排版
 * ============================================================ */
.vet-title-xl {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: 800;
  line-height: 1.25;
}

.vet-title-lg {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.32;
}

.vet-title-md {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-heading);
  font-weight: 700;
  line-height: 1.38;
}

.vet-caption {
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.5;
}

.vet-label {
  color: var(--muted);
  font-size: var(--fs-mini);
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

/* 衬线小字元数据（日期 / 编号 / 月份 / 区块编号） */
.vet-mono-gold {
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  letter-spacing: 1rpx;
  line-height: 1.4;
}

/* ============================================================
 * 按钮：主按钮陶土实心；次按钮沙色底；墨色按钮做并列主操作
 * ============================================================ */
.vet-btn {
  min-height: 96rpx;
  padding: 0 var(--sp-4);
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  font-size: var(--fs-heading);
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: transform var(--dur-fast) var(--ease-standard),
              opacity var(--dur-fast) ease;
}

.vet-btn:active {
  transform: scale(0.985);
  opacity: 0.9;
}

.vet-btn-primary {
  background: var(--brand);
  color: var(--on-brand);
}

.vet-btn-ink {
  background: var(--ink);
  color: var(--on-ink);
}

.vet-btn-secondary {
  background: var(--surface);
  color: var(--text);
}

.vet-btn-ghost {
  background: transparent;
  color: var(--muted);
}

/* ============================================================
 * Chips：沙色底小方角，选中墨色实心
 * ============================================================ */
.vet-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 0 var(--sp-3);
  border-radius: var(--r-xs);
  background: var(--surface);
  color: var(--body);
  font-size: var(--fs-caption);
  box-sizing: border-box;
}

.vet-chip-active {
  background: var(--ink);
  color: var(--on-ink);
  font-weight: 600;
}

/* ============================================================
 * 表单
 * ============================================================ */
.vet-field { margin-top: var(--sp-3); }
.vet-field:first-child { margin-top: 0; }

.vet-field-label {
  display: block;
  margin-bottom: var(--sp-1);
  color: var(--muted);
  font-size: var(--fs-caption);
}

.vet-input,
.vet-textarea {
  width: 100%;
  border-radius: var(--r-sm);
  background: var(--surface);
  color: var(--text);
  font-size: var(--fs-body);
  box-sizing: border-box;
}

.vet-input { min-height: 88rpx; padding: 0 var(--sp-3); }

.vet-textarea {
  min-height: 176rpx;
  padding: var(--sp-2) var(--sp-3);
  line-height: 1.55;
}

/* ============================================================
 * 加载
 * ============================================================ */
.vet-loading-card {
  width: 560rpx;
  max-width: calc(100vw - 96rpx);
  padding: var(--sp-5) var(--sp-4);
  border-radius: var(--r-lg);
  background: var(--card);
  box-shadow: var(--shadow-lg);
  box-sizing: border-box;
}

.vet-loading-line {
  position: relative;
  overflow: hidden;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--surface);
}

.vet-loading-line::after {
  content: "";
  position: absolute;
  top: 0;
  left: -40%;
  width: 40%;
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, transparent, var(--brand), transparent);
  animation: vetShimmer 1.5s ease-in-out infinite;
}

/* 统一空状态：淡金雾底，居中提示 */
.vet-empty {
  padding: var(--sp-6) var(--sp-4);
  border-radius: var(--r-md);
  background: var(--card);
  color: var(--body);
  font-size: var(--fs-caption);
  line-height: 1.6;
  text-align: center;
  box-sizing: border-box;
}

.vet-empty-title {
  display: block;
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text);
  margin-bottom: var(--sp-1);
}

/* 空状态图标圆底 */
.vet-empty-icon {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto var(--sp-3);
  border-radius: 50%;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.vet-empty-icon image {
  width: 60rpx;
  height: 60rpx;
}

/* ============================================================
 * 图标：assets/icons 下的 Phosphor SVG，用 <image> 引用
 * ============================================================ */
.vet-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
  flex: none;
}

.vet-icon-sm { width: 28rpx; height: 28rpx; }
.vet-icon-lg { width: 52rpx; height: 52rpx; }

/* ============================================================
 * 动画 / 数字
 * ============================================================ */
.vet-fade-up {
  animation: vetFadeUp var(--dur-slow) var(--ease-out) both;
}

/* 交错入场：配合 vet-fade-up，区块依次延迟 40ms */
.vet-stagger-1 { animation-delay: 40ms; }
.vet-stagger-2 { animation-delay: 80ms; }
.vet-stagger-3 { animation-delay: 120ms; }
.vet-stagger-4 { animation-delay: 160ms; }
.vet-stagger-5 { animation-delay: 200ms; }

/* 骨架屏占位块：surface 底 + 扫光 */
.vet-skeleton {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-sm);
  background: var(--surface);
}

.vet-skeleton::after {
  content: "";
  position: absolute;
  top: 0;
  left: -40%;
  width: 40%;
  height: 100%;
  background: linear-gradient(90deg, transparent, var(--card), transparent);
  animation: vetShimmer 1.5s ease-in-out infinite;
}

.text-numeric {
  font-variant-numeric: tabular-nums;
  font-family: var(--font-mono);
}

.font-serif { font-family: var(--font-serif); }
.font-mono  { font-family: var(--font-mono); }

/* 严重度：只用语义文字颜色，不加装饰圆点 */
.vet-status {
  display: inline-flex;
  align-items: center;
  font-size: var(--fs-caption);
  font-weight: 600;
  white-space: nowrap;
}

.vet-status.sev-low { color: var(--sev-low); }
.vet-status.sev-moderate { color: var(--sev-mid-text); }
.vet-status.sev-urgent { color: var(--sev-urgent); }
.vet-status.sev-emergency { color: var(--sev-emergency); }

/* ============================================================
 * 印章 — 报告页「AI 初筛」，陶土双圈
 * 用法：<view class="vet-seal"><text>AI 初筛</text></view>
 * ============================================================ */
/* 零引用，待清理 */
.vet-seal {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-10deg);
  box-sizing: border-box;
  position: relative;
  opacity: 0.85;
}

.vet-seal::before {
  content: "";
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  border-radius: 50%;
  border: 2rpx dashed var(--brand-mid);
}

.vet-seal text {
  font-family: var(--font-serif);
  font-size: var(--fs-mini);
  font-weight: 700;
  color: var(--brand);
  text-align: center;
  line-height: 1.25;
}

@keyframes vetFadeUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes vetShimmer {
  0% { left: -40%; }
  100% { left: 100%; }
}
