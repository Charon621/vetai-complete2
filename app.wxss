/* ============================================================
 * VetAI Design System v5 — 「处方笺」诊室编辑风 × 鎏金
 * 暖纸白底 #FBFAF6 · 墨绿 #113B31 · 青柠动作色 #D6F25F
 * 鎏金双档：文字金 #8A6518（小字达标）/ 装饰金 #C9A24B（印章描边）
 * 宋体 900 大标题 · 等宽鎏金小字 · 墨线分区 · 鎏金印章
 * --vet-* 兼容别名全部保留（过渡层，新代码禁用），
 * 各页面不改一行 wxss 即可整体换肤。
 * ============================================================ */

page {
  /* ── 1. 品牌色体系 — 墨绿（诊室信任感） ── */
  --brand: #113B31;
  --brand-dark: #0C2A23;
  --brand-light: #EAF3E2;
  --brand-mid: #5E7A70;

  /* ── 1b. 动作色：青柠 — 只给「可点的动作」 ── */
  --lime: #D6F25F;
  --lime-soft: rgba(214, 242, 95, 0.22);
  --on-lime: #113B31;

  /* ── 1c. 鎏金双档：文字金（小字）/ 装饰金（印章、描边） ── */
  --gold: #8A6518;
  --gold-bright: #C9A24B;
  --gold-line: rgba(138, 101, 24, 0.45);
  /* 淡金雾：非动作提示底色（替代青柠的装饰性误用） */
  --gold-mist: rgba(138, 101, 24, 0.08);

  /* ── 2. 强调色：珊瑚（仅用于警示/紧急） ── */
  --accent: #C9553E;
  --accent-soft: #F7E4DD;

  /* ── 3. 中性色体系：暖纸白 + 纯白卡片浮于纸面 ── */
  --bg: #FBFAF6;
  --card: #FFFFFF;
  --surface: #F3F0E8;
  --text: #0F1F1A;
  --body: #4A443A;
  --muted: #5F6B64;
  --faint: #8C8471;
  --ghost: #9AA69F;
  --line: #E2DCCB;
  --line-light: #ECE8DC;
  --on-brand: #F2F7EF;
  --on-brand-muted: rgba(242, 247, 239, 0.7);

  /* ── 4. 圆角三档：内容卡 24rpx，舞台级（主卡/抽屉/底栏）40rpx；
          气泡 28rpx + 8rpx 小角不对称（对话感，独立令牌）；胶囊 999rpx ── */
  --r-sm: 12rpx;
  --r-md: 24rpx;
  --r-lg: 40rpx;
  --r-bubble: 28rpx;
  --r-bubble-tip: 8rpx;

  /* ── 5. 阴影：只给浮起元素（弹层/底栏）用 ── */
  --shadow-sm: 0 1rpx 4rpx rgba(15, 31, 26, 0.03);
  --shadow-md: 0 4rpx 12rpx rgba(15, 31, 26, 0.05);
  --shadow-lg: 0 8rpx 28rpx rgba(15, 31, 26, 0.08);
  --shadow-bar: 0 -16rpx 40rpx rgba(15, 31, 26, 0.06);

  /* ── 5b. 遮罩与叠加色：浮层/图片上的半透明层一律走这里 ── */
  --overlay: rgba(15, 31, 26, 0.72);
  --scrim: rgba(15, 31, 26, 0.55);
  --brand-overlay: rgba(17, 59, 49, 0.85);
  --on-overlay: #FFFFFF;
  --brand-mist: rgba(17, 59, 49, 0.06);
  --brand-mist-strong: rgba(17, 59, 49, 0.15);
  --gold-line-onbrand: rgba(217, 175, 98, 0.55);
  --gold-line-onbrand-inner: rgba(217, 175, 98, 0.45);
  --accent-mist: rgba(201, 85, 62, 0.07);
  --accent-line: rgba(201, 85, 62, 0.4);
  --brand-focus-ring: rgba(17, 59, 49, 0.08);
  --stage-dark: #1A1A1A;                       /* 圈选/看图的深色舞台底 */
  --grid-line-onstage: rgba(255, 255, 255, 0.06); /* 深色舞台上的参考网格线 */

  /* ── 5c. 动效令牌：全局统一节奏 ── */
  --dur-fast: 160ms;
  --dur-base: 240ms;
  --dur-slow: 360ms;
  --ease-standard: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);

  /* ── 6. 间距：8pt 栅格 ── */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 40rpx;
  --sp-6: 48rpx;
  --sp-8: 64rpx;
  --sp-10: 80rpx;

  /* ── 7. 字号六档阶梯：68 仅首页问候 / 44 页头结论 / 30 区块 / 28 正文 / 24 辅助 / 21 元数据下限 ── */
  --fs-hero: 68rpx;
  --fs-display: 44rpx;
  --fs-title: 30rpx;
  --fs-body: 28rpx;
  --fs-caption: 24rpx;
  --fs-mini: 21rpx;

  /* ── 7b. 字体族：宋体大标题 + 等宽元数据是 v4 视觉核心 ── */
  --font-sans: -apple-system, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  --font-serif: 'Songti SC', 'STSong', 'Source Han Serif SC', Georgia, serif;
  --font-mono: 'SF Mono', 'Menlo', 'Roboto Mono', 'Courier New', monospace;
  --font-kai: 'KaiTi', 'STKaiti', 'AR PL UKai', serif;

  /* ── 8. 严重度语义色 ── */
  --sev-low: #3E7D5C;
  --sev-mid: #B97F35;
  --sev-mid-text: #8A5A00;
  --sev-urgent: #C9553E;
  --sev-emergency: #A03D2B;
  --sev-low-bg: #E3F0E6;
  --sev-mid-bg: #FFE9B8;
  --sev-urgent-bg: #F7E4DD;
  --sev-emergency-bg: #F2DCD6;

  /* ── 9. 向后兼容：--vet-* 别名（勿删，各页 wxss 在用） ── */
  --vet-primary: var(--brand);
  --vet-primary-dark: var(--brand-dark);
  --vet-primary-soft: var(--brand-light);
  --vet-primary-mid: var(--brand-mid);
  --vet-accent: var(--accent);
  --vet-accent-soft: var(--accent-soft);
  --vet-bg: var(--bg);
  --vet-card: var(--card);
  --vet-card-soft: var(--surface);
  --vet-bg-weak: var(--surface);
  --vet-text: var(--text);
  --vet-body: var(--body);
  --vet-muted: var(--muted);
  --vet-faint: var(--faint);
  --vet-line: var(--line);
  --vet-line-weak: var(--line-light);
  --vet-green: var(--brand);
  --vet-green-dark: var(--brand-dark);
  --vet-green-soft: var(--brand-light);
  --vet-green-mid: var(--brand-mid);

  --vet-low: var(--sev-low);
  --vet-low-bg: var(--sev-low-bg);
  --vet-mid: var(--sev-mid);
  --vet-mid-bg: var(--sev-mid-bg);
  --vet-vet: var(--sev-urgent);
  --vet-vet-bg: var(--sev-urgent-bg);
  --vet-emg: var(--sev-emergency);
  --vet-emg-bg: var(--sev-emergency-bg);

  --vet-r-page: var(--r-lg);
  --vet-r-card-lg: var(--r-lg);
  --vet-r-card: var(--r-md);
  --vet-r-card-sm: var(--r-sm);
  --vet-r-image: var(--r-sm);
  --vet-r-field: 999rpx;
  --vet-r-pill: 999rpx;

  --vet-shadow: var(--shadow-sm);
  --vet-shadow-strong: var(--shadow-md);

  --vet-page-x: 44rpx;
  --vet-gap-xs: var(--sp-1);
  --vet-gap: var(--sp-2);
  --vet-gap-lg: var(--sp-4);
  --vet-gap-xl: var(--sp-6);
  --vet-safe-bottom: env(safe-area-inset-bottom);

  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

/* ============================================================
 * 暗色模式 — 墨绿深底，青柠/鎏金提亮
 * ============================================================ */
@media (prefers-color-scheme: dark) {
  page {
    --bg: #101B16;
    --card: #182620;
    --surface: #202E27;
    --text: #F0F4EE;
    --body: #C6CCC2;
    --muted: #8C978F;
    --faint: #7A8378;
    --ghost: #5D6862;
    --line: #2A3A33;
    --line-light: #22312A;
    --on-brand: #F2F7EF;
    --on-brand-muted: rgba(242, 247, 239, 0.7);

    --brand: #1C5546;
    --brand-dark: #2A6B58;
    --brand-light: #1E2C1B;
    --brand-mid: #4A7263;

    --lime: #D6F25F;
    --lime-soft: rgba(214, 242, 95, 0.14);
    --on-lime: #113B31;

    --gold: #DDB667;
    --gold-bright: #E8C784;
    --gold-line: rgba(221, 182, 103, 0.45);
    --gold-mist: rgba(221, 182, 103, 0.10);

    --accent: #DB7B64;
    --accent-soft: #3B2822;

    --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
    --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.28);
    --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.36);
    --shadow-bar: 0 -16rpx 40rpx rgba(0, 0, 0, 0.3);

    --overlay: rgba(0, 0, 0, 0.78);
    --scrim: rgba(0, 0, 0, 0.55);
    --brand-overlay: rgba(28, 85, 70, 0.88);
    --on-overlay: #FFFFFF;
    --brand-mist: rgba(17, 59, 49, 0.04);
    --brand-mist-strong: rgba(17, 59, 49, 0.12);
    --gold-line-onbrand: rgba(232, 199, 132, 0.5);
    --gold-line-onbrand-inner: rgba(232, 199, 132, 0.4);
    --accent-mist: rgba(219, 123, 100, 0.10);
    --accent-line: rgba(219, 123, 100, 0.45);
    --brand-focus-ring: rgba(214, 242, 95, 0.10);
    --stage-dark: #0D0D0D;
    --grid-line-onstage: rgba(255, 255, 255, 0.06);

    --sev-low: #7BAE93;
    --sev-mid: #D2A05E;
    --sev-mid-text: #E4BE7C;
    --sev-urgent: #DB8371;
    --sev-emergency: #C05C48;
    --sev-low-bg: #24332A;
    --sev-mid-bg: #3A3120;
    --sev-urgent-bg: #3B2722;
    --sev-emergency-bg: #35201A;

    --vet-primary: var(--brand);
    --vet-primary-dark: var(--brand-dark);
    --vet-primary-soft: var(--brand-light);
    --vet-primary-mid: var(--brand-mid);
    --vet-accent: var(--accent);
    --vet-accent-soft: var(--accent-soft);
    --vet-bg: var(--bg);
    --vet-card: var(--card);
    --vet-card-soft: var(--surface);
    --vet-bg-weak: var(--surface);
    --vet-text: var(--text);
    --vet-body: var(--body);
    --vet-muted: var(--muted);
    --vet-faint: var(--faint);
    --vet-line: var(--line);
    --vet-line-weak: var(--line-light);
    --vet-green: var(--brand);
    --vet-green-dark: var(--brand-dark);
    --vet-green-soft: var(--brand-light);
    --vet-green-mid: var(--brand-mid);

    --vet-low-bg: var(--sev-low-bg);
    --vet-mid-bg: var(--sev-mid-bg);
    --vet-vet-bg: var(--sev-urgent-bg);
    --vet-emg-bg: var(--sev-emergency-bg);

    --vet-shadow: var(--shadow-sm);
    --vet-shadow-strong: var(--shadow-md);
  }
}

/* ============================================================
 * Reset
 * ============================================================ */
button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: normal;
  font: inherit;
  color: inherit;
  border-radius: 0;
}

button::after { border: none; }

input, textarea {
  color: var(--text);
  font: inherit;
}

::-webkit-scrollbar { display: none; }

/* ============================================================
 * 页面 & 卡片
 * v4 原则：纯白底上靠墨线 + 留白分层；卡片默认细线描边；
 * 「浮起」的元素（弹层、底栏）才用阴影。
 * ============================================================ */
.vet-page {
  min-height: 100vh;
  padding: var(--sp-3) var(--vet-page-x) calc(var(--sp-6) + var(--vet-safe-bottom));
  box-sizing: border-box;
  background: var(--bg);
}

.vet-card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: var(--sp-4);
  box-sizing: border-box;
}

.vet-card-soft {
  background: var(--surface);
  border-radius: var(--r-md);
  padding: var(--sp-3);
  box-sizing: border-box;
}

/* 墨绿主卡（首页 01 / PHOTO、报告主操作等） */
.vet-card-ink {
  background: var(--brand);
  color: var(--on-brand);
  border-radius: var(--r-lg);
  padding: var(--sp-4);
  box-sizing: border-box;
}

/* 墨线描边卡（首页 02 / CHAT 等次级入口） */
.vet-card-outline {
  background: var(--card);
  border: 2rpx solid var(--brand);
  border-radius: var(--r-lg);
  padding: var(--sp-4);
  box-sizing: border-box;
}

/* ============================================================
 * 区块：标题一律宋体重字重；区块用墨线开头
 * ============================================================ */
.vet-section { margin-top: var(--sp-6); }

.vet-section-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-3);
}

.vet-section-title {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 900;
  line-height: 1.35;
}

.vet-section-desc {
  margin-top: var(--sp-1);
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.5;
}

/* ============================================================
 * 排版
 * ============================================================ */
.vet-title-xl {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: 900;
  line-height: 1.25;
}

.vet-title-lg {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 900;
  line-height: 1.32;
}

.vet-title-md {
  color: var(--text);
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.38;
}

.vet-body {
  color: var(--body);
  font-size: var(--fs-body);
  line-height: 1.65;
}

.vet-caption {
  color: var(--muted);
  font-size: var(--fs-caption);
  line-height: 1.5;
}

.vet-label {
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.4;
}

/* 鎏金等宽元数据 —— 日期 / 编号 / 月份 / 区块编号（01 / PHOTO） */
.vet-mono-gold {
  color: var(--gold);
  font-family: var(--font-mono);
  font-size: var(--fs-mini);
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.4;
}

/* 青柠荧光笔划线（大标题里的强调词） */
.vet-hl-lime {
  background: linear-gradient(transparent 58%, var(--lime) 58%);
}

/* ============================================================
 * 按钮：主按钮墨绿实心胶囊；次按钮墨线描边
 * ============================================================ */
.vet-btn {
  min-height: 96rpx;
  padding: 0 var(--sp-4);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  font-size: 30rpx;
  font-weight: 700;
  transition: transform var(--dur-fast) var(--ease-standard),
              opacity var(--dur-fast) ease;
}

.vet-btn:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.vet-btn-primary {
  background: var(--brand);
  color: var(--on-brand);
}

.vet-btn-secondary {
  background: transparent;
  color: var(--brand);
  border: 2rpx solid var(--brand);
}

.vet-btn-ghost {
  background: transparent;
  color: var(--brand);
  border: 1rpx solid var(--brand);
}

.vet-btn-danger {
  background: var(--sev-urgent-bg);
  color: var(--sev-emergency);
  border: 1rpx solid rgba(160, 61, 43, 0.2);
}

/* 青柠圆形动作钮（→ / ↑），只用于「可点的动作」 */
.vet-action-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--lime);
  color: var(--on-lime);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  flex: none;
}

.vet-action-dot-outline {
  background: transparent;
  border: 2rpx solid var(--brand);
  color: var(--brand);
  box-sizing: border-box;
}

/* 青柠下划线文字动作（判断依据 → / 编辑 → / 新问诊） */
.vet-link-lime {
  color: var(--brand);
  font-weight: 700;
  border-bottom: 2rpx solid var(--lime);
  padding-bottom: 2rpx;
}

/* ============================================================
 * Chips & Tags：一律胶囊形；可选中 chip 用墨线描边
 * ============================================================ */
.vet-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 var(--sp-3);
  border-radius: 999rpx;
  background: var(--card);
  border: 2rpx solid var(--brand);
  color: var(--brand);
  font-size: var(--fs-caption);
  font-weight: 700;
  box-sizing: border-box;
}

.vet-chip-active {
  background: var(--brand);
  border-color: var(--brand);
  color: var(--on-brand);
}

.vet-chip-muted {
  border: 1rpx solid var(--line);
  color: var(--ghost);
  font-weight: 500;
}

.vet-tag {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 var(--sp-2);
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--muted);
  font-size: var(--fs-mini);
  font-weight: 600;
  line-height: 1;
}

.vet-tag-brand {
  background: var(--lime);
  color: var(--on-lime);
}

/* ============================================================
 * 分割线：细线分层；墨色 2rpx 强分割线开区块
 * ============================================================ */
.vet-divider {
  height: 1rpx;
  background: var(--line);
  border: none;
  margin: var(--sp-3) 0;
}

.vet-divider-strong {
  height: 4rpx;
  background: var(--text);
  border: none;
}

/* ============================================================
 * 表单
 * ============================================================ */
.vet-field { margin-top: var(--sp-3); }
.vet-field:first-child { margin-top: 0; }

.vet-field-label {
  display: block;
  margin-bottom: var(--sp-1);
  color: var(--body);
  font-size: var(--fs-caption);
  font-weight: 600;
}

.vet-input,
.vet-textarea {
  width: 100%;
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--card);
  color: var(--text);
  font-size: 27rpx;
  box-sizing: border-box;
}

.vet-input { min-height: 88rpx; padding: 0 var(--sp-3); }

.vet-textarea {
  min-height: 176rpx;
  padding: var(--sp-2) var(--sp-3);
  line-height: 1.55;
}

/* ============================================================
 * 加载
 * ============================================================ */
.vet-loading-card {
  width: 560rpx;
  max-width: calc(100vw - 96rpx);
  padding: var(--sp-4);
  border-radius: var(--r-lg);
  background: var(--card);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-lg);
  box-sizing: border-box;
}

.vet-loading-line {
  position: relative;
  overflow: hidden;
  height: 8rpx;
  border-radius: var(--r-sm);
  background: var(--line-light);
}

.vet-loading-line::after {
  content: "";
  position: absolute;
  top: 0;
  left: -40%;
  width: 40%;
  height: 100%;
  border-radius: var(--r-sm);
  background: linear-gradient(90deg, transparent, var(--lime), transparent);
  animation: vetShimmer 1.5s ease-in-out infinite;
}

/* ============================================================
 * 图片网格 / 安全区 / 进度条
 * ============================================================ */
.vet-image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-2);
}

.vet-safe-bottom {
  padding-bottom: calc(var(--sp-3) + var(--vet-safe-bottom));
}

/* 统一空状态：淡金雾底，居中提示 */
.vet-empty {
  padding: var(--sp-5) var(--sp-4);
  border-radius: var(--r-md);
  background: var(--gold-mist);
  color: var(--body);
  font-size: var(--fs-caption);
  line-height: 1.6;
  text-align: center;
  box-sizing: border-box;
}

.vet-empty-title {
  display: block;
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text);
  margin-bottom: var(--sp-1);
}

.vet-progress {
  height: 10rpx;
  border-radius: var(--r-sm);
  background: var(--line-light);
  overflow: hidden;
}

.vet-progress-fill {
  height: 100%;
  border-radius: var(--r-sm);
  background: var(--brand);
  transition: width var(--dur-base) var(--ease-standard);
}

/* ============================================================
 * 动画 / 数字
 * ============================================================ */
.vet-fade-up {
  animation: vetFadeUp var(--dur-slow) var(--ease-out) both;
}

/* 交错入场：配合 vet-fade-up，区块依次延迟 40ms */
.vet-stagger-1 { animation-delay: 40ms; }
.vet-stagger-2 { animation-delay: 80ms; }
.vet-stagger-3 { animation-delay: 120ms; }
.vet-stagger-4 { animation-delay: 160ms; }
.vet-stagger-5 { animation-delay: 200ms; }

/* 骨架屏占位块：surface 底 + 扫光 */
.vet-skeleton {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-sm);
  background: var(--surface);
}

.vet-skeleton::after {
  content: "";
  position: absolute;
  top: 0;
  left: -40%;
  width: 40%;
  height: 100%;
  background: linear-gradient(90deg, transparent, var(--line-light), transparent);
  animation: vetShimmer 1.5s ease-in-out infinite;
}

.text-numeric {
  font-variant-numeric: tabular-nums;
  font-family: var(--font-mono);
}

.font-serif { font-family: var(--font-serif); }
.font-mono  { font-family: var(--font-mono); }
.font-kai   { font-family: var(--font-kai); }

/* 行内分隔点 —— 用 CSS 画，不用装饰性字形（符合结构自检约束） */
.mid-dot {
  display: inline-block;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  vertical-align: middle;
  margin: 0 10rpx;
  opacity: 0.5;
}

/* ============================================================
 * 鎏金印章 — v4 唯一装饰元素（品牌记忆点）
 * 用法：<view class="vet-seal"><text>AI 初筛</text></view>
 * ============================================================ */
.vet-seal {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  border: 3rpx solid var(--gold-line);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(10deg);
  box-sizing: border-box;
  position: relative;
}

.vet-seal::before {
  content: "";
  position: absolute;
  inset: 10rpx;
  border-radius: 50%;
  border: 2rpx solid var(--gold-line);
}

.vet-seal text {
  font-family: var(--font-serif);
  font-size: 22rpx;
  font-weight: 900;
  color: var(--gold);
  text-align: center;
  line-height: 1.25;
}

.vet-seal-sub {
  display: block;
  font-family: var(--font-mono);
  font-size: 12rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--gold);
}

/* ============================================================
 * 线性图标系统（颜色随 currentColor 自动换肤）
 * ============================================================ */
.vic {
  position: relative;
  display: block;
  box-sizing: border-box;
}

/* CSS 箭头 —— 替代文本 "→"，跨平台渲染一致 */
.vic-arrow {
  width: 20rpx;
  height: 20rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  border-radius: 1rpx;
  transform: rotate(45deg);
  box-sizing: border-box;
  flex: none;
}

/* 圆形动作钮内的光学居正 */
.vet-action-dot .vic-arrow {
  margin-left: -4rpx;
}

.vic-cross { width: 30rpx; height: 30rpx; }

.vic-cross::before,
.vic-cross::after {
  content: "";
  position: absolute;
  background: currentColor;
  border-radius: 5rpx;
}

.vic-cross::before {
  left: 50%; top: 0;
  width: 11rpx; height: 30rpx;
  transform: translateX(-50%);
}

.vic-cross::after {
  top: 50%; left: 0;
  width: 30rpx; height: 11rpx;
  transform: translateY(-50%);
}

.vic-user { width: 30rpx; height: 30rpx; }

.vic-user::before {
  content: "";
  position: absolute;
  left: 50%; top: 0;
  width: 13rpx; height: 13rpx;
  transform: translateX(-50%);
  border: 2.5rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.vic-user::after {
  content: "";
  position: absolute;
  left: 50%; bottom: 0;
  width: 26rpx; height: 13rpx;
  transform: translateX(-50%);
  border: 2.5rpx solid currentColor;
  border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
  box-sizing: border-box;
}

.vic-chat {
  width: 34rpx; height: 28rpx;
  border: 2.5rpx solid currentColor;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.vic-chat::before {
  content: "";
  position: absolute;
  left: 7rpx; bottom: -8rpx;
  width: 9rpx; height: 9rpx;
  border-left: 2.5rpx solid currentColor;
  border-bottom: 2.5rpx solid currentColor;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.vic-chat::after {
  content: "";
  position: absolute;
  left: 5rpx; top: 50%;
  width: 4rpx; height: 4rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translateY(-50%);
  box-shadow: 8rpx 0 0 currentColor, 16rpx 0 0 currentColor;
}

/* 左向 chevron —— 替代文本 "‹" */
.vic-back {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  border-radius: 1rpx;
  transform: rotate(45deg);
  box-sizing: border-box;
  flex: none;
}

/* 上向箭头 —— 替代文本 "↑"（发送钮） */
.vic-up {
  width: 20rpx;
  height: 20rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  border-radius: 1rpx;
  transform: rotate(-45deg);
  box-sizing: border-box;
  flex: none;
  margin-top: 4rpx;
}

/* 关闭 —— 替代文本 "×"，两条 45° 交叉短线 */
.vic-close {
  width: 28rpx;
  height: 28rpx;
  flex: none;
}

.vic-close::before,
.vic-close::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.vic-close::before { transform: translate(-50%, -50%) rotate(45deg); }
.vic-close::after { transform: translate(-50%, -50%) rotate(-45deg); }

/* 加号 —— 替代文本 "+"，正十字细线 */
.vic-plus {
  width: 28rpx;
  height: 28rpx;
  flex: none;
}

.vic-plus::before,
.vic-plus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.vic-plus::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

/* 搜索 —— 圆环 + 45° 短柄 */
.vic-search {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}

.vic-search::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.vic-search::after {
  content: "";
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: rotate(45deg);
  transform-origin: right bottom;
}

/* 对勾 —— checklist 完成态 */
.vic-check {
  width: 24rpx;
  height: 14rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  border-radius: 1rpx;
  transform: rotate(-45deg);
  box-sizing: border-box;
  flex: none;
  margin-top: -4rpx;
}

/* 相机 —— 圆角机身 + 顶部凸起 + 圆形镜头 */
.vic-camera {
  width: 36rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
  box-sizing: border-box;
  flex: none;
  margin-top: 4rpx;
}

.vic-camera::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -7rpx;
  width: 14rpx;
  height: 7rpx;
  transform: translateX(-50%);
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
  box-sizing: border-box;
}

.vic-camera::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  transform: translate(-50%, -50%);
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

/* 分享 —— 向上箭头 + 底部开口托盘 */
.vic-share {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}

.vic-share::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 2rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: translateX(-50%) rotate(-45deg);
  box-sizing: border-box;
}

.vic-share::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 30rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
  box-sizing: border-box;
}

@keyframes vetFadeUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes vetShimmer {
  0% { left: -40%; }
  100% { left: 100%; }
}
